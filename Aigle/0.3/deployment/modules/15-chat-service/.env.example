# ==========================================
# General
# ==========================================
TIMEZONE=Asia/Taipei

# ==========================================
# LLM (Ollama OpenAI-compat endpoint)
# ==========================================
LLM_BASE_URL=http://<your_ollama_host_ip>:11434/v1
LLM_MODEL=qwen3.5:9b
TEMPERATURE=0.7

# ==========================================
# Hybrid Search (module 17)
# ==========================================
HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000

# ==========================================
# Redis (module 02)
# ==========================================
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
REDIS_DB=0

# ==========================================
# Chat Memory
# ==========================================
MEMORY_CONTEXT_WINDOW=5
MEMORY_TTL=3600

# ==========================================
# HTTP
# ==========================================
REQUEST_TIMEOUT=60.0
CHAT_SERVICE_PORT=8021
