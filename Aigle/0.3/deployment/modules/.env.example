# ============================================================
# Raptor 0.3 — Unified Environment Configuration
#
# 使用方式：
#   cp .env.local .env && python build.py
# ============================================================

# ============================================================
# HOST PORT SETTINGS（所有對外 expose 的 port，集中在此管理）
# 若 host ≠ container port，以「→ container XXXX」標示
# ============================================================

# ── 01 NFS Server ────────────────────────────────────────────
PORT_NFS=2049

# ── 02 Redis ─────────────────────────────────────────────────
REDIS_STANDALONE_PORT=6379
REDIS_CLUSTER_PORT_1=7000
REDIS_CLUSTER_PORT_2=7001
REDIS_CLUSTER_PORT_3=7002
REDIS_CLUSTER_PORT_4=7003
REDIS_CLUSTER_PORT_5=7004
REDIS_CLUSTER_PORT_6=7005
REDIS_CLUSTER_BUS_PORT_1=17000
REDIS_CLUSTER_BUS_PORT_2=17001
REDIS_CLUSTER_BUS_PORT_3=17002
REDIS_CLUSTER_BUS_PORT_4=17003
REDIS_CLUSTER_BUS_PORT_5=17004
REDIS_CLUSTER_BUS_PORT_6=17005
REDISINSIGHT_PORT=5540

# ── 03 Database ──────────────────────────────────────────────
PORT_POSTGRES=5433                    # → container 5432
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# ── 04 Object Storage ────────────────────────────────────────
PORT_ASSET_MANAGEMENT=8000
PORT_SEAWEEDFS_S3=8333
PORT_SEAWEEDFS_ADMIN=23646
PORT_LAKEFS=8001                      # → container 8000

# ── 05 Kafka ─────────────────────────────────────────────────
PORT_KAFKA_BROKER1=19092
PORT_KAFKA_BROKER2=19093
PORT_KAFKA_BROKER3=19094
PORT_AKHQ=8180                        # → container 8080
PORT_KAFDROP=9010                     # → container 9000

# ── 06 Authentication ────────────────────────────────────────
KEYCLOAK_PORT=8080
PORT_KEYCLOAK_DB=5434                 # → container 5432
PORT_KEYCLOAK_API=8800

# ── 07 AI-ML Services ────────────────────────────────────────
AI_LIFECYCLE_API_PORT=8010
MLFLOW_PORT=5555

# ── 09 Audio Processing ──────────────────────────────────────
AUDIO_SYNC_API_PORT=8019
AUDIO_DIARIZATION_SYNC_PORT=8029
AUDIO_CLASSIFIER_SYNC_PORT=8039

# ── 10 Image Processing ──────────────────────────────────────
IMAGE_SYNC_API_PORT=8018

# ── 11 Video Processing ──────────────────────────────────────
VIDEO_FRAME_SYNC_API_PORT=8031
VIDEO_OCR_SYNC_PORT=8032

# ── 12 Document Processing ───────────────────────────────────
DOCUMENT_SYNC_API_PORT=8020

# ── 13 API Gateway ───────────────────────────────────────────
PORT_API_GATEWAY=8012

# ── 14 Monitoring ────────────────────────────────────────────
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000
PORT_ALERTMANAGER=9093
PORT_NODE_EXPORTER=9100
PORT_CADVISOR=8085                    # → container 8080
PORT_LOKI=3100

# ── 15 Chat Service ──────────────────────────────────────────
CHAT_SERVICE_PORT=8021

# ── 16 Training Service ──────────────────────────────────────
FASTAPI_PORT=8009

# ── 17 Hybrid Search ─────────────────────────────────────────
PORT_OPENSEARCH=9200
PORT_OPENSEARCH_PERF=9600             # Performance Analyzer
OPENSEARCH_DASHBOARDS_PORT=5601
PORT_HYBRID_SEARCH=8091               # → container 8000

# ── 18 Query Orchestrator ────────────────────────────────────
PORT_QUERY_ORCHESTRATOR=8843          # → container 8000

# ── 19 Graph Database ────────────────────────────────────────
PORT_NEO4J_BROWSER=7474
PORT_NEO4J_BOLT=7687
PORT_NEO4J_METRICS=2004               # Prometheus metrics

# ── 20 Graph Service ─────────────────────────────────────────
GRAPH_SERVICE_PORT=8844               # → container 8843

# ── 21 Agent Protocol ────────────────────────────────────────
PORT_AGENT_PROTOCOL=8030
PORT_VECTOR_AGENT=52001
PORT_KEYWORD_AGENT=52002
PORT_GRAPHRAG_AGENT=52003
PORT_TKG_AGENT=52004
PORT_RERANKER_AGENT=52005

# ============================================================
# GPU ALLOCATION SETTINGS（所有需要 GPU 的服務，集中在此管理）
# _GPU=N → docker-compose device_ids 精確指定實體 GPU 索引（0 起算）
#           容器內部永遠以 CUDA_VISIBLE_DEVICES=0 存取
# ============================================================

# ── 共用 ─────────────────────────────────────────────────────
MAX_MEMORY_PER_GPU=36GiB          # 10 11（InternVL VLM 最大顯存）

# ── 07 AI-ML Services (ai-lifecycle-api) ─────────────────────
AI_LIFECYCLE_GPU=0

# ── 09 Audio Processing ──────────────────────────────────────
AUDIO_RECOGNIZER_GPU=0
AUDIO_DIARIZATION_GPU=0
AUDIO_CLASSIFIER_GPU=0

# ── 10 Image Processing ──────────────────────────────────────
IMAGE_PROCESSING_GPU=0

# ── 11 Video Processing ──────────────────────────────────────
VIDEO_CHUNKING_GPU=0
VIDEO_OCR_GPU=0
VIDEO_FRAME_DESC_GPU=0

# ── 12 Document Processing ───────────────────────────────────
DOCUMENT_ANALYSIS_GPU=0

# ── 16 Training Service ──────────────────────────────────────
CUDA_VISIBLE_DEVICES=0,1          # multi-GPU training

# ── 17 Hybrid Search ─────────────────────────────────────────
HYBRID_SEARCH_GPU=1

# ── 18 Query Orchestrator ────────────────────────────────────
QUERY_ORCHESTRATOR_GPU=0

# ============================================================
# 全域共用設定（真正無 module 歸屬的設定）
# ============================================================

# ── 基礎設施 ─────────────────────────────────────────────────
DOCKER_NETWORK=raptor
# HOST_IP=<host_ip>
HOST_IP=<host_ip>
TIMEZONE=Asia/Taipei

# ── HuggingFace（07 09 10 11 12 17 共用，無單一 module 歸屬）──
HF_TOKEN=<your_hf_token>
HF_CACHE_PATH=/mnt/disk1/models

# ── 外部 LLM — Ollama（非 Raptor module，外部部署）──────────
OLLAMA_HOST=http://<host_ip>:11434
LLM_BASE_URL=${OLLAMA_HOST}/v1
LLM_MODEL=qwen2.5:7b

# ── VLM 模型基準（10 11 12 各可獨立覆蓋）────────────────────
VLM_MODEL_PATH=OpenGVLab/InternVL3_5-1B

# ── S3 / AWS 認證（04 07 共用）──────────────────────────────
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>

# ── 跨服務超時（09 11 使用）─────────────────────────────────
CROSS_SERVICE_TIMEOUT=600

# ============================================================
# 服務間通訊 URL
# .env 插值由上至下解析，module 13 引用了排序在後的 module（17 18 20）
# 故這三個 URL 須提前定義；括號內為實際歸屬 module
# ============================================================
HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000        # [17]
HYBRID_SEARCH_INGEST_URL=${HYBRID_SEARCH_URL}/api/v1/ingest/file  # [17]
QUERY_ORCHESTRATOR_URL=http://raptor-query-orchestrator:8000  # [18]
GRAPH_SERVICE_URL=http://raptor-graph-service:8843           # [20]

# ============================================================
# 01 — nfs-server
# ============================================================
# NFS_SERVER=<host_ip>
NFS_SERVER=<host_ip>
NFS_EXPORT=/nfs-share
NFS_MEDIA_TMP_PATH=/media/processing
NFS_AIML_TMP_PATH=/aiml/tmp
NFS_AIML_DATA_PATH=/aiml/data
# ── 初始化專用 ──
NFS_BASE_PATH=/opt/home/dht/storage
BASE_DIR=seaweedfs
SUB_DIRS="admin s3 backup filer vol1 vol2 vol3 vol4 master1 master2 master3"
BASE_DIR_2=aiml
SUB_DIRS_2="tmp data"
BASE_DIR_3=media
SUB_DIRS_3="processing"

# ============================================================
# 02 — redis-cluster
# ============================================================
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
REDIS_DB=0

# ============================================================
# 03 — database
# ============================================================
POSTGRES_HOST=raptor-postgres
POSTGRES_PORT=5432
POSTGRES_USER=raptor
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=raptor          # PostgreSQL 容器預設 DB；init/001_init.sql 另外建 asset_management mlflow gateway tkg
QDRANT_HOST=raptor-qdrant
QDRANT_COLLECTION=raptor

# ============================================================
# 04 — asset-management
# ============================================================
ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000
# POSTGRES_DB 不在此定義：LakeFS 連線字串已有 :-asset_management 預設值（見 docker-compose.yml line 256）
# OpenSearch 連線變數（OPENSEARCH_HOST/PORT/USER/PASSWORD/INDEX/VERIFY_CERTS）
# 定義於 module 17 section，透過 env_file: path: ../.env 全量注入，ordering 無影響
# config.py 讀 AWS_ACCESS_KEY / AWS_SECRET_KEY（非標準 SDK 名稱），以下透過插值對應
AWS_ACCESS_KEY=${AWS_ACCESS_KEY_ID}
AWS_SECRET_KEY=${AWS_SECRET_ACCESS_KEY}
AUTO_DAILY_ARCHIVE_TIME=00:00
AUTO_DAILY_DESTROY_TIME=01:00
SEAWEEDFS_BASE_DIR=/seaweedfs
S3_ENDPOINT=http://seaweedfs-s3:8333
# S3_PUBLIC_URL=http://<host_ip>:8333
S3_PUBLIC_URL=http://<host_ip>:8333
S3_BUCKET=lakefs
VOLUME_SIZE_LIMIT_MB=10240
MAX_NUMBER_OF_VOLUMES=50
LAKEFS_ENDPOINT=http://lakefs:8000
LAKEFS_ACCESS_KEY=<your_lakefs_access_key>
LAKEFS_SECRET_KEY=<your_lakefs_secret_key>
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=<your_lakefs_auth_encrypt_secret_key>
LAKEFS_REPOSITORY=asset-management
LAKEFS_PRE_SIGNED_EXPIRY=24h
PRESIGN_URL_CACHE_ENABLED=false

# ============================================================
# 05 — kafka-cluster
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=kafka-broker1:9092,kafka-broker2:9092,kafka-broker3:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ============================================================
# 06 — authentication
# ============================================================
KEYCLOAK_URL=http://raptor-keycloak:8080
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<your_keycloak_db_password>
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<your_keycloak_admin_password>
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<your_kc_bootstrap_admin_password>
PERMANENT_MASTER_ADMIN_USER=dhtsolution
PERMANENT_ADMIN_PASSWORD=<your_permanent_admin_password>
KEYCLOAK_INFERENCE_URIS=/api/0.3/search/*,/api/0.3/asset/*,/api/0.3/processing/*,/api/0.3/chat/*,/api/0.3/document/*,/api/0.3/sync/*,/api/0.3/a2a/*,/API/inference/*
KEYCLOAK_FINETUNING_URIS=/API/finetune/*,/api/0.3/aiml/*,/api/0.3/training/*
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=
SMTP_AUTH=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=
SMTP_STARTTLS=
SMTP_TO_EMAIL=

# ============================================================
# 07 — ai-ml-services (AI Lifecycle API + MLflow)
# ============================================================
INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
INFERENCE_MODEL=qwen3.5:9b       # NOTE: Qwen 系列沿用至 v1.0；v1.0 起改用 Gemma / Llama / Mistral
OLLAMA_API_BASE=${OLLAMA_HOST}
AI_LIFECYCLE_API_HOST=0.0.0.0
MLFLOW_VERSION=v3.3.2
MLFLOW_HOST=0.0.0.0
MLFLOW_TRACKING_URI=http://mlflow:5555
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow
MLFLOW_S3_ENDPOINT_URL=http://lakefs:8000
INFERENCE_MAX_INPUT_LENGTH=8192

# ============================================================
# 09 — audio-processing
# ============================================================
AUDIO_SYNC_URL=http://raptor-audio-recognizer:8019
AUDIO_INFERENCE_MODEL=${INFERENCE_MODEL}
WHISPER_MODEL=large-v3
# PANNS_CACHE_PATH=/opt/home/cing/.cache/panns_data
PANNS_CACHE_PATH=/mnt/disk1/.cache/panns_data
AUDIO_RECOGNIZER_MEMORY_LIMIT=12g
AUDIO_RECOGNIZER_CPU_LIMIT=4
AUDIO_DIARIZATION_MEMORY_LIMIT=12g
AUDIO_DIARIZATION_CPU_LIMIT=4
AUDIO_CLASSIFIER_MEMORY_LIMIT=8g
AUDIO_CLASSIFIER_CPU_LIMIT=2
AUDIO_ORCHESTRATOR_MEMORY_LIMIT=2g
AUDIO_ORCHESTRATOR_CPU_LIMIT=1
AUDIO_ANALYSIS_MEMORY_LIMIT=4g
AUDIO_ANALYSIS_CPU_LIMIT=2
AUDIO_SUMMARY_MEMORY_LIMIT=4g
AUDIO_SUMMARY_CPU_LIMIT=2
AUDIO_INDEXER_MEMORY_LIMIT=2g
AUDIO_INDEXER_CPU_LIMIT=1
AUDIO_TTS_MEMORY_LIMIT=2g
AUDIO_TTS_CPU_LIMIT=1

# ============================================================
# 10 — image-processing
# ============================================================
IMAGE_VLM_MODEL_PATH=${VLM_MODEL_PATH}
IMAGE_PROCESSING_MEMORY_LIMIT=20g
IMAGE_PROCESSING_CPU_LIMIT=4
IMAGE_ORCHESTRATOR_MEMORY_LIMIT=2g
IMAGE_ORCHESTRATOR_CPU_LIMIT=1
IMAGE_INDEXER_MEMORY_LIMIT=2g
IMAGE_INDEXER_CPU_LIMIT=1

# ============================================================
# 11 — video-processing
# ============================================================
VIDEO_VLM_MODEL_PATH=${VLM_MODEL_PATH}
VIDEO_INFERENCE_MODEL=${INFERENCE_MODEL}
CONTEXTUALIZE_MODEL_NAME=
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=PP-OCRv5_mobile_rec
OCR_PRECISION=fp16
SUMMARY_MAX_TOKENS=<your_summary_max_tokens>
SUMMARY_MAX_LENGTH=300
VIDEO_FRAME_DESC_MEMORY_LIMIT=20g
VIDEO_FRAME_DESC_CPU_LIMIT=4
VIDEO_OCR_MEMORY_LIMIT=8g
VIDEO_OCR_CPU_LIMIT=2
VIDEO_ORCHESTRATOR_MEMORY_LIMIT=2g
VIDEO_ORCHESTRATOR_CPU_LIMIT=1
VIDEO_CHUNKING_MEMORY_LIMIT=4g
VIDEO_CHUNKING_CPU_LIMIT=2
VIDEO_ANALYSIS_MEMORY_LIMIT=4g
VIDEO_ANALYSIS_CPU_LIMIT=2
VIDEO_SUMMARY_MEMORY_LIMIT=4g
VIDEO_SUMMARY_CPU_LIMIT=2
VIDEO_CONTEXTUALIZE_MEMORY_LIMIT=2g
VIDEO_CONTEXTUALIZE_CPU_LIMIT=1
VIDEO_INDEXER_MEMORY_LIMIT=2g
VIDEO_INDEXER_CPU_LIMIT=1
VIDEO_GRAPH_MEMORY_LIMIT=512m
VIDEO_GRAPH_CPU_LIMIT=0.5

# ============================================================
# 12 — document-processing
# ============================================================
DOCUMENT_ANALYSIS_VLM_MODEL=${VLM_MODEL_PATH}
DOCUMENT_INFERENCE_MODEL=${INFERENCE_MODEL}
DOCUMENT_ANALYSIS_MEMORY_LIMIT=20g
DOCUMENT_ANALYSIS_CPU_LIMIT=4
DOCUMENT_ANALYSIS_MAX_CHUNK_TOKENS=<your_document_analysis_max_chunk_tokens>
DOCUMENT_ANALYSIS_MAX_WORKERS=8
DOCUMENT_ANALYSIS_CONTEXTUAL_TIMEOUT=120
DOCUMENT_ANALYSIS_CONTEXTUAL_BATCH_SIZE=5
DOCUMENT_ORCHESTRATOR_MEMORY_LIMIT=2g
DOCUMENT_ORCHESTRATOR_CPU_LIMIT=1
DOCUMENT_SUMMARY_MEMORY_LIMIT=8g
DOCUMENT_SUMMARY_CPU_LIMIT=2
DOCUMENT_INDEXER_MEMORY_LIMIT=4g
DOCUMENT_INDEXER_CPU_LIMIT=2
DOCUMENT_GRAPH_MEMORY_LIMIT=2g
DOCUMENT_GRAPH_CPU_LIMIT=1

# ============================================================
# 13 — api-services (api-gateway)
# config.py 使用 env_prefix="GATEWAY_"，以下透過變數插值對應共用設定
# ============================================================
GATEWAY_REDIS_HOST=${REDIS_HOST}
GATEWAY_REDIS_PORT=${REDIS_PORT}
GATEWAY_REDIS_PASSWORD=${REDIS_PASSWORD}
GATEWAY_REDIS_DB=${REDIS_DB}
GATEWAY_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}
GATEWAY_HYBRID_SEARCH_URL=${HYBRID_SEARCH_URL}
GATEWAY_ASSET_MANAGEMENT_URL=${ASSET_MANAGEMENT_URL}
GATEWAY_GRAPH_SERVICE_URL=${GRAPH_SERVICE_URL}
GATEWAY_QUERY_ORCHESTRATOR_URL=${QUERY_ORCHESTRATOR_URL}
GATEWAY_AUDIO_SYNC_URL=${AUDIO_SYNC_URL}
GATEWAY_AIML_LIFECYCLE_API_URL=${INFERENCE_URL}
# gateway 專屬設定
GATEWAY_API_VERSION=0.3
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_SERVICE_URL=http://keycloak-api:8800
GATEWAY_KEYCLOAK_URL=http://keycloak:8080
GATEWAY_KAFKA_TOPICS='{"document": "document-processing-requests", "image": "image-processing-requests", "video": "video-processing-requests", "audio": "audio-processing-requests"}'
GATEWAY_CHAT_SERVICE_URL=http://raptor-chat-service:8021
GATEWAY_DOCUMENT_SYNC_URL=http://raptor-document-analysis:8020
GATEWAY_IMAGE_SYNC_URL=http://raptor-image-processing:8018
GATEWAY_VIDEO_FRAME_SYNC_URL=http://raptor-video-frame-description:8031
GATEWAY_TRAINING_SERVICE_URL=http://<host_ip>:8009/api/v1/training
GATEWAY_VISION_SERVICE_URL=http://raptor-temporal-model-service:8000/analyze/video
GATEWAY_AGENT_PROTOCOL_URL=http://raptor-agent-protocol:8030
GATEWAY_OPENSEARCH_BRIDGE_URL=http://raptor-opensearch-bridge:8840
GATEWAY_MAX_CONNECTIONS=100
GATEWAY_MAX_KEEPALIVE_CONNECTIONS=20
GATEWAY_REQUEST_TIMEOUT=10.0
GATEWAY_UPLOAD_TIMEOUT=300.0
GATEWAY_BATCH_UPLOAD_CONCURRENCY=4
GATEWAY_RATE_LIMIT_PER_USER_PER_MINUTE=1000
GATEWAY_INTENT_MODEL=${LLM_MODEL}
GATEWAY_ANSWER_MODEL=${LLM_MODEL}
GATEWAY_SMOLAGENTS_MODEL=ollama/${LLM_MODEL}
GATEWAY_VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR
GATEWAY_AGENT_ID=raptor-gateway
GATEWAY_AGENT_NAME="Raptor Gateway Agent"

# ============================================================
# 14 — monitoring (Grafana)
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<your_grafana_admin_password>

# ============================================================
# 15 — chat-service
# ============================================================
CHAT_LLM_MODEL=${LLM_MODEL}
TEMPERATURE=0.7
MEMORY_CONTEXT_WINDOW=5
MEMORY_TTL=3600
REQUEST_TIMEOUT=60.0

# ============================================================
# 16 — training-service
# ============================================================
VRAM_OVERHEAD_GB=1.0
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# ============================================================
# 17 — hybrid-search
# HYBRID_SEARCH_URL / HYBRID_SEARCH_INGEST_URL 因插值順序限制定義於上方
# ============================================================
OPENSEARCH_HOST=opensearch-node1
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<your_opensearch_password>
OPENSEARCH_INDEX=hybrid_index
OPENSEARCH_VERIFY_CERTS=False
HF_HOME=/home/.cache/huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-large   # 1024-dim；更換 embedding 模型須重建既有向量索引
VECTOR_DIM=1024
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TEMPERATURE=0.25
OPENSEARCH_DASHBOARDS_HOST=opensearch-dashboards
RRF_K_FACTOR=60

# ============================================================
# 18 — query-orchestrator
# QUERY_ORCHESTRATOR_URL 因插值順序限制定義於上方
# config.py 使用 env_prefix="QO_"
# ============================================================
QO_INFERENCE_URL=${INFERENCE_URL}
QO_INFERENCE_MODEL=qwen3.5:0.8b
QO_INFERENCE_TIMEOUT=15
QO_LOG_LEVEL=INFO

# ============================================================
# 19 — graph-database
# ============================================================
NEO4J_URI=bolt://raptor-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your_neo4j_password>

# ============================================================
# 20 — graph-service
# GRAPH_SERVICE_URL 因插值順序限制定義於上方
# ============================================================
CHAT_MODEL_NAME=${LLM_MODEL}

# ============================================================
# 21 — agent-protocol (A2A orchestrator + RAG pipeline)
# ============================================================
OLLAMA_MODEL=${LLM_MODEL}
AGENT_ID=raptor-agent
AGENT_NAME="Raptor Intelligence Agent"
AGENT_ENDPOINT=http://raptor-agent-protocol:8030
# A2A 搜尋 agents（docker 內部網路）
VECTOR_AGENT_URL=http://raptor-vector-agent:52001
KEYWORD_AGENT_URL=http://raptor-keyword-agent:52002
GRAPHRAG_AGENT_URL=http://raptor-graphrag-agent:52003
TKG_AGENT_URL=http://raptor-tkg-agent:52004
RERANKER_AGENT_URL=http://raptor-reranker-agent:52005
AGENT_TTL=300                           # A2A peer discovery Redis key TTL (seconds)
HF_HOME=/mnt/disk1/models
