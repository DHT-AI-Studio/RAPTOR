# FastAPI Gateway 環境變數配置範本
# 複製此檔案為 .env 並填入實際值

# ==================== API 版本 ====================
GATEWAY_API_VERSION=0.3

# ==================== 日誌配置 ====================
GATEWAY_LOG_LEVEL=INFO

# ==================== 微服務路由配置 ====================
GATEWAY_SERVICES_CONFIG_PATH=services.yaml

# ==================== Keycloak ====================
GATEWAY_KEYCLOAK_URL=http://raptor-keycloak:8080
GATEWAY_KEYCLOAK_REALM=dhtsolution
GATEWAY_KEYCLOAK_CLIENT_ID=raptor

# ==================== Kafka ====================
GATEWAY_KAFKA_BOOTSTRAP_SERVERS='["kafka-broker1:9092", "kafka-broker2:9092", "kafka-broker3:9092"]'
GATEWAY_KAFKA_TOPICS='{"document": "document-processing-requests", "image": "image-processing-requests", "video": "video-processing-requests", "audio": "audio-processing-requests"}'

# ==================== Redis 快取 ====================
GATEWAY_REDIS_HOST=raptor-redis-standalone
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_PASSWORD=your-redis-password
GATEWAY_REDIS_DB=0

# ==================== 下游服務 URL ====================
GATEWAY_HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000
GATEWAY_CHAT_SERVICE_URL=http://raptor-chat-service:8021
GATEWAY_DOCUMENT_SYNC_URL=http://raptor-document-analysis:8020
GATEWAY_AIML_LIFECYCLE_API_URL=http://raptor-ai-lifecycle-api:8010
GATEWAY_ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000
GATEWAY_TRAINING_SERVICE_URL=http://raptor-training-service:8009/api/v1/training
GATEWAY_AUTH_SERVICE_URL=http://keycloak-api:8800/SSO
GATEWAY_VISION_SERVICE_URL=http://raptor-temporal-model-service:8000/analyze/video
GATEWAY_AGENT_PROTOCOL_URL=http://raptor-agent-protocol:8030
GATEWAY_OPENSEARCH_BRIDGE_URL=http://raptor-opensearch-bridge:8840
GATEWAY_GRAPH_SERVICE_URL=http://raptor-graph-service:8843

# ==================== NFS 共享儲存 ====================
NFS_SERVER=192.168.x.x
NFS_MEDIA_TMP_PATH=/media/processing

# ==================== 效能優化配置 ====================
GATEWAY_MAX_CONNECTIONS=100
GATEWAY_MAX_KEEPALIVE_CONNECTIONS=20
GATEWAY_REQUEST_TIMEOUT=10.0
GATEWAY_UPLOAD_TIMEOUT=300.0
GATEWAY_BATCH_UPLOAD_CONCURRENCY=4
GATEWAY_RATE_LIMIT_PER_USER_PER_MINUTE=1000

# ==================== 模型名稱設定 ====================
GATEWAY_INTENT_MODEL=qwen2.5:7b
GATEWAY_ANSWER_MODEL=qwen2.5:7b
GATEWAY_SMOLAGENTS_MODEL=ollama/qwen2.5:7b
GATEWAY_VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR
GATEWAY_AGENT_ID=raptor-gateway
GATEWAY_AGENT_NAME=Raptor Gateway Agent
