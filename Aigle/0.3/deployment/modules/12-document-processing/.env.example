# ============================================================
# 12-document-processing environment
# ============================================================

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka-broker1:9092,kafka-broker2:9092,kafka-broker3:9092
# KAFKA_BOOTSTRAP_SERVERS=<your_host_ip>:19092,<your_host_ip>:19093,<your_host_ip>:19094

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>

# ── Hybrid Search Ingest API ──────────────────────────────────
HYBRID_SEARCH_INGEST_URL=http://raptor-hybridsearch-api:8000/api/v1/ingest/file
ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000

# ── Ollama (LLM for summary + entity extraction) ─────────────
INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
INFERENCE_MODEL=qwen3.5:9b

# ── Neo4j (document_graph_service — requires module 19) ──────
NEO4J_URI=bolt://raptor-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your_neo4j_password>

# ── HuggingFace (InternVL + bge-m3 download on first run) ────
HF_TOKEN=<your_huggingface_token>

# ── GPU allocation ────────────────────────────────────────────
DOCUMENT_ANALYSIS_GPU=0
DOCUMENT_ANALYSIS_GPU_COUNT=1
DOCUMENT_ANALYSIS_MEMORY_LIMIT=20g
DOCUMENT_ANALYSIS_CPU_LIMIT=4
DOCUMENT_ANALYSIS_VLM_MODEL=OpenGVLab/InternVL3_5-1B
DOCUMENT_ANALYSIS_MAX_CHUNK_TOKENS=400
DOCUMENT_ANALYSIS_MAX_WORKERS=8
DOCUMENT_ANALYSIS_CONTEXTUAL_TIMEOUT=120

# Other services (CPU only)
DOCUMENT_ORCHESTRATOR_MEMORY_LIMIT=2g
DOCUMENT_ORCHESTRATOR_CPU_LIMIT=1
DOCUMENT_SUMMARY_MEMORY_LIMIT=8g
DOCUMENT_SUMMARY_CPU_LIMIT=2
DOCUMENT_INDEXER_MEMORY_LIMIT=4g
DOCUMENT_INDEXER_CPU_LIMIT=2
DOCUMENT_GRAPH_MEMORY_LIMIT=2g
DOCUMENT_GRAPH_CPU_LIMIT=1

# ── Timezone ─────────────────────────────────────────────────
TIMEZONE=Asia/Taipei
HF_CACHE_PATH=/path/to/huggingface/cache

# NFS shared media storage
NFS_SERVER=<your_nfs_server_ip>
NFS_MEDIA_TMP_PATH=/media/processing
