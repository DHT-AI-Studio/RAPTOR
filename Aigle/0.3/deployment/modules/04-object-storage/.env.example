###################################
###       Object Storage         ###
###################################
# S3 endpoint points to the seaweedfs-s3 service in Docker Compose (do not change)
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_PUBLIC_URL=<YOUR_S3_PUBLIC_URL>
S3_BUCKET=<YOUR_S3_BUCKET_NAME>
AWS_ACCESS_KEY=<YOUR_AWS_ACCESS_KEY>
AWS_SECRET_KEY=<YOUR_AWS_SECRET_KEY>

# Volume settings
# For this setting, the capacity per volume server is 1 TB (100 * 10240 MB), 4 TB total across 4 volume servers.
VOLUME_SIZE_LIMIT_MB=10240
MAX_NUMBER_OF_VOLUMES=50

###################################
###        Database             ###
###################################
# POSTGRES host points to the postgres service in Docker Compose (do not change)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=<REDACTED>
POSTGRES_DB=asset_management

###################################
###        Qdrant               ###
###################################
# Qdrant: shared with module 17-hybrid-search, uses raptor network alias
QDRANT_HOST=raptor-qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=raptor

###################################
###       OpenSearch            ###
###################################
# OpenSearch: shared with module 17-hybrid-search, uses raptor network alias
OPENSEARCH_HOST=opensearch-node1
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<REDACTED>
OPENSEARCH_INDEX=hybrid_index
OPENSEARCH_VERIFY_CERTS=False

###################################
###      Asset Management       ###
###################################
TIMEZONE=Asia/Taipei
AUTO_DAILY_ARCHIVE_TIME=00:00
AUTO_DAILY_DESTROY_TIME=01:00

###################################
###         Grafana             ###
###################################
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=<REDACTED>

###################################
###         LakeFS              ###
###################################
# LakeFS host points to the lakefs service in Docker Compose (do not change)
LAKEFS_ENDPOINT=http://lakefs:8000
LAKEFS_ACCESS_KEY=<REDACTED>
LAKEFS_SECRET_KEY=<REDACTED>
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=<REDACTED>
LAKEFS_REPOSITORY=asset-management
LAKEFS_PRE_SIGNED_EXPIRY=20m

###################################
###          Redis              ###
###################################
# Used to cache presigned URLs. TTL is auto-derived as 75% of LAKEFS_PRE_SIGNED_EXPIRY.
# REDIS_HOST defaults to raptor-redis-standalone (Docker network alias)
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=<REDACTED>

###################################
###        NFS Settings         ###
###################################
NFS_SERVER=<NFS_SERVER_IP>
NFS_EXPORT=/raptor
BASE_DIR=seaweedfsTest
SUB_DIRS="admin s3 backup filer vol1 vol2 vol3 vol4 master1 master2 master3"
TMP_MNT=/opt/raptor

###################################
###   Alertmanager SMTP Settings ###
###################################
SMTP_SMARTHOST=smtp.gmail.com:587
SMTP_FROM_EMAIL=<YOUR_EMAIL>
SMTP_AUTH_USERNAME=<YOUR_EMAIL>
SMTP_AUTH_PASSWORD=<REDACTED>
SMTP_HELLO_DOMAIN=localhost
ALERT_EMAIL_TO=<YOUR_EMAIL>
