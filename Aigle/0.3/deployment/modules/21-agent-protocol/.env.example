# ==========================================
# Agent Protocol (Module 21)
# ==========================================

# ── Shared infrastructure ─────────────────────────────────────
TIMEZONE=Asia/Taipei
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
REDIS_DB=0
AGENT_TTL=300

# ── Downstream services ───────────────────────────────────────
HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000
GRAPH_SERVICE_URL=http://raptor-graph-service:8843
INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000

# ── HuggingFace ───────────────────────────────────────────────
HF_TOKEN=<your_huggingface_token>
HF_CACHE_PATH=/path/to/huggingface/cache

# ── Module 21 settings ────────────────────────────────────────
AGENT_ID=raptor-agent
AGENT_NAME=Raptor Intelligence Agent
AGENT_ENDPOINT=http://raptor-agent-protocol:8030
OLLAMA_HOST=http://<your_ollama_host_ip>:11434
OLLAMA_MODEL=qwen2.5:7b

# Module 18 Query Orchestrator
QUERY_ORCHESTRATOR_URL=http://raptor-query-orchestrator:8000

# A2A agent URLs (docker internal network)
VECTOR_AGENT_URL=http://raptor-vector-agent:52001
KEYWORD_AGENT_URL=http://raptor-keyword-agent:52002
GRAPHRAG_AGENT_URL=http://raptor-graphrag-agent:52003
TKG_AGENT_URL=http://raptor-tkg-agent:52004
RERANKER_AGENT_URL=http://raptor-reranker-agent:52005
