# ── Docker 部署用 ──────────────────────────────────────────────────────────────
# Raptor Gateway 的 IP:Port（nginx 在容器內 proxy /api/* 到此位址）
API_TARGET=http://<host_ip>:8012

# Demo 前端對外 port（預設 3000）
DEMO_PORT=3000

# Docker network 名稱（預設 raptor）
DOCKER_NETWORK=raptor

# ── 本機開發用 (npm run dev) ────────────────────────────────────────────────────
# Vite dev server proxy 目標（與 API_TARGET 填同樣值）
VITE_API_TARGET=http://<host_ip>:8012
