# TLS entry for Keycloak and the API gateway (CF-3a). The nginx image renders this template at start-up
# (envsubst): KEYCLOAK_UPSTREAM / GATEWAY_UPSTREAM are host:port of the plain-HTTP services on the private
# network, KEYCLOAK_TLS_PORT / GATEWAY_TLS_PORT the ports nginx listens on. Certificates are mounted at
# /certs (server.pem, server.key).
#
# Behind this proxy:
# - Keycloak runs with KC_HOSTNAME=https://<host>:<KEYCLOAK_TLS_PORT> and KC_PROXY_HEADERS=xforwarded, so
#   its issuer, login pages and redirects use the https address;
# - the gateway (Module 13) gets GATEWAY_KEYCLOAK_PUBLIC_URL and GATEWAY_PUBLIC_URL set to the https
#   addresses, so its MCP OAuth discovery metadata names them (it sees plain http from here).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      '';
}

ssl_protocols TLSv1.2 TLSv1.3;
ssl_certificate     /certs/server.pem;
ssl_certificate_key /certs/server.key;
ssl_session_cache   shared:raptor_tls:10m;

server {
    listen ${KEYCLOAK_TLS_PORT} ssl;
    http2 on;

    # The administration console stays on the private network (Keycloak's own port): a login page for
    # the master realm on the public address is an attack surface nobody outside needs.
    location /admin/          { return 403; }
    location /realms/master/  { return 403; }

    location / {
        proxy_pass http://${KEYCLOAK_UPSTREAM};
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  $server_port;
        # Keycloak's login responses carry large cookies and headers.
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}

server {
    listen ${GATEWAY_TLS_PORT} ssl;
    http2 on;

    location / {
        proxy_pass http://${GATEWAY_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host              $http_host;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;     # WebSocket routes (realtime audio)
        proxy_set_header Connection        $connection_upgrade;
        # MCP, chat and other streamed responses (text/event-stream) must pass through as they come.
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 0;                               # uploads: the gateway enforces its own limits
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
