TIMEZONE=Asia/Taipei

# ==================== API 版本（單一來源是 root .env.example 的 API_VERSION）====================
# 只有單獨部署、沒有 root .env 時才會用到這個值。
API_VERSION=0.5

# ==================== Keycloak DB (PostgreSQL) ====================
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<db_password>

# ==================== Keycloak ====================
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<admin_password>
PERMANENT_MASTER_ADMIN_USER=<permanent_admin_username>
PERMANENT_ADMIN_PASSWORD=<permanent_admin_password>
PORT_KEYCLOAK=8080
# Keycloak's externally-visible address (KC_HOSTNAME, fixes the token issuer), always a full URL. Empty:
# docker-compose.yml's own http://HOST_IP-or-localhost:PORT_KEYCLOAK default.
# With the TLS entry (COMPOSE_PROFILES=tls below): required, the https URL, https://<host>:8443.
KEYCLOAK_PUBLIC_URL=

# ==================== TLS entry (see README "TLS for Keycloak and the gateway") ====================
# Everything here is read by this module's own docker-compose.yml -- there is no separate TLS compose
# file to also stack with -f; just these variables and a normal `docker compose up`.
# If deployment/modules/.env exists, set KEYCLOAK_TLS_ENABLED=true there instead (root .env.example's
# own 06 section) and build.py translates that into this for you, combined with any other module's own
# profile already active -- this raw COMPOSE_PROFILES is for a standalone deploy of this module alone,
# directly via `docker compose`, where build.py never runs to do that translation.
# COMPOSE_PROFILES=tls
PORT_KEYCLOAK_TLS=8443
PORT_GATEWAY_TLS=8013
# Directory with server.pem (full chain) and server.key. Default: ./tls/certs
TLS_CERT_DIR=./tls/certs
# Restricts Keycloak's own port to the host's loopback only -- from other machines it would otherwise
# bypass https and the proxy's /admin/ block, and its clients could send the X-Forwarded-* headers
# KC_PROXY_HEADERS below trusts. Empty (default, plain-HTTP): every interface, as before.
# KEYCLOAK_BIND_ADDR=127.0.0.1
# Trust X-Forwarded-* only from raptor-tls-proxy, which sets them -- on the plain-HTTP default, Keycloak
# is reached directly and these headers would come from clients instead, so leave this unset there.
# KC_PROXY_HEADERS=xforwarded
# KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true

# ==================== Keycloak API (port 8800) ====================
KEYCLOAK_URL=http://keycloak:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<admin_password>

# ==================== Keycloak Resource URIs (sync_resources.py) ====================
# Comma-separated URI patterns. Leave blank to use the built-in defaults.
KEYCLOAK_INFERENCE_URIS=/api/${API_VERSION}/search/*,/api/${API_VERSION}/asset/*,/api/${API_VERSION}/processing/*,/api/${API_VERSION}/chat/*,/api/${API_VERSION}/docagent/*,/api/${API_VERSION}/sync/*,/api/${API_VERSION}/a2a/*,/api/${API_VERSION}/memory/*,/api/${API_VERSION}/personal-db/*,/api/${API_VERSION}/identity/*,/api/${API_VERSION}/temporal/*,/api/${API_VERSION}/benchmark/*,/api/${API_VERSION}/guardrail/*,/api/${API_VERSION}/mcp/*,/api/${API_VERSION}/gdpr/*,/api/${API_VERSION}/moderation/*,/api/${API_VERSION}/compliance/*,/API/inference/*,/raptor.v1.RaptorService/*
KEYCLOAK_FINETUNING_URIS=/API/finetune/*,/api/${API_VERSION}/aiml/*,/api/${API_VERSION}/training/*

# ==================== Keycloak Metrics (already enabled, not overridable via .env) ====================
# KC_METRICS_ENABLED=true and KC_HEALTH_ENABLED=true are hardcoded in docker-compose.yml.
# Prometheus scrapes raptor-keycloak:9000/metrics (Module 14). No action needed here.

# ==================== Password Rotator (weekly, sidecar) ====================
# SMTP_HOST/PORT/USER/PASSWORD/FROM come from the root-level .env.example — no
# separate SMTP config needed here.
# Account list: edit rotate_accounts.txt directly (one "username:email" per
# line, re-read every run, no restart needed) — ROTATE_ACCOUNTS below is only
# a fallback if that file isn't present.
ROTATE_REALM=dhtsolution
ROTATE_ACCOUNTS=
ROTATE_BCC_EMAIL=
# Fixed weekly schedule — Monday=0 ... Sunday=6, 24h HOUR/MINUTE.
ROTATE_WEEKDAY=0
ROTATE_HOUR=9
ROTATE_MINUTE=0

# ==================== GDPR consent (GD-5) ====================
# keycloak-api 建立使用者後呼叫 Module 33 POST /internal/gdpr/new-user 設定預設同意。
# GD_INTERNAL_TOKEN 與 root .env 的同一個值（Module 33 用來驗證呼叫者）。
GD_INTERNAL_TOKEN=<generate_a_long_random_token>
PRIVACY_COMPLIANCE_URL=http://raptor-privacy-compliance-service:8033

# ==================== Backup sidecar (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md) ====================
KEYCLOAK_BACKUP_CRON=0 3 * * *
KEYCLOAK_BACKUP_RETENTION_DAYS=30

# ---- Shared across every module's backup sidecar (03/06/24/02/05/16) ----
# age-keygen -o backup-key.txt; keep the private half offline.
AGE_PUBLIC_KEYS=<age1...public_key_from_age-keygen>
BACKUP_NOTIFICATION_URLS=
# Destination -- fill in BACKUP_LOCAL_ARCHIVE_PATH at minimum; SSH/WebDAV
# below are optional extras, blank ones are skipped. Don't fill in SSH/WebDAV
# unless you'll keep them working -- a broken one aborts the whole run,
# local path included (confirmed live).
BACKUP_LOCAL_ARCHIVE_PATH=<your_backup_destination_path>
BACKUP_SSH_HOST_NAME=
BACKUP_SSH_PORT=22
BACKUP_SSH_USER=
BACKUP_SSH_PASSWORD=
BACKUP_SSH_IDENTITY_FILE=
BACKUP_SSH_REMOTE_PATH=/backups/raptor
# One of these three required for SSH to actually connect.
BACKUP_SSH_HOST_PUBLIC_KEY=
BACKUP_SSH_KNOWN_HOSTS_FILE=
BACKUP_SSH_IGNORE_HOST_KEY=false
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_PATH=
BACKUP_WEBDAV_USERNAME=
BACKUP_WEBDAV_PASSWORD=
