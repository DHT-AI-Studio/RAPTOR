# ============================================================
# 02-redis-cluster environment
# ============================================================

# ── Host IP (REQUIRED for Redis Cluster announce) ─────────
# Must be the real IP of this machine — NOT localhost or 127.0.0.1
HOST_IP=<your_host_ip>

# ── Redis Password ─────────────────────────────────────────
REDIS_PASSWORD=<your_redis_password>

# ── Redis Cluster Ports ────────────────────────────────────
PORT_REDIS_CLUSTER_1=7000
PORT_REDIS_CLUSTER_2=7001
PORT_REDIS_CLUSTER_3=7002
PORT_REDIS_CLUSTER_4=7003
PORT_REDIS_CLUSTER_5=7004
PORT_REDIS_CLUSTER_6=7005

PORT_REDIS_CLUSTER_BUS_1=17000
PORT_REDIS_CLUSTER_BUS_2=17001
PORT_REDIS_CLUSTER_BUS_3=17002
PORT_REDIS_CLUSTER_BUS_4=17003
PORT_REDIS_CLUSTER_BUS_5=17004
PORT_REDIS_CLUSTER_BUS_6=17005

# ── Redis Standalone Port ──────────────────────────────────
PORT_REDIS_STANDALONE=6379

# ── RedisInsight UI Port ───────────────────────────────────
PORT_REDISINSIGHT=5540

# ── Timezone ───────────────────────────────────────────────
TIMEZONE=Asia/Taipei

# ==================== Backup sidecar (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md) ====================
REDIS_BACKUP_CRON=0 3 * * *
REDIS_BACKUP_RETENTION_DAYS=30

# ---- Shared across every module's backup sidecar (03/06/24/02/16) ----
AGE_PUBLIC_KEYS=<age1...public_key_from_age-keygen>
BACKUP_NOTIFICATION_URLS=
BACKUP_LOCAL_ARCHIVE_PATH=<your_backup_destination_path>
BACKUP_SSH_HOST_NAME=
BACKUP_SSH_PORT=22
BACKUP_SSH_USER=
BACKUP_SSH_PASSWORD=
BACKUP_SSH_IDENTITY_FILE=
BACKUP_SSH_REMOTE_PATH=/backups/raptor
BACKUP_SSH_HOST_PUBLIC_KEY=
BACKUP_SSH_KNOWN_HOSTS_FILE=
BACKUP_SSH_IGNORE_HOST_KEY=false
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_PATH=
BACKUP_WEBDAV_USERNAME=
BACKUP_WEBDAV_PASSWORD=
