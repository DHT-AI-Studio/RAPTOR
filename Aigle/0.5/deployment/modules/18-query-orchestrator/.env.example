QO_LOG_LEVEL=INFO
QO_USE_LLM_RERANK=true

QO_INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
QO_INFERENCE_MODEL=gemma4:12b
QO_INFERENCE_TIMEOUT=15
QO_INFERENCE_THINK=false

# Zone the query's time window is read in; bounds are sent with its offset (TMP-3)
QO_TIMEZONE=Asia/Taipei

# TMP-7: Module 25 reads the query's time condition (`parse`) once its capabilities show temporal_v2 on and a
# parse route; until then the interim regex stays. A parse slower than PARSE_TIMEOUT_MS makes the query
# UNRESOLVED (never answered without its time condition). Measured p95 on tmp34: 3.5 ms (p99 4.1 ms); 1000 ms
# leaves room for a busy host, since a timeout makes the question unanswerable.
QO_PERSONAL_DB_URL=http://raptor-personal-db-service:8000
PARSE_TIMEOUT_MS=1000
QO_PARSE_CAPABILITY_TTL=60
