# FastAPI Gateway 環境變數配置範本
# 複製此檔案為 .env 並填入實際值

# ==================== API 版本 ====================
GATEWAY_API_VERSION=0.5

# ==================== 日誌配置 ====================
GATEWAY_LOG_LEVEL=INFO

# ==================== 微服務路由配置 ====================
GATEWAY_SERVICES_CONFIG_PATH=services.yaml

# ==================== Kafka ====================
GATEWAY_KAFKA_BOOTSTRAP_SERVERS='["kafka-broker1:9092", "kafka-broker2:9092", "kafka-broker3:9092"]'
GATEWAY_KAFKA_TOPICS='{"document": "document-processing-requests", "image": "image-processing-requests", "video": "video-processing-requests", "audio": "audio-processing-requests"}'

# ==================== Write-freeze maintenance mode (VIE01-369) ====================
# Gates POST /admin/maintenance/* as X-Internal-Token -- called by
# scripts/nfs-freeze-archive.sh (NFS_BACKUP_GATEWAY_INTERNAL_TOKEN there
# must match this value), never by an end user.
GATEWAY_INTERNAL_ADMIN_TOKEN=<your_internal_admin_token>

# ==================== Redis 快取 ====================
GATEWAY_REDIS_HOST=raptor-redis-standalone
GATEWAY_REDIS_PORT=6379
GATEWAY_REDIS_PASSWORD=your-redis-password
GATEWAY_REDIS_DB=0

# ==================== 下游服務 URL ====================
GATEWAY_HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000
GATEWAY_CHAT_SERVICE_URL=http://raptor-chat-service:8021
GATEWAY_DOCUMENT_SYNC_URL=http://raptor-document-analysis:8020
GATEWAY_AIML_LIFECYCLE_API_URL=http://raptor-ai-lifecycle-api:8010
GATEWAY_ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000
GATEWAY_TRAINING_SERVICE_URL=http://raptor-training-service:8009/api/v1/training
GATEWAY_BENCHMARK_SERVICE_URL=http://raptor-benchmark-service:8000/api/v1
GATEWAY_AUTH_SERVICE_URL=http://raptor-keycloak-api:8800

# ==================== MCP OAuth discovery (RFC 9728) — see MCP_OAUTH_REQUIREMENTS.md ====================
# Unlike GATEWAY_AUTH_SERVICE_URL/GATEWAY_KEYCLOAK_URL above, this MUST be an
# address an MCP client on the user's own machine can actually resolve —
# not an internal Docker hostname. Must be byte-for-byte the same address as
# Keycloak's own KEYCLOAK_PUBLIC_URL (see 06-authentication/.env.example) --
# if deployment/modules/.env (the root .env) exists, that's set there as
# ${KEYCLOAK_PUBLIC_URL} and this line is unused (the gateway reads this
# file, then the root one, so the root one's value wins); fill in the
# literal address here only for a standalone, no-root-.env deployment.
GATEWAY_KEYCLOAK_PUBLIC_URL=http://<your_keycloak_external_host>:8080
GATEWAY_KEYCLOAK_REALM=dhtsolution
# Behind the TLS entry (06-authentication's "tls" Compose profile / KEYCLOAK_TLS_ENABLED=true): the https address clients use for this
# gateway, e.g. https://<host>:8013 (GATEWAY_KEYCLOAK_PUBLIC_URL above becomes https://<host>:8443, same
# address as KEYCLOAK_PUBLIC_URL). The gateway then sees plain http from the proxy, so without this the
# MCP discovery metadata would name http://<internal address> and MCP clients would reject it. Empty:
# taken from each request, as before.
# If deployment/modules/.env (the root .env) exists, set both there instead: the gateway reads it after
# this file, so its GATEWAY_PUBLIC_URL overrides the one here.
GATEWAY_PUBLIC_URL=
GATEWAY_VISION_SERVICE_URL=http://raptor-temporal-model-service:8000/analyze/video
GATEWAY_AGENT_PROTOCOL_URL=http://raptor-agent-protocol:8030
GATEWAY_MEMORY_SERVICE_URL=http://raptor-memory-service:8026
GATEWAY_OPENSEARCH_BRIDGE_URL=http://raptor-opensearch-bridge:8840
GATEWAY_GRAPH_SERVICE_URL=http://raptor-graph-service:8843
GATEWAY_PERSONAL_DB_URL=http://raptor-personal-db-service:8000
GATEWAY_MCP_SERVER_URL=http://raptor-mcp-server:8027

# ==================== Guardrail Service (module 23) — GB-4/GB-19 gateway intercept (V04-10) ====================
# 每個 GATEWAY_GUARDRAIL_ROUTES 列出的路由，輸入都會先經過一個接在 get_current_user 之後的
# FastAPI dependency 檢查過才會真的執行；chat/completions、a2a/query、chat/chat 額外還有輸出端
# 檢查（GuardrailMiddleware，只管輸出，不管輸入）。GR_ENABLED=false 時全部完全略過（不會呼叫
# Guardrail Service）。
# GUARDRAIL_URL/GUARDRAIL_TIMEOUT 這兩個變數與 module 07 guardrail hook / root
# deployment/modules/.env.example 共用同一個名稱，非本模組專屬新變數。
#
# 注意內部 port 與對外映射 port 不同：容器內部固定監聽 8026；8023（PORT_GUARDRAIL_SERVICE）只是
# guardrail-service docker-compose.yml 對外映射到 host 的 port，容器對容器（同一個 raptor network）一律用 8026。
GUARDRAIL_URL=http://raptor-guardrail-service:8026
GR_ENABLED=true
GUARDRAIL_TIMEOUT=20.0
# 2026-11-27 統一後：GATEWAY_GUARDRAIL_MODE / GATEWAY_GUARDRAIL_ROUTES 是全部guarded路由
# 共用的同一組設定，chat/completions、a2a/query、chat/chat 也在內，不再是寫死永遠擋。
# GATEWAY_GUARDRAIL_MODE：strict（預設）＝等待檢查，block 時回 422 content_policy_violation；
# audit＝背景檢查、不擋、不等待，不安全內容記 WARNING——改成audit會連chat/completions也變成
# 不擋，這是改這個共用設定時要承擔的明確後果，不是意外。
# 帶 X-Internal: true 的請求完全略過（外部請求的這個 header 會先被 CF-3 移除）。
GATEWAY_GUARDRAIL_MODE=strict
# 路由表 {path_prefix: body_field}（相對於 /api/{版本}）——拿掉一個path就停用它的檢查，
# 不用改code；但不能反過來用這個表「新增」一個從沒被@guardrail_route(...)接過的全新端點，
# 那還是需要在code裡加一行（見 app/middlewares/guardrail.py 的 module docstring）。
# 留空用預設值：
# GATEWAY_GUARDRAIL_ROUTES={"/chat/completions": "messages", "/a2a/query": "question", "/chat/chat": "message", "/search/hybrid": "query", "/search/vector": "query", "/search/bm25": "query", "/search/tkg": "query", "/search/graphrag": "query", "/search/video_search": "query", "/memory/multimedia/search": "query", "/docagent/process": "options.question"}

# ==================== NFS 共享儲存 ====================
NFS_SERVER=192.168.x.x
PORT_NFS=2049
NFS_MEDIA_TMP_PATH=/media/processing

# ==================== 效能優化配置 ====================
GATEWAY_MAX_CONNECTIONS=100
GATEWAY_MAX_KEEPALIVE_CONNECTIONS=20
GATEWAY_REQUEST_TIMEOUT=10.0
GATEWAY_UPLOAD_TIMEOUT=300.0
# CM-7 / VIE01-410: GET /compliance/report waits for Module 33 to read the whole period
GATEWAY_COMPLIANCE_REPORT_TIMEOUT=120.0
GATEWAY_BATCH_UPLOAD_CONCURRENCY=4
GATEWAY_FACE_IMAGE_PRESIGN_CONCURRENCY=16
GATEWAY_RATE_LIMIT_PER_USER_PER_MINUTE=1000

# ==================== 模型名稱設定 ====================
GATEWAY_INTENT_MODEL=gemma4:12b
GATEWAY_ANSWER_MODEL=gemma4:12b
GATEWAY_SMOLAGENTS_MODEL=ollama/gemma4:12b
GATEWAY_VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR
GATEWAY_AGENT_ID=raptor-gateway
GATEWAY_AGENT_NAME=Raptor Gateway Agent

GATEWAY_INFERENCE_SERVICE_URL=http://raptor-inference-service:8035
