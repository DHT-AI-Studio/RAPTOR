PORT_INFERENCE=8036
MODULE07_API_URL=http://raptor-ai-lifecycle-api:8010
MODULE07_OLLAMA_HOST=http://raptor-ollama:11434
MODULE07_TIMEOUT_S=120
# VIE01-316/317: /inference/voice/stt and /tts forward here instead of loading a
# second copy of Module 34's Whisper/TTS models. Internal network hostname/port,
# not PORT_REALTIME_AUDIO (the host-published one).
MODULE34_API_URL=http://raptor-realtime-audio:8034
MODULE34_TIMEOUT_S=60
# Shared with Module 33's own internal calls (gd-internal-token-risk-memo.md) --
# not a new secret. Sent to Module 34 so its /audio/transcribe and /audio/synthesize
# (which it publishes directly to clients, with no gateway route of its own) aren't
# callable by anyone who can merely reach its host port.
GD_INTERNAL_TOKEN=<generate_a_long_random_token>
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
DEFAULT_TEXT_MODEL=<your_registered_text_model>
GUARDRAIL_ENABLED=false
GUARDRAIL_CHECK_OUTPUT=false
MODULE23_URL=http://raptor-guardrail-service:8026
GUARDRAIL_TIMEOUT_S=20
# Module 23's policy-aware POST /guardrail/policy/decide (GRD-X1); the body
# carries direction=input|output. The deprecated /guard/check/input and
# /guard/check/output are still understood if a deployment needs them.
GUARDRAIL_INPUT_PATH=/guardrail/policy/decide
GUARDRAIL_OUTPUT_PATH=/guardrail/policy/decide
VOICE_ENABLED=true
VOICE_MODEL_DIR=/opt/voice-models
# XTTS-v2 weights are Coqui Public Model License (non-commercial); /voice/clone
# stays disabled even with VOICE_ENABLED=true until this is explicitly set.
CLONE_ENABLED=false
# Comma list, subset of: xtts-v2, chatterbox-multilingual-v3. Must be a
# subset of CLONE_BACKENDS_BUILD below (what actually got baked in) -- if
# unset, defaults to that same value, so the common case (enable everything
# baked) needs only CLONE_BACKENDS_BUILD set. Override here only to enable a
# subset of a build that baked in more.
CLONE_BACKENDS_RUNTIME=xtts-v2
# Comma list: eagerly load these at startup instead of on first request.
# Default empty -- every configured backend loads lazily, on first use.
CLONE_BACKENDS_WARM=
# Empty (default): download with HUGGINGFACE_TOKEN at build time, nothing to
# mount at runtime (the image already has the baked-in models). Set it to a
# pre-exported, offline NAS bundle's directory (scripts/prefetch_voice.py
# --nas-root) to skip the build-time download and mount that bundle instead --
# one variable decides both.
INF_VOICE_BUNDLE_DIR=
# Build-time only: which clone backends' weights/deps get baked into this
# image. Chatterbox Multilingual V3 is MIT-licensed (no non-commercial
# restriction, unlike XTTS-v2 above).
CLONE_BACKENDS_BUILD=xtts-v2
# Only read by the --profile voice service's GPU device reservation -- the
# --profile text service (text path) has none.
INFERENCE_VOICE_GPU=0
# Build secret only; not passed into the runtime container.
HUGGINGFACE_TOKEN=<your_gated_model_read_token>
SPEAKER_CACHE_TTL_S=86400
SPEAKER_CACHE_MAX=100
