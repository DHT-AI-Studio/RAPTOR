# ==================== gRPC Gateway ====================
GRPC_GATEWAY_LOG_LEVEL=INFO
GRPC_GATEWAY_GRPC_PORT=8825
GRPC_GATEWAY_METRICS_PORT=9825

# Internal Keycloak URL for JWKS fetch (Bearer-token verification); realm a token's iss must name;
# expected aud -- "account" is every client's aud today (no audience-mapper configured in Keycloak),
# so this does NOT yet separate "meant for this service" from "meant for another RAPTOR service"; set
# empty to disable the check entirely. See config.py's jwt_audience docstring.
GRPC_GATEWAY_KEYCLOAK_URL=http://raptor-keycloak:8080
GRPC_GATEWAY_JWT_EXPECTED_REALM=dhtsolution
GRPC_GATEWAY_JWT_AUDIENCE=account

# DEV ONLY, never true in production -- see config.py's allow_insecure_dev_fallback docstring
GRPC_GATEWAY_ALLOW_INSECURE_DEV_FALLBACK=false

# Comma-separated list of accepted API keys for the x-api-key credential
GRPC_GATEWAY_API_KEYS=

# Auth service (module 06) -- AuthorizationInterceptor's per-RPC permission check, same
# /auth/permission REST already uses. Same wrapper client as module 13's GATEWAY_AUTH_SERVICE_URL.
GRPC_GATEWAY_AUTH_SERVICE_URL=http://raptor-keycloak-api:8800

# Downstream services — SearchByPerson/StreamSearchByPerson, DownloadAsset, UploadAsset
GRPC_GATEWAY_PERSONAL_DB_URL=http://raptor-personal-db-service:8000
GRPC_GATEWAY_ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000
GRPC_GATEWAY_HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000
GRPC_GATEWAY_REQUEST_TIMEOUT=10.0
# Timeout for the upload request to the asset service (UploadAsset)
GRPC_GATEWAY_UPLOAD_TIMEOUT=300.0

# Redis — UploadAsset idempotency (24h TTL) + per-user concurrency counter
GRPC_GATEWAY_REDIS_HOST=raptor-redis-standalone
GRPC_GATEWAY_REDIS_PORT=6379
GRPC_GATEWAY_REDIS_DB=0
GRPC_GATEWAY_REDIS_PASSWORD=

# UploadAsset idle timeout
GRPC_GATEWAY_UPLOAD_IDLE_TIMEOUT_S=60

# Per-user concurrent-stream cap, shared across every streaming RPC
# (StreamLimitInterceptor) -- not just UploadAsset.
GRPC_GATEWAY_MAX_STREAMS_PER_USER=4

# Kafka — UploadAsset's asset-upload-finalized event; empty disables publishing.
# Also required (non-empty) for SubmitJob -- job submission needs a producer.
GRPC_GATEWAY_KAFKA_BOOTSTRAP_SERVERS=
GRPC_GATEWAY_KAFKA_ASSET_FINALIZED_TOPIC=asset-upload-finalized

# SubmitJob -- file-type -> Kafka topic, same mapping as REST's GATEWAY_KAFKA_TOPICS
GRPC_GATEWAY_KAFKA_TOPICS={"document": "document-processing-requests", "image": "image-processing-requests", "video": "video-processing-requests", "audio": "audio-processing-requests"}

# WatchJob -- how often to poll the orchestrator Redis key for a state change
GRPC_GATEWAY_WATCH_JOB_POLL_INTERVAL_S=1.0

# TLS / mTLS -- off by default (plaintext). See README.md's "TLS / mTLS" section.
GRPC_GATEWAY_GRPC_SECURE=false
GRPC_GATEWAY_GRPC_TLS_CERT_PATH=
GRPC_GATEWAY_GRPC_TLS_KEY_PATH=
GRPC_GATEWAY_GRPC_MTLS_CA_CERT_PATH=

# StreamVideoSegment -- FFmpeg binary for the MP4_H264/MPEG_TS transcode
# formats (not used by RAW_FILE_RANGE). See README.md's "StreamVideoSegment" section.
GRPC_GATEWAY_FFMPEG_BINARY=ffmpeg
GRPC_GATEWAY_FFMPEG_TERMINATE_TIMEOUT_S=5.0

# AnalyzeStream -- idle timeout, and the topic each MediaChunk is forwarded
# to. NOTE: no consumer anywhere in Raptor reads this topic today -- see
# README.md's "AnalyzeStream" section and OPEN_QUESTION_analyze_stream_results.md.
GRPC_GATEWAY_ANALYZE_IDLE_TIMEOUT_S=120.0
GRPC_GATEWAY_KAFKA_ANALYSIS_REQUESTS_TOPIC=media-analysis-requests

# Guardrail (GB-20) -- screen the user text of the search RPCs and Chat with module 23
# (GuardrailInterceptor). Needs both the switch and the URL; fail-open after the timeout.
# Aliases: GR_GRPC_GUARDRAIL_ENABLED, GR_GRPC_GUARDRAIL_URL, GR_GRPC_TIMEOUT_MS.
# GB-22: grpc_interceptor is screened=true in module 23's coverage matrix only while on.
GRPC_GATEWAY_GUARDRAIL_ENABLED=false
GRPC_GATEWAY_GUARDRAIL_URL=
GRPC_GATEWAY_GUARDRAIL_TIMEOUT_MS=2000
