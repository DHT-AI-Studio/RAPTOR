# Module 33 — Privacy Compliance Service
# Most settings are pulled from the root deployment/modules/.env (see
# docker-compose.yml's ${VAR} interpolation) — this file only documents the
# module-specific ones that don't already exist elsewhere.

# Shared secret module 13 presents as X-Internal-Token when calling this
# service, and this service in turn presents to modules 04/25/26's own
# /internal/gdpr/user/{user_id} endpoints.
GD_INTERNAL_TOKEN=<generate_a_long_random_token>

# DPO notified here on PARTIAL_FAILURE (uses the root .env's SMTP_* settings)
GD_DPO_EMAIL=

# GD-5 / VIE01-250: consent management.
# Stamped on each new user as gdpr_consent_version; bump it (together with
# the Keycloak REVIEW_CONSENT action's version, see 06-authentication/
# README.md) when the consent notice changes.
GD_CONSENT_POLICY_VERSION=1.0
GD_MODULE_22_URL=http://raptor-benchmark-service:8000
# GD-10 / VIE01-416: Module 34 erases voice recordings on erasure / voice
# consent withdrawal and lists them for the export. Set it empty on a
# deployment without Module 34 (recorded as skipped).
GD_MODULE_34_URL=http://raptor-realtime-audio:8034

# GD-1 / VIE01-246: Module 35 deletes voice-clone speaker embeddings on
# erasure. Set it empty on a deployment without Module 35 (recorded as skipped).
GD_MODULE_35_URL=http://raptor-inference-service:8035

# V05-10 / VIE01-364: how long this service's CF-4 audit events (one
# `gdpr.erasure` event per finished erasure job, in its own audit_events
# table) are kept. Default matches gdpr_erasure_jobs' 3-year legal record.
GD_AUDIT_RETENTION_DAYS=1095
