NFS_SERVER=<your_nfs_server_ip>
NFS_EXPORT=/nfs-share
NFS_BASE_PATH=/path/to/your/storage
BASE_DIR=seaweedfs
SUB_DIRS="admin s3 backup filer vol1 vol2 vol3 vol4 master1 master2 master3"
BASE_DIR_2=aiml
SUB_DIRS_2="tmp data"
BASE_DIR_3=media
SUB_DIRS_3="processing"
BASE_DIR_4=memvid
SUB_DIRS_4="storage"

# ==================== Backup (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md) ====================
# The nfs-backup sidecar in this module's own docker-compose.yml runs
# scripts/nfs-sync-live.sh + scripts/nfs-freeze-archive.sh -- not an
# offen/docker-volume-backup sidecar, this directory has no owning
# application and no filesystem-snapshot primitive to rely on. No app
# code is baked into its image -- all three scripts are bind-mounted in
# from this module's own backup/ subdirectory at runtime.
# Same shared destination every other sidecar (02/03/06/24) uses -- the
# live mirror lives in its own subdirectory under it in-container, not a
# separate var/volume. See docker-compose.yml's nfs-backup service.
BACKUP_LOCAL_ARCHIVE_PATH=<your_backup_destination_path>
NFS_BACKUP_INCLUDE_PATHS="seaweedfs memvid/storage"
NFS_BACKUP_RETENTION_DAYS=30
NFS_BACKUP_QUIESCENCE_MAX_BYTES=104857600
NFS_BACKUP_QUIESCENCE_MAX_FILES=200
NFS_BACKUP_QUIESCENCE_MAX_RETRIES=3
NFS_BACKUP_PROMETHEUS_URL=
NFS_BACKUP_KAFKA_CONSUMER_GROUPS=
NFS_BACKUP_SEAWEEDFS_STATUS_URL=
# Freezes /asset and /memory writes at module 13 for the frozen window --
# must match that module's own GATEWAY_INTERNAL_ADMIN_TOKEN.
NFS_BACKUP_GATEWAY_URL=http://raptor-api-gateway:8012
NFS_BACKUP_GATEWAY_INTERNAL_TOKEN=<your_internal_admin_token>
NFS_BACKUP_GATEWAY_FREEZE_TTL_SECONDS=600
NFS_BACKUP_GATEWAY_TIMEOUT_SECONDS=10
# Private key storage -- deliberately not BACKUP_LOCAL_ARCHIVE_PATH (see
# that var's own comment). Must come before AGE_PUBLIC_KEYS: --init-env's
# generator for that one reads this in the same run.
AGE_PRIVATE_KEY_PATH=<path_to_store_the_age_private_key_offline>
AGE_PUBLIC_KEYS=<age1...public_key_from_age-keygen>
# Real crontab syntax, read by the sidecar's entrypoint.
NFS_SYNC_CRON=0 * * * *
NFS_BACKUP_CRON=0 3 * * *
