PORT_BENCHMARK_SERVICE=8022             # → container 8000

# ── 23 Guardrail Service ─────────────────────────────────────
PORT_GUARDRAIL_SERVICE=8023             # → container 8026; bound to INTERNAL_BIND_IP only (CF-3); container-to-container calls (13, 07) use 8026 directly
# (shares module 03's Postgres and module 02's Redis -- no dedicated DB ports here)

# ── 24 ArcadeDB Server ───────────────────────────────────────
PORT_ARCADEDB_HTTP=2480                 # → container 2480; HTTP API — Module 25 connects here; Studio UI
PORT_ARCADEDB_BINARY=2424               # → container 2424; binary protocol (optional)

# ── 25 Personal DB Service ───────────────────────────────────
PORT_PERSONAL_DB=8025                   # → container 8000; bound to INTERNAL_BIND_IP only (CF-3)

# ── 26 Memory Service ────────────────────────────────────────
PORT_MEMORY_SERVICE=8026                # → container 8026; bound to INTERNAL_BIND_IP only (CF-3)

# ── 27 MCP Server ────────────────────────────────────────────
PORT_MCP_SERVER=8027                    # → container 8027

# ── 29 DocAgent ──────────────────────────────────────────────
PORT_DOC_PROCESSING_AGENT=8290          # → container 8290

# ── 33 Privacy Compliance Service ────────────────────────────
PORT_PRIVACY_SERVICE=8033               # → container 8033; bound to INTERNAL_BIND_IP only (CF-3)

# ── 34 Real-time Audio ───────────────────────────────────────
PORT_REALTIME_AUDIO=8035                # → container 8034; WebSocket /audio/stream
PORT_REALTIME_AUDIO_GRPC=8044           # → container 8044; gRPC raptor.audio.v1.AudioService (RA-6)

# ── 35 Inference Service ─────────────────────────────────────
PORT_INFERENCE=8036                     # → container 8035

# ── 36 gRPC Gateway ──────────────────────────────────────────
PORT_GRPC_GATEWAY=8825                  # → container 8825; gRPC (RaptorService + grpc.health.v1)
PORT_GRPC_GATEWAY_METRICS=9825          # → container 9825; Prometheus /metrics

# ============================================================
# GPU ALLOCATION SETTINGS（所有需要 GPU 的服務，集中在此管理）
# _GPU=N → docker-compose device_ids 精確指定實體 GPU 索引（0 起算）
#           容器內部永遠以 CUDA_VISIBLE_DEVICES=0 存取
# ============================================================

# ── 共用 ─────────────────────────────────────────────────────
MAX_MEMORY_PER_GPU=36GiB          # 10 11（InternVL VLM 最大顯存）

# ── 04 Object Storage (thumbnail-worker) ─────────────────────
THUMBNAIL_GPU=0

# ── 07 AI-ML Services (ai-lifecycle-api) ─────────────────────
AI_LIFECYCLE_GPU=0

# ── 09 Audio Processing ──────────────────────────────────────
AUDIO_RECOGNIZER_GPU=0
AUDIO_DIARIZATION_GPU=0
AUDIO_CLASSIFIER_GPU=0

# ── 10 Image Processing ──────────────────────────────────────
IMAGE_PROCESSING_GPU=0

# ── 11 Video Processing ──────────────────────────────────────
# VIDEO_CHUNKING_GPU=1, not 0: confirmed live (2026-08-24) that ffmpeg
# h264_nvenc fails 100% deterministically on GPU 0 on multi-GPU hosts running
# driver 595.84 ("OpenEncodeSessionEx failed: unsupported device (2)"),
# while GPU 1 works cleanly -- CUDA compute (torch) is unaffected on either
# GPU, this is NVENC-specific. video-chunking is the only module-11 service
# that actually calls ffmpeg's hwaccel/nvenc path (frame_selector.py +
# chunker.py) -- video-ocr-frame/video-frame-description only do CUDA
# compute (PaddleOCR/InternVL inference on already-extracted frame images),
# confirmed via a full grep of both services' code, so they don't need this
# and are left on GPU 0. Full investigation: Issue #94. If your host isn't
# hitting this (different driver version, single GPU, etc.), 0 is fine.
VIDEO_CHUNKING_GPU=1
VIDEO_OCR_GPU=0
VIDEO_FRAME_DESC_GPU=0
VIDEO_FACE_GPU=0

# ── 12 Document Processing ───────────────────────────────────
DOCUMENT_ANALYSIS_GPU=0

# ── 16 Training Service ──────────────────────────────────────
CUDA_VISIBLE_DEVICES=0,1          # multi-GPU training

# ── 17 Hybrid Search ─────────────────────────────────────────
HYBRID_SEARCH_GPU=1

# ── 18 Query Orchestrator ────────────────────────────────────
QUERY_ORCHESTRATOR_GPU=0

# ── 23 Guardrail Service (image guard: Llama Guard Vision + ShieldGemma) ──
# Set to a GPU not already occupied by other services; check with
# nvidia-smi --query-compute-apps=pid,gpu_uuid,used_memory --format=csv
GUARDRAIL_GPU_ID=0
GUARDRAIL_CUDA_DEVICE=0            # index among the GPUs visible in the container

# ── 25 Personal DB Service (embedder + local reranker) ───────
PERSONAL_DB_GPU=0

# ── 26 Memory Service (local bge-m3 embedder) ─────────────────
MEMORY_SERVICE_GPU=0

# ── 34 Realtime Audio（faster-whisper STT；large-v3 float16 約 4 GB）──
REALTIME_AUDIO_GPU=0
REALTIME_AUDIO_BREEZE_GPU=0       # 只在 --profile breeze 時使用（約 8 GB）

# ── 35 Inference Service (voice path only: XTTS clone + pyannote/whisperX
#     diarization; the text path calls 07, never touches a GPU locally) ──
INFERENCE_VOICE_GPU=0

# ============================================================
# 全域共用設定（真正無 module 歸屬的設定）
# ============================================================

# ── 基礎設施 ─────────────────────────────────────────────────
DOCKER_NETWORK=<your_docker_network_name>
HOST_IP=<host_ip>
TIMEZONE=Asia/Taipei

# 自己 build 的 raptor/* image 的版本標籤（platform.yml 之類的第三方 image，如
# postgres/redis/lakefs/opensearch，各自獨立釘版本，不受這個變數影響）。升版時
# 只改這一個地方，不用一個一個 docker-compose.yml 改 image tag。
RAPTOR_VERSION=0.5

# docker compose 的 project name，留空就沿用預設行為（抓每個模組自己資料夾的名
# 稱，例如 04-object-storage）。只有在同一台主機上要同時/交替跑兩套不同版本
# （例如升版期間想保留舊版隨時能切回去）時才需要設一個值，讓新舊兩套的 volume/
# network 命名空間完全分開，不會互相覆蓋。
COMPOSE_PROJECT_NAME=raptor_0_5

# ── API 版本（06 13 27 共用；直接跟著 RAPTOR_VERSION 走，不再各自維護一份）──
API_VERSION=${RAPTOR_VERSION}

# ── HuggingFace（07 09 10 11 12 17 23 共用，無單一 module 歸屬）──
HF_TOKEN=<your_hf_token>
HF_CACHE_PATH=<your_hf_cache_path>

# ── 外部 LLM — Ollama（非 Raptor module，外部部署）──────────
OLLAMA_HOST=http://<host_ip>:11434
LLM_BASE_URL=${OLLAMA_HOST}/v1
LLM_MODEL=gemma4:12b
# 15（經 07 轉發，ChatOpenAI + extra_body）/21 的 pipeline.py（同樣經 07）共用
# -- 兩邊都是靠 07 的 /v1/chat/completions 或 /inference/infer 把這個值傳進
# Ollama 原生 API 才吃得到，Ollama 自己的 OpenAI-compat 層會靜默忽略，實測過。
# 預設值請對齊 LLM_MODEL 實際設定的模型自己的 context length（Ollama /api/show
# 的 model_info.*.context_length 查得到），不是隨便抓的數字 -- 換模型記得跟著改。
LLM_NUM_CTX=262144
# gemma4 系列模型預設會開啟「思考」模式，明確設 false 可跳過，省下 10-20 倍延遲
# （實測 4.8s vs 59s，同一個 prompt）。單一真實來源 -- 09/11/12/15/18/20/21/25/26
# 每個經由 07 呼叫 Ollama 的服務都各自有自己的 <module>_INFERENCE_THINK 變數
# （15 是 CHAT_LLM_THINK，20 是 GRAPH_INFERENCE_THINK，21 是 AGENT_INFERENCE_THINK，
# 見各自 module 區塊）代換這個值，方便追蹤是哪個服務在用；不要在各 module
# 區塊裡再各自定義獨立的預設值。
LLM_THINK=false

# ── VLM 模型基準（10 11 12 各可獨立覆蓋）────────────────────
VLM_MODEL_PATH=OpenGVLab/InternVL3_5-1B
VLM_MODEL_REVISION=2f71cf52542334823e48a46ffba0e2bc9add3446

# ── S3 / AWS 認證（04 07 共用）──────────────────────────────
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>

# ── 跨服務超時（09 11 使用）─────────────────────────────────
CROSS_SERVICE_TIMEOUT=600

# ── 備份 sidecar 共用設定（VIE01-369 Phase 1；03 06 24 02 05 16 共用，見 docs/backup-restore-v0.5.md）──
# 私鑰存放位置 -- 故意不能跟 BACKUP_LOCAL_ARCHIVE_PATH 同一個地方（備份加密的意義就在
# 於能讀到備份的人不代表能解密）。--init-env 會建議預設值，也可以改成你實際要離線保存
# 的地方（外接硬碟、同步的密碼庫資料夾等）。必須排在 AGE_PUBLIC_KEYS 前面：--init-env
# 在同一次執行中，AGE_PUBLIC_KEYS 的自動產生邏輯需要讀到這個值。
AGE_PRIVATE_KEY_PATH=<path_to_store_the_age_private_key_offline>
AGE_PUBLIC_KEYS=<age1...public_key_from_age-keygen>
BACKUP_NOTIFICATION_URLS=
BACKUP_LOCAL_ARCHIVE_PATH=<your_backup_destination_path>
BACKUP_SSH_HOST_NAME=
BACKUP_SSH_PORT=22
BACKUP_SSH_USER=
BACKUP_SSH_PASSWORD=
BACKUP_SSH_IDENTITY_FILE=
BACKUP_SSH_REMOTE_PATH=/backups/raptor
BACKUP_SSH_HOST_PUBLIC_KEY=
BACKUP_SSH_KNOWN_HOSTS_FILE=
BACKUP_SSH_IGNORE_HOST_KEY=false
BACKUP_WEBDAV_URL=
BACKUP_WEBDAV_PATH=
BACKUP_WEBDAV_USERNAME=
BACKUP_WEBDAV_PASSWORD=

# ============================================================
# 服務間通訊 URL
# .env 插值由上至下解析，module 13 引用了排序在後的 module（17 18 20 25），
# module 18 引用了排序在後的 module（23）；故這五個 URL 須提前定義；
# 括號內為實際歸屬 module
# ============================================================
HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000        # [17]
HYBRID_SEARCH_INGEST_URL=${HYBRID_SEARCH_URL}/api/v1/ingest/file  # [17]
QUERY_ORCHESTRATOR_URL=http://raptor-query-orchestrator:8000  # [18]
GRAPH_SERVICE_URL=http://raptor-graph-service:8843           # [20]
PERSONAL_DB_SERVICE_URL=http://raptor-personal-db-service:8000  # [25]
GUARDRAIL_URL=http://raptor-guardrail-service:8026            # [23]

# ============================================================
# 01 — nfs-server
# ============================================================
NFS_SERVER=${HOST_IP}
NFS_EXPORT=/nfs-share
NFS_MEDIA_TMP_PATH=/media/processing
NFS_AIML_TMP_PATH=/aiml/tmp
NFS_AIML_DATA_PATH=/aiml/data
# ── 初始化專用 ──
# 唯一真正的 host 路徑，上面 NFS_*_PATH/SEAWEEDFS_BASE_DIR 都只是它底下的子目錄。
# 多版本並存可帶 RAPTOR_VERSION，例如 .../Raptor_${RAPTOR_VERSION}_storage
#
# Must be a real local path on this host (or a direct mount of a real NAS) --
# never this host's own NFS client mount re-exported a second time (NAS ->
# this host as NFS client -> NFS_BASE_PATH pointed at that mount -> 01's
# nfs-server re-exports it again). Confirmed against the kernel's own NFS
# reexport docs: a reexport server categorically refuses file lock requests
# from its own clients ("any attempts will fail with operation not
# supported"). 26-memory-service's memvid_sdk takes a real OS-level lock
# (flock/fcntl) on its .mv2 files on every write -- that lock is baked into
# memvid_sdk's compiled native extension, with no parameter to disable it --
# so if NFS_BASE_PATH is a reexport, every write to 26's /memory/store,
# /memory/archive, etc. 500s unconditionally (confirmed live: errno 524
# ENOTSUPP, independent of which NFS server image is used -- this is a
# kernel-level restriction on the reexport topology itself, not a bug in any
# specific server). If local disk is too small, mount a real NAS directly
# (one NFS hop) instead of re-exporting this host's own NFS client mount.
NFS_BASE_PATH=<your_nfs_base_path>
BASE_DIR=seaweedfs
SUB_DIRS="admin s3 backup filer vol1 vol2 vol3 vol4 master1 master2 master3"
BASE_DIR_2=aiml
SUB_DIRS_2="tmp data"
BASE_DIR_3=media
SUB_DIRS_3="processing"
BASE_DIR_4=memvid
SUB_DIRS_4="storage"

# ==================== Backup (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md) ====================
# 01's own nfs-backup sidecar (01-nfs-server/docker-compose.yml), not an
# offen/docker-volume-backup one -- no container owns this shared,
# concurrently-written directory for a clean dump, and this host has no
# LVM/ZFS/Btrfs snapshot primitive, so it runs a two-phase rsync instead
# (nfs-sync-live.sh keeps an incrementally-updated mirror current, e.g.
# hourly cron; nfs-freeze-archive.sh does the actual archive, e.g. daily
# cron, inside the same write-freeze window 03's/24's dumps need --
# build.py --backup, not yet built). Shares the same
# BACKUP_LOCAL_ARCHIVE_PATH every other sidecar already uses below (no
# separate mirror-path var -- the live mirror lives in its own
# subdirectory under it in-container).
# Only seaweedfs/* (04's blobs) and memvid/storage (26's data) -- NOT
# aiml/tmp, aiml/data, or media/processing, all rebuildable scratch/cache.
NFS_BACKUP_INCLUDE_PATHS="seaweedfs memvid/storage"
NFS_BACKUP_RETENTION_DAYS=30
NFS_BACKUP_QUIESCENCE_MAX_BYTES=104857600
NFS_BACKUP_QUIESCENCE_MAX_FILES=200
NFS_BACKUP_QUIESCENCE_MAX_RETRIES=3
# Freezes writes via module 13's gateway (POST /admin/maintenance/enable|
# disable) instead of stopping any container -- a stopped container that
# doesn't come back up turns a backup into an outage; a 503 on writes
# doesn't. Covers 04's/26's synchronous HTTP write paths, NOT SeaweedFS's
# own background vacuum/balance/EC worker (open item, see
# docs/backup-restore-v0.5.md). GATEWAY_INTERNAL_ADMIN_TOKEN must match.
NFS_BACKUP_GATEWAY_URL=http://raptor-api-gateway:8012
NFS_BACKUP_GATEWAY_INTERNAL_TOKEN=<your_internal_admin_token>
NFS_BACKUP_GATEWAY_FREEZE_TTL_SECONDS=600
NFS_BACKUP_GATEWAY_TIMEOUT_SECONDS=10
# Optional, best-effort quiescence signals -- never block on their own,
# only shorten/lengthen the retry loop above. Leave blank to skip.
NFS_BACKUP_PROMETHEUS_URL=
NFS_BACKUP_KAFKA_CONSUMER_GROUPS=
NFS_BACKUP_SEAWEEDFS_STATUS_URL=

# ============================================================
# 02 — redis-cluster
# ============================================================
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
REDIS_DB=0

# ---- Backup sidecar (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md; shared destination/encryption vars are in the global section above) ----
REDIS_BACKUP_CRON=0 3 * * *
REDIS_BACKUP_RETENTION_DAYS=30

# ============================================================
# 03 — database
# ============================================================
POSTGRES_HOST=raptor-postgres
POSTGRES_PORT=5432
POSTGRES_USER=raptor
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=raptor          # PostgreSQL 容器預設 DB；另外建 mlflow/asset_management/gateway/benchmark/personal_db/guardrails/privacy_compliance/realtime_audio
QDRANT_HOST=raptor-qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=raptor

# ==================== Backup sidecar (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md) ====================
POSTGRES_BACKUP_CRON=0 3 * * *
POSTGRES_BACKUP_RETENTION_DAYS=30

# ============================================================
# 04 — asset-management
# ============================================================
ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000
# POSTGRES_DB 不在此定義：LakeFS 連線字串已有 :-asset_management 預設值（見 docker-compose.yml line 256）
# OpenSearch 連線變數（OPENSEARCH_HOST/PORT/USER/PASSWORD/INDEX/VERIFY_CERTS）
# 定義於 module 17 section，透過 env_file: path: ../.env 全量注入，ordering 無影響
# config.py 讀 AWS_ACCESS_KEY / AWS_SECRET_KEY（非標準 SDK 名稱），以下透過插值對應
AWS_ACCESS_KEY=${AWS_ACCESS_KEY_ID}
AWS_SECRET_KEY=${AWS_SECRET_ACCESS_KEY}
AUTO_DAILY_ARCHIVE_TIME=00:00
AUTO_DAILY_DESTROY_TIME=01:00
# MTR-8 / VIE01-307: max concurrent DB lookups per POST /scan batch request.
SCAN_CONCURRENCY=10
SEAWEEDFS_BASE_DIR=/seaweedfs
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_PUBLIC_URL=http://<host_ip>:8333
S3_BUCKET=lakefs
VOLUME_SIZE_LIMIT_MB=10240
MAX_NUMBER_OF_VOLUMES=50
LAKEFS_ENDPOINT=http://lakefs:8000
LAKEFS_ACCESS_KEY=<your_lakefs_access_key>
LAKEFS_SECRET_KEY=<your_lakefs_secret_key>
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=<your_lakefs_auth_encrypt_secret_key>
LAKEFS_REPOSITORY=asset-management
LAKEFS_PRE_SIGNED_EXPIRY=24h
PRESIGN_URL_CACHE_ENABLED=false

# ============================================================
# 05 — kafka-cluster
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=kafka-broker1:9092,kafka-broker2:9092,kafka-broker3:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ============================================================
# 06 — authentication
# ============================================================
KEYCLOAK_URL=http://raptor-keycloak:8080
# Keycloak's externally-visible address, as a full URL (06's KC_HOSTNAME + 13's GATEWAY_KEYCLOAK_PUBLIC_URL
# below both just copy this one value verbatim -- no module adds its own scheme/port to it, so there's
# nothing here for the TLS entry's https address to collide with). Default: plain http on this host.
# With the TLS entry, replace this line with the https address, KEYCLOAK_PUBLIC_URL=https://<host>:8443,
# and uncomment GATEWAY_PUBLIC_URL below.
KEYCLOAK_PUBLIC_URL=http://${HOST_IP}:${PORT_KEYCLOAK:-8080}
# TLS entry (06-authentication/README.md, "TLS for Keycloak and the gateway"). true: also set
# KEYCLOAK_PUBLIC_URL above + KEYCLOAK_BIND_ADDR/KC_PROXY_HEADERS/KC_HOSTNAME_BACKCHANNEL_DYNAMIC below,
# and GATEWAY_PUBLIC_URL in 13's section -- all six together, or it's only half turned on.
KEYCLOAK_TLS_ENABLED=false
# TLS_CERT_DIR=<directory_with_server_pem_and_key>   # default: 06-authentication/tls/certs
# KEYCLOAK_BIND_ADDR=127.0.0.1   # restricts Keycloak's own port to the proxy; empty (default): every interface
# KC_PROXY_HEADERS=xforwarded
# KC_HOSTNAME_BACKCHANNEL_DYNAMIC=true
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<your_keycloak_db_password>
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<your_keycloak_admin_password>
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<your_kc_bootstrap_admin_password>
PERMANENT_MASTER_ADMIN_USER=dhtsolution
PERMANENT_ADMIN_PASSWORD=<your_permanent_admin_password>
# Pushed onto the live "raptor" Keycloak client on every keycloak-init run
# (create-permanent-admin.sh) -- the realm-import JSON's own secret field is
# just an inert placeholder, never the real value. Generate with e.g.
# `openssl rand -hex 32`.
RAPTOR_CLIENT_SECRET=<your_raptor_client_secret>
KEYCLOAK_INFERENCE_URIS=/api/${API_VERSION}/search/*,/api/${API_VERSION}/asset/*,/api/${API_VERSION}/processing/*,/api/${API_VERSION}/chat/*,/api/${API_VERSION}/docagent/*,/api/${API_VERSION}/sync/*,/api/${API_VERSION}/a2a/*,/api/${API_VERSION}/memory/*,/api/${API_VERSION}/personal-db/*,/api/${API_VERSION}/identity/*,/api/${API_VERSION}/temporal/*,/api/${API_VERSION}/mcp/*,/api/${API_VERSION}/benchmark/*,/api/${API_VERSION}/guardrail/*,/api/${API_VERSION}/gdpr/*,/api/${API_VERSION}/moderation/*,/api/${API_VERSION}/compliance/*,/API/inference/*,/api/${API_VERSION}/inference/*,/raptor.v1.RaptorService/*
KEYCLOAK_FINETUNING_URIS=/API/finetune/*,/api/${API_VERSION}/aiml/*,/api/${API_VERSION}/training/*
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=
SMTP_AUTH=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=
SMTP_STARTTLS=
SMTP_TO_EMAIL=

# ---- Password Rotator (weekly, sidecar) ----
# Account list: edit deployment/modules/06-authentication/rotate_accounts.txt
# directly (one "username:email" per line, re-read every run, no restart
# needed) — ROTATE_ACCOUNTS below is only a fallback if that file isn't
# present. SMTP_HOST/PORT/USER/PASSWORD/FROM above are reused, no separate
# SMTP config needed here.
ROTATE_REALM=dhtsolution
ROTATE_ACCOUNTS=
ROTATE_BCC_EMAIL=
# Fixed weekly schedule — Monday=0 ... Sunday=6, 24h HOUR/MINUTE.
ROTATE_WEEKDAY=0
ROTATE_HOUR=9
ROTATE_MINUTE=0

# ---- Backup sidecar (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md; shared destination/encryption vars are in the global section above) ----
KEYCLOAK_BACKUP_CRON=0 3 * * *
KEYCLOAK_BACKUP_RETENTION_DAYS=30

# ============================================================
# 07 — ai-ml-services (AI Lifecycle API + MLflow)
# ============================================================
INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
INFERENCE_MODEL=gemma4:12b       # VIE01-418: migrated off the Qwen grandfather exception early
OLLAMA_API_BASE=${OLLAMA_HOST}
AI_LIFECYCLE_API_HOST=0.0.0.0
MLFLOW_VERSION=v3.15.0
MLFLOW_HOST=0.0.0.0
MLFLOW_TRACKING_URI=http://mlflow:5555
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow
MLFLOW_S3_ENDPOINT_URL=http://lakefs:8000
INFERENCE_MAX_INPUT_LENGTH=8192
# hostnames need a trailing :* (any port) -- a bare "raptor-mlflow" 403s
MLFLOW_SERVER_ALLOWED_HOSTS=localhost:*,127.0.0.1:*,raptor-mlflow:*,mlflow:*
MLFLOW_FLASK_SERVER_SECRET_KEY=<generate-with-openssl-rand-hex-32>
# overrides mlflow's documented default admin/password1234 -- change both, password must be >12 chars
MLFLOW_AUTH_ADMIN_USERNAME=<your_mlflow_admin_username>
MLFLOW_AUTH_ADMIN_PASSWORD=<your_mlflow_admin_password>
# mlflow's own client lib reads these two for basic-auth -- same creds as above
MLFLOW_TRACKING_USERNAME=${MLFLOW_AUTH_ADMIN_USERNAME}
MLFLOW_TRACKING_PASSWORD=${MLFLOW_AUTH_ADMIN_PASSWORD}

# ============================================================
# 09 — audio-processing
# ============================================================
AUDIO_SYNC_URL=http://raptor-audio-recognizer:8019
AUDIO_INFERENCE_MODEL=${INFERENCE_MODEL}
AUDIO_INFERENCE_THINK=${LLM_THINK}
WHISPER_MODEL=large-v3
PANNS_CACHE_PATH= <your_panns_cache_path> # /mnt/disk1/.cache/panns_data
AUDIO_RECOGNIZER_MEMORY_LIMIT=12g
AUDIO_RECOGNIZER_CPU_LIMIT=4
AUDIO_DIARIZATION_MEMORY_LIMIT=12g
AUDIO_DIARIZATION_CPU_LIMIT=4
AUDIO_CLASSIFIER_MEMORY_LIMIT=8g
AUDIO_CLASSIFIER_CPU_LIMIT=2
AUDIO_ORCHESTRATOR_MEMORY_LIMIT=2g
AUDIO_ORCHESTRATOR_CPU_LIMIT=1
AUDIO_ANALYSIS_MEMORY_LIMIT=4g
AUDIO_ANALYSIS_CPU_LIMIT=2
AUDIO_SUMMARY_MEMORY_LIMIT=4g
AUDIO_SUMMARY_CPU_LIMIT=2
AUDIO_INDEXER_MEMORY_LIMIT=2g
AUDIO_INDEXER_CPU_LIMIT=1
AUDIO_TTS_MEMORY_LIMIT=2g
AUDIO_TTS_CPU_LIMIT=1

# ============================================================
# 10 — image-processing
# ============================================================
IMAGE_VLM_MODEL_PATH=${VLM_MODEL_PATH}
IMAGE_VLM_MODEL_REVISION=${VLM_MODEL_REVISION}
IMAGE_PROCESSING_MEMORY_LIMIT=20g
IMAGE_PROCESSING_CPU_LIMIT=4
IMAGE_ORCHESTRATOR_MEMORY_LIMIT=2g
IMAGE_ORCHESTRATOR_CPU_LIMIT=1
IMAGE_INDEXER_MEMORY_LIMIT=2g
IMAGE_INDEXER_CPU_LIMIT=1
# CM-2: moderate every ingested image with a Module 23 image guard (at GUARDRAIL_URL,
# section 23 below). The verdict goes to Module 04's metadata and Module 25's Source
# record (moderation_flags); an unsafe image is still indexed. Off by default.
# MODEL: shieldgemma-2 | llama-guard-3-vision (judges text+image, not reliable for
# image-only checks -- see 10-image-processing/README.md). FAIL_MODE when Module 23 gives no
# verdict: open = index with verdict "error", closed = fail the image's job.
IMAGE_MODERATION_ENABLED=false
IMAGE_MODERATION_MODEL=shieldgemma-2
IMAGE_MODERATION_TIMEOUT=180
IMAGE_MODERATION_FAIL_MODE=open

# ============================================================
# 11 — video-processing
# ============================================================
VIDEO_VLM_MODEL_PATH=${VLM_MODEL_PATH}
VIDEO_VLM_MODEL_REVISION=${VLM_MODEL_REVISION}
VIDEO_INFERENCE_MODEL=${INFERENCE_MODEL}
VIDEO_INFERENCE_THINK=${LLM_THINK}
VIDEO_NORMALIZE_TIMEOUT_SEC=600          # per-tier ffmpeg timeout (CUDA / CPU-decode+nvenc / full-CPU libx264 fallback chain) -- was a bare literal 600 in chunker.py, not configurable at all until now
CONTEXTUALIZE_MODEL_NAME=
OCR_DET_MODEL=PP-OCRv5_mobile_det
OCR_REC_MODEL=PP-OCRv5_mobile_rec
OCR_PRECISION=fp16
SUMMARY_MAX_TOKENS=4000
SUMMARY_MAX_LENGTH=300
FACE_DETECTION_ENABLED=true             # set to false to stop the video orchestrator sending face-detection requests
# GD-11: even when enabled, faces are detected only for users with face_detection consent (asked of Module 33)
PRIVACY_COMPLIANCE_URL=http://raptor-privacy-compliance-service:8033
FACE_DET_THRESHOLD=0.5
FACE_MIN_SIZE_PX=20
FACE_SHOT_THRESHOLD=27.0
# CM-3: moderate a frame every SAMPLE_EVERY_SEC (default 2 s) plus each 10 s moment's 2
# description keyframes with Module 23's image guard
# (at GUARDRAIL_URL, section 23 below) as modality=video_frame -- needs Module 23 with
# CM-1. Per-moment verdicts go to Module 25's Chunks, the video's rollup to Module 04's
# metadata and Module 25's Source (moderation_flags); a flagged video is still indexed.
# Off by default. GPU cost ~0.4 s per frame with ShieldGemma 2 on an RTX 4090 (every 2 s +
# keyframes = 2520 frames = ~17 min per hour of moving video; still scenes cost less, as
# frames that barely change reuse a verdict) -- see 11-video-processing/README.md. Every
# scene as long as the interval is caught: 1 = 1 s scenes (~70 % more), 5 = ~40 % less.
# SCENE_CUTS also checks the first frame of every shot that starts and ends between two
# samples (a 0.4 s shot of its own, blurry or not), found in the same ffmpeg pass;
# SCENE_THRESHOLD = ffmpeg scene score for a cut (lower = softer cuts, more frames),
# MAX_CUTS_PER_MOMENT caps the extra frames per 10 s moment for fast-cut footage.
# FAIL_MODE when Module 23 gives no verdict for a frame: open = index anyway (verdict
# "error" if a moment couldn't be checked), closed = fail the video's job.
VIDEO_MODERATION_ENABLED=false
VIDEO_MODERATION_MODEL=shieldgemma-2
VIDEO_MODERATION_SAMPLE_EVERY_SEC=2
VIDEO_MODERATION_SCENE_CUTS=true
VIDEO_MODERATION_SCENE_THRESHOLD=0.3
VIDEO_MODERATION_MAX_CUTS_PER_MOMENT=5
VIDEO_MODERATION_SKIP_DUPLICATES=true
VIDEO_MODERATION_DUPLICATE_MAX_CHANGE=0.005
VIDEO_MODERATION_CONCURRENCY=2
VIDEO_MODERATION_TIMEOUT=180
VIDEO_MODERATION_FAIL_MODE=open
VIDEO_FRAME_DESC_MEMORY_LIMIT=20g
VIDEO_FRAME_DESC_CPU_LIMIT=4
VIDEO_OCR_MEMORY_LIMIT=8g
VIDEO_OCR_CPU_LIMIT=2
VIDEO_ORCHESTRATOR_MEMORY_LIMIT=2g
VIDEO_ORCHESTRATOR_CPU_LIMIT=1
VIDEO_CHUNKING_MEMORY_LIMIT=4g
VIDEO_CHUNKING_CPU_LIMIT=2
VIDEO_ANALYSIS_MEMORY_LIMIT=4g
VIDEO_ANALYSIS_CPU_LIMIT=2
VIDEO_SUMMARY_MEMORY_LIMIT=4g
VIDEO_SUMMARY_CPU_LIMIT=2
VIDEO_CONTEXTUALIZE_MEMORY_LIMIT=2g
VIDEO_CONTEXTUALIZE_CPU_LIMIT=1
VIDEO_INDEXER_MEMORY_LIMIT=2g
VIDEO_INDEXER_CPU_LIMIT=1
VIDEO_GRAPH_MEMORY_LIMIT=512m
VIDEO_GRAPH_CPU_LIMIT=0.5
VIDEO_FACE_MEMORY_LIMIT=6g
VIDEO_FACE_CPU_LIMIT=2

# ============================================================
# 12 — document-processing
# ============================================================
DOCUMENT_ANALYSIS_VLM_MODEL=${VLM_MODEL_PATH}
DOCUMENT_ANALYSIS_VLM_MODEL_REVISION=${VLM_MODEL_REVISION}
DOCUMENT_INFERENCE_MODEL=${INFERENCE_MODEL}
DOCUMENT_INFERENCE_THINK=${LLM_THINK}
DOCUMENT_ANALYSIS_MEMORY_LIMIT=20g
DOCUMENT_ANALYSIS_CPU_LIMIT=4
DOCUMENT_ANALYSIS_MAX_CHUNK_TOKENS=400
DOCUMENT_ANALYSIS_MAX_WORKERS=8
DOCUMENT_ANALYSIS_CONTEXTUAL_TIMEOUT=120
DOCUMENT_ANALYSIS_CONTEXTUAL_BATCH_SIZE=5
DOCUMENT_ORCHESTRATOR_MEMORY_LIMIT=2g
DOCUMENT_ORCHESTRATOR_CPU_LIMIT=1
DOCUMENT_SUMMARY_MEMORY_LIMIT=8g
DOCUMENT_SUMMARY_CPU_LIMIT=2
DOCUMENT_INDEXER_MEMORY_LIMIT=4g
DOCUMENT_INDEXER_CPU_LIMIT=2

# ============================================================
# 13 — api-services (api-gateway)
# config.py 使用 env_prefix="GATEWAY_"，以下透過變數插值對應共用設定
# ============================================================
# Write-freeze maintenance mode (VIE01-369) -- same value as
# NFS_BACKUP_GATEWAY_INTERNAL_TOKEN in the 01 Backup section above, via
# variable interpolation (confirmed this .env file's own ${VAR} references
# resolve in declaration order, so this only works because that section
# is defined earlier in this file) rather than two separate placeholders
# that have to be kept in sync by hand.
GATEWAY_INTERNAL_ADMIN_TOKEN=${NFS_BACKUP_GATEWAY_INTERNAL_TOKEN}
GATEWAY_REDIS_HOST=${REDIS_HOST}
GATEWAY_REDIS_PORT=${REDIS_PORT}
GATEWAY_REDIS_PASSWORD=${REDIS_PASSWORD}
GATEWAY_REDIS_DB=${REDIS_DB}
GATEWAY_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}
GATEWAY_HYBRID_SEARCH_URL=${HYBRID_SEARCH_URL}
GATEWAY_ASSET_MANAGEMENT_URL=${ASSET_MANAGEMENT_URL}
GATEWAY_GRAPH_SERVICE_URL=${GRAPH_SERVICE_URL}
GATEWAY_PERSONAL_DB_URL=${PERSONAL_DB_SERVICE_URL}
GATEWAY_QUERY_ORCHESTRATOR_URL=${QUERY_ORCHESTRATOR_URL}
GATEWAY_AUDIO_SYNC_URL=${AUDIO_SYNC_URL}
GATEWAY_AIML_LIFECYCLE_API_URL=${INFERENCE_URL}
# gateway 專屬設定
GATEWAY_API_VERSION=${API_VERSION}
GATEWAY_LOG_LEVEL=INFO
GATEWAY_AUTH_SERVICE_URL=http://raptor-keycloak-api:8800
GATEWAY_KEYCLOAK_URL=${KEYCLOAK_URL}
# MCP OAuth discovery (RFC 9728) — see MCP_OAUTH_REQUIREMENTS.md. Unlike
# GATEWAY_KEYCLOAK_URL above, must be reachable from an MCP client on the
# user's own machine, not just inside the raptor Docker network. Always the
# same address as KEYCLOAK_PUBLIC_URL above -- just copied, not rebuilt with
# its own scheme/port, so switching to the TLS entry only ever means
# changing KEYCLOAK_PUBLIC_URL itself, nothing here.
# The gateway reads this file after 13-api-services/.env, so this value wins over that one.
GATEWAY_KEYCLOAK_PUBLIC_URL=${KEYCLOAK_PUBLIC_URL}
# The https address clients use for the gateway behind the TLS entry. Left commented out on purpose: an
# empty value here would override one set in 13-api-services/.env.
# GATEWAY_PUBLIC_URL=https://<host>:8013
GATEWAY_KEYCLOAK_REALM=dhtsolution
GATEWAY_KAFKA_TOPICS='{"document": "document-processing-requests", "image": "image-processing-requests", "video": "video-processing-requests", "audio": "audio-processing-requests"}'
GATEWAY_CHAT_SERVICE_URL=http://raptor-chat-service:8021
GATEWAY_DOCUMENT_SYNC_URL=http://raptor-document-analysis:8020
GATEWAY_IMAGE_SYNC_URL=http://raptor-image-processing:8018
GATEWAY_VIDEO_FRAME_SYNC_URL=http://raptor-video-frame-description:8031
GATEWAY_TRAINING_SERVICE_URL=http://raptor-training-service:8009/api/v1/training
GATEWAY_VISION_SERVICE_URL=http://raptor-temporal-model-service:8000/analyze/video
GATEWAY_AGENT_PROTOCOL_URL=http://raptor-agent-protocol:8030
GATEWAY_MEMORY_SERVICE_URL=http://raptor-memory-service:8026
GATEWAY_OPENSEARCH_BRIDGE_URL=http://raptor-opensearch-bridge:8840
GATEWAY_DOC_AGENT_URL=http://raptor-doc-processing-agent:8290
GATEWAY_MAX_CONNECTIONS=100
GATEWAY_MAX_KEEPALIVE_CONNECTIONS=20
GATEWAY_REQUEST_TIMEOUT=10.0
GATEWAY_UPLOAD_TIMEOUT=300.0
# CM-7 / VIE01-410: GET /compliance/report waits for Module 33 to read the whole period
GATEWAY_COMPLIANCE_REPORT_TIMEOUT=120.0
GATEWAY_BATCH_UPLOAD_CONCURRENCY=4
GATEWAY_RATE_LIMIT_PER_USER_PER_MINUTE=1000
GATEWAY_INTENT_MODEL=${LLM_MODEL}
GATEWAY_ANSWER_MODEL=${LLM_MODEL}
GATEWAY_SMOLAGENTS_MODEL=ollama/${LLM_MODEL}
GATEWAY_VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR
GATEWAY_AGENT_ID=raptor-gateway
GATEWAY_AGENT_NAME="Raptor Gateway Agent"

# ============================================================
# 14 — monitoring (Grafana)
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<your_grafana_admin_password>
# Kafka broker hostnames for kafka-exporter -- override only if 05-kafka-cluster's
# compose service names differ from the defaults below.
KAFKA_BROKER_1=kafka-broker1
KAFKA_BROKER_2=kafka-broker2
KAFKA_BROKER_3=kafka-broker3
# Real webhook URL for Alertmanager notifications -- build.py auto-writes it
# into config/alertmanager/webhook_url (gitignored) every run. Blank = alerts
# fire but nobody gets notified.
ALERT_WEBHOOK_URL=
# true only on hosts with the NVIDIA DCGM stack installed -- adds
# --profile gpu so build.py actually starts dcgm-exporter.
ENABLE_GPU_MONITORING=false

# ============================================================
# 15 — chat-service
# ============================================================
CHAT_LLM_MODEL=${LLM_MODEL}
# Chat LLM calls go through module 23's guardrail proxy (container port 8026);
# the shared LLM_BASE_URL above is the direct fallback, used only when module
# 23 is unreachable or its check fails and GUARDRAIL_FALLBACK_PASSTHROUGH=true.
# A policy violation never falls back. Direct calls again: CHAT_LLM_BASE_URL=${LLM_BASE_URL}
CHAT_LLM_BASE_URL=http://raptor-guardrail-service:8026/v1
GUARDRAIL_FALLBACK_PASSTHROUGH=true
TEMPERATURE=0.7
# LLM_NUM_CTX 因插值順序限制定義於上方（15/21 共用）
CHAT_LLM_THINK=${LLM_THINK}
MEMORY_CONTEXT_WINDOW=5
MEMORY_TTL=3600
REQUEST_TIMEOUT=60.0
CHAT_MEMORY_SERVICE_URL=http://raptor-memory-service:8026

# ============================================================
# 16 — training-service
# ============================================================
VRAM_OVERHEAD_GB=1.0
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# ============================================================
# 17 — hybrid-search
# HYBRID_SEARCH_URL / HYBRID_SEARCH_INGEST_URL 因插值順序限制定義於上方
# ============================================================
OPENSEARCH_HOST=opensearch-node1
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<your_opensearch_password>
OPENSEARCH_INDEX=hybrid_index
OPENSEARCH_VERIFY_CERTS=False
EMBEDDING_MODEL=BAAI/bge-m3 # intfloat/multilingual-e5-large   # 1024-dim; changing the embedding model requires rebuilding existing vector indexes
VECTOR_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3 # cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TEMPERATURE=0.25
OPENSEARCH_DASHBOARDS_HOST=opensearch-dashboards
RRF_K_FACTOR=60

# ============================================================
# 18 — query-orchestrator
# QUERY_ORCHESTRATOR_URL 因插值順序限制定義於上方
# config.py 使用 env_prefix="QO_"
# ============================================================
QO_INFERENCE_URL=${INFERENCE_URL}
QO_INFERENCE_MODEL=gemma4:12b
QO_INFERENCE_TIMEOUT=15
QO_INFERENCE_THINK=${LLM_THINK}
QO_LOG_LEVEL=INFO
# GB-22: registers mcp_tool_calls in module 23's coverage matrix at startup.
QO_GUARDRAIL_URL=${GUARDRAIL_URL}

# ============================================================
# 19 — graph-database
# ============================================================
NEO4J_URI=bolt://raptor-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your_neo4j_password>

# ============================================================
# 20 — graph-service
# GRAPH_SERVICE_URL 因插值順序限制定義於上方
# ============================================================
CHAT_MODEL_NAME=${LLM_MODEL}
GRAPH_INFERENCE_THINK=${LLM_THINK}

# ============================================================
# 21 — agent-protocol (A2A orchestrator + RAG pipeline)
# ============================================================
OLLAMA_MODEL=${LLM_MODEL}
AGENT_INFERENCE_THINK=${LLM_THINK}      # pipeline.py + graphrag-agent + tkg-agent 共用同一個值
AGENT_ID=raptor-agent
AGENT_NAME="Raptor Intelligence Agent"
AGENT_ENDPOINT=http://raptor-agent-protocol:8030
# A2A 搜尋 agents（docker 內部網路）
VECTOR_AGENT_URL=http://raptor-vector-agent:52001
KEYWORD_AGENT_URL=http://raptor-keyword-agent:52002
GRAPHRAG_AGENT_URL=http://raptor-graphrag-agent:52003
TKG_AGENT_URL=http://raptor-tkg-agent:52004
RERANKER_AGENT_URL=http://raptor-reranker-agent:52005
PEOPLE_AGENT_URL=http://raptor-people-agent:52006
AGENT_TTL=300                           # A2A peer discovery Redis key TTL (seconds)
LLM_ANSWER_TEMPERATURE=0.3              # RAG answer synthesis (_llm_answer) -- separate from module 15's TEMPERATURE (0.7) on purpose

# Routed through Module 13's JWT-protected gateway, not Module 26 directly —
# 21 forwards the caller's own Authorization header (see memory_client.py).
MEMORY_SERVICE_URL=http://raptor-api-gateway:8012/api/${API_VERSION}
MEM_COMPACT_THRESHOLD=128000

# ============================================================
# 22 — benchmark-service
# ============================================================
BM_LOG_LEVEL=INFO
BM_POSTGRES_DB=benchmark
BM_REDIS_RUN_TTL_SECONDS=604800
BM_INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
BM_JUDGE_MODEL=gemma4:12b
BM_JUDGE_ENGINE=ollama
BM_JUDGE_THINK=${LLM_THINK}
BM_INFERENCE_TIMEOUT=30
BM_EMBED_MODEL=bge-m3
BM_EMBED_TIMEOUT=30
BM_PIPELINE_TIMEOUT=30
BM_CHAT_URL=http://raptor-chat-service:8021
BM_SEARCH_URL=http://raptor-personal-db-service:8000
BM_RAG_URL=http://raptor-agent-protocol:8030
BM_CLASSIFY_URL=http://raptor-query-orchestrator:8000

# ============================================================
# 23 — guardrail-service
# GUARDRAIL_URL itself is defined up in "服務間通訊 URL" (module 18 needs it
# before this section) -- tagged [23] there. GUARDRAIL_TIMEOUT stays here.
# Both are shared-by-name config (which service to call, how long to wait)
# read bare by modules 07, 13, 15 and 21; GB-22 registration added 18's own
# QO_GUARDRAIL_URL and 36's own GRPC_GATEWAY_GUARDRAIL_URL instead, since
# each reads env vars through its own prefix, both pointing at the one
# GUARDRAIL_URL above via ${GUARDRAIL_URL}. Never redefine GUARDRAIL_URL
# itself in another module's section elsewhere in this file: a repeated key
# in a .env file is last-one-wins, and GB-22's own first cut did exactly
# that with the wrong port (8023, host-only) before this.
# GR_ENABLED (module 13) and AIML_GUARDRAIL_ENABLED (module 07) are each
# module's own separate on/off switch, both false by default -- deliberately
# two independent switches, not one shared one: module 13 needs GUARDRAIL_URL
# populated regardless of whether module 07's hook should run, so "URL is
# set" can never be allowed to double as an enable signal for either side.
# Flip these two independently depending on which one (or both) you actually
# want checking content. The AIML_ prefix on module 07's switch is there
# specifically so the two lines below don't look like the same thing at a
# glance -- bare GUARDRAIL_ENABLED is also still accepted by the code if you
# prefer it, but AIML_GUARDRAIL_ENABLED is what's actually set here.
# Container-to-container calls always use 8026 (the container's fixed internal
# port), never PORT_GUARDRAIL_SERVICE (8023, host-only mapping — see above).
# Module 23 shares module 03's Postgres (database "guardrails") and module
# 02's Redis (DB 0) directly via the platform-wide POSTGRES_*/REDIS_* vars —
# no dedicated DB vars of its own.
# ============================================================
GUARDRAIL_TIMEOUT=20.0
GR_ENABLED=false
AIML_GUARDRAIL_ENABLED=false
# OpenAI-compatible proxy (/v1/chat/completions, /v1/models): where checked
# requests go (base URL, no /v1). ${OLLAMA_HOST} keeps module 15 on the same
# upstream it uses today via the shared LLM_BASE_URL (Ollama's /v1, which
# ignores num_ctx/think). With module 07 deployed, use
# http://raptor-ai-lifecycle-api:8010 instead -- it honours num_ctx/think, and
# is the code default. Callers reach the proxy at
# http://raptor-guardrail-service:8026/v1 (container port, see above).
PROXY_UPSTREAM_URL=${OLLAMA_HOST}
PROXY_UPSTREAM_TIMEOUT=120.0
# Leave GUARD_MODEL_2/3 blank for single-model (llama-guard3:8b only).
GUARD_MODEL=llama-guard3:8b
GUARD_MODEL_2=granite4.1-guardian:8b
GUARD_MODEL_3=gpt-oss-safeguard:20b
# How disagreeing multi-guard-model verdicts resolve: strict (any unsafe ->
# unsafe, default) | majority | permissive (all must say unsafe).
GUARD_CONFLICT_STRATEGY=strict
# Image guard models: Llama Guard 3 11B Vision + Google ShieldGemma 2
# Both are gated — HF_TOKEN (above) must have approved access on HuggingFace.
# HF_CACHE_PATH (above) is the shared cache; no separate volume needed.
# GUARDRAIL_GPU_ID / GUARDRAIL_CUDA_DEVICE are set in the GPU ALLOCATION
# SETTINGS block above, with the other modules' GPU assignments.
LLAMA_GUARD_3_MODEL_PATH=meta-llama/Llama-Guard-3-11B-Vision
SHIELDGEMMA2_MODEL_PATH=google/shieldgemma-2-4b-it
# Llama Guard 3 11B bfloat16 ≈ 22 GB — 4-bit required on any ≤24 GB GPU
LLAMA_GUARD_LOAD_IN_4BIT=true
# ShieldGemma 2 4B: 8-bit (≈ 4 GB) by default to leave headroom for Llama Guard inference activations
SHIELDGEMMA2_LOAD_IN_8BIT=true

# ============================================================
# 24 — arcadedb-server (multi-model engine: graph + vector + BM25)
# (PORT_ARCADEDB_HTTP / PORT_ARCADEDB_BINARY are in HOST PORT SETTINGS above)
# ============================================================
# Required — compose refuses to start without it. Replace before deploying.
ARCADEDB_ROOT_PASSWORD=<your_arcadedb_root_password>

# ---- Backup sidecar (VIE01-369 Phase 1, see docs/backup-restore-v0.5.md; shared destination/encryption vars are in the global section above) ----
ARCADEDB_BACKUP_CRON=0 3 * * *
ARCADEDB_BACKUP_RETENTION_DAYS=30

# ============================================================
# 25 — personal-db-service (per-user isolated DB: lifecycle + search)
# (PORT_PERSONAL_DB is in HOST PORT SETTINGS above)
# PERSONAL_DB_SERVICE_URL 因插值順序限制定義於上方（consumed by module 13; 15/21 也直接讀取此變數，見各自的 docker-compose.yml）
# ============================================================
PD_ARCADEDB_URL=http://raptor-arcadedb:2480
PD_VECTOR_DIM=1024                      # BAAI/bge-m3 embedding dimension
PD_AUDIT_REQUIRED=1                     # 0 refuses nothing; 1 refuses DELETE when the audit DB is down
PD_KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP_SERVERS}   # consumes personal-index-requests (Module 05)
PD_REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379   # version_id dedup (Module 02)
PD_EMBEDDING_MODEL=BAAI/bge-m3
PD_EMBEDDING_DEVICE=auto                # cpu | cuda | auto
PD_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
PD_RERANKER_DEVICE=auto                 # cpu | cuda | auto
PD_RERANKER_TEMPERATURE=0.25            # sigmoid temperature scaling; <1 sharpens score distribution
PD_RERANKER_MAX_LENGTH=512              # tokenized length cap per pair; one long outlier otherwise pads the whole batch
PD_RERANK_DEPTH=15                      # fusion pool widened to this before rerank, then truncated to top_k
PD_LLM_BASE_URL=${LLM_BASE_URL}         # personal-graph entity extraction (video only) — shares Module 20's Ollama endpoint
PD_CHAT_MODEL_NAME=${CHAT_MODEL_NAME}   # shares Module 20's chat model
PD_INFERENCE_URL=${INFERENCE_URL}       # extraction actually calls this (module 07), not PD_LLM_BASE_URL directly
PD_INFERENCE_THINK=${LLM_THINK}
PD_GRAPH_EXTRACTION_ENABLED=1           # 0 disables video graph extraction entirely
PD_TEMPORAL_JOBS_ENABLED=1               # P12: durable temporal job per indexed source, every medium (0: none)
PD_TEMPORAL_LLM_ENABLED=1                # 0: rules-only temporal extraction, no Module 07 calls
PD_TEMPORAL_LLM_CONCURRENCY=1            # concurrent Module 07 calls for temporal extraction (4 made the gateway drop connections in testing)
PD_TEMPORAL_JOB_WORKERS=2                # temporal jobs run side by side (model calls still take turns), so a short document is not stuck behind a long video
PD_GRAPH_EXTRACTION_MAX_CONCURRENCY=1    # max videos extracting concurrently (background tasks). Was 2; lowered live (2026-08-24) after a shared Ollama instance's model runner crashed while 2 videos were extracting at once ("model runner has unexpectedly stopped, this may be due to resource limitations or an internal error" -- Ollama's own generic error, not a confirmed diagnosis). Root cause unconfirmed -- could be our own concurrent load, could be another team's much larger model on the same shared instance (it hosts models up to 290GB); no log evidence either way. 1 keeps this service's own contribution to that risk minimal either way.
PD_GRAPH_EXTRACTION_BATCH_CONCURRENCY=2  # max concurrent LLM calls WITHIN one video's extraction (moment batches). Separate axis from the max-videos setting above -- this bounds how fast a single video's own extraction finishes, which matters because MAX_CONCURRENCY=1 means the next queued video's extraction can only start once the current one's LLM calls are all done; a faster single video shrinks that queueing window.
# ARCADEDB_ROOT_PASSWORD is shared with Module 24 — see the 24 section above.
# The deletion audit uses POSTGRES_* (above) against the `personal_db` database,
# created by Module 03's init/postgresql/001_init.sql.

# ============================================================
# 26 — memory-service (MemVID session / long-term memory)
# PORT_MEMORY_SERVICE 因插值順序限制定義於上方
# config.py 使用 env_prefix="MEM_"
# ============================================================
NFS_MEMVID_PATH=/memvid/storage
MEM_STORAGE_ROOT=/mnt/memvid-storage
MEM_EMBEDDING_MODEL=BAAI/bge-m3
# preference/entity/fact extraction + compact_session summarization -- was never
# wired to anything, silently defaulted to a hardcoded default in config.py
# regardless of LLM_MODEL; note the real env var here is MEM_EXTRACTION_MODEL
# (config.py uses env_prefix="MEM_"), not bare EXTRACTION_MODEL
MEM_EXTRACTION_MODEL=${LLM_MODEL}
MEM_MODULE07_URL=${INFERENCE_URL}
MEM_INFERENCE_THINK=${LLM_THINK}
MEM_REDIS_HOST=${REDIS_HOST}
MEM_REDIS_PORT=${REDIS_PORT}
MEM_REDIS_PASSWORD=${REDIS_PASSWORD}
MEM_COMPACT_KEEP_TURNS=10
MEM_COMPACT_TOOL_RESULT_RETENTION_HOURS=24.0

# ============================================================
# 27 — mcp-server
# config.py 使用 env_prefix="MCP_"
# ============================================================
MCP_SERVER_NAME=raptor-mcp
MCP_SERVER_VERSION=1.0.0
MCP_API_GATEWAY_BASE_URL=http://raptor-api-gateway:8012
MCP_API_VERSION=${API_VERSION}
MCP_KEYCLOAK_URL=${KEYCLOAK_URL}
MCP_REALM_NAME=dhtsolution
MCP_CLIENT_ID=raptor
# Fallback login when no JWT is forwarded. Fine as one shared value here for
# a shared HTTP-transport deployment; do NOT copy these same values into a
# stdio user's own local 27-mcp-server/.env — each stdio user should use
# their own individual Keycloak login there instead (see that file's
# MCP_KEYCLOAK_USERNAME comment for why).
MCP_KEYCLOAK_USERNAME=<service_account_username>
MCP_KEYCLOAK_PASSWORD=<service_account_password>
MCP_REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379/3
MCP_LOG_LEVEL=INFO
MCP_TRANSPORT=http                      # "http" (default) or "stdio" (python -m app)
MCP_PORT=8027                           # internal uvicorn port (transport=http); must match Dockerfile EXPOSE/HEALTHCHECK
MCP_TIMEOUT_DEFAULT=30.0                # default timeout (s) for calls to Module 13
MCP_TIMEOUT_UPLOAD=120.0                # timeout (s) for file-upload calls to Module 13
MCP_MAX_ATTEMPTS=3                      # 1 initial + (n-1) retries on 5xx/network errors
MCP_RETRY_BACKOFF_SECONDS=1.0
MCP_TOKEN_TTL_SECONDS=1800              # server service-account token cache (30 min)
MCP_AGENT_TOKEN_TTL_SECONDS=86400       # agent_token lifetime / idle-refresh window (24h) — also returned as expires_in by POST /mcp/auth/register
MCP_REFRESH_MARGIN_SECONDS=60           # refresh a cached token when < this many seconds remain
MCP_TIMEOUT_A2A=120.0                   # timeout (s) for A2A tool calls (raptor_a2a_*, raptor_query_orchestrate)
MCP_TIMEOUT_RESOURCE_LIST=15.0          # timeout (s) for short resource reads
MCP_COOCCUR_LIMIT=20                    # max co-occurring entities returned by graph tools
MCP_MAX_UPLOAD_BYTES=52428800           # 50 MB asset upload limit
MCP_STDIO_LOG_PATH=/tmp/raptor-mcp-stdio.log   # transport=stdio only (stdout is reserved for the MCP protocol)
# Required for POST /mcp/auth/register (encrypts the agent's client_secret before it's written to Redis).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRET_ENCRYPTION_KEY=<generate-a-fernet-key>
# Default-deny allowlist for POST /auth/register — empty disables agent
# registration entirely. Only add a client_id here for a genuinely
# autonomous, unattended integration (client_credentials has no per-user
# identity — see 27-mcp-server/.env.example for why). Comma-separated.
MCP_AGENT_ALLOWED_CLIENT_IDS=

# ==================== 33-privacy-compliance-service (GD-1 / VIE01-246) ====================
# Shared secret Module 13 presents to Module 33, and Module 33 in turn
# presents to modules 04/25/26's own /internal/gdpr/user/{user_id}
# endpoints — the same value everywhere. Never a JWT; these are
# service-to-service calls with no end-user session behind them.
GD_INTERNAL_TOKEN=<generate_a_long_random_token>
# DPO notified here on PARTIAL_FAILURE (uses this file's existing SMTP_* settings above).
GD_DPO_EMAIL=
GD_CONTROLLER_NAME=<your_organisation_legal_name>
GD_ERASURE_TIMEOUT_SECONDS=300
GD_ERASURE_MAX_ATTEMPTS=3
GD_ERASURE_RETRY_DELAY_SECONDS=60

# ---- GD-2 / VIE01-247 (data portability export) ----
# Export ZIPs go to their own SeaweedFS bucket, not module 04's `lakefs`
# bucket -- see 33-privacy-compliance-service/app/core/config.py's comment
# on why. Reuses this file's existing S3_ENDPOINT/S3_PUBLIC_URL/
# AWS_ACCESS_KEY/AWS_SECRET_KEY (module 04's own SeaweedFS credentials).
GD_S3_EXPORT_BUCKET=raptor-gdpr-exports
GD_EXPORT_TTL_HOURS=72
GD_EXPORT_MAX_ZIP_BYTES=524288000
GD_EXPORT_CLEANUP_INTERVAL_SECONDS=3600

# ---- GD-3 / VIE01-248 (data retention policy engine) ----
# Daily enforcement run time (UTC). Ticket's own spec is 02:00 UTC.
GD_RETENTION_HOUR_UTC=2
GD_RETENTION_MINUTE_UTC=0
# Applied to the audio/image/video/document-processing-requests Kafka
# topics' retention.ms on startup, idempotently. 0/unset = leave Kafka
# topic config alone entirely (default -- most deployments manage Kafka
# retention out of band). Example: 30 days = 2592000000.
GD_KAFKA_RETENTION_MS=0
# Loki (Module 14) has NO equivalent auto-applied setting -- retention there
# is the operator's own responsibility, configured directly in
# 14-monitoring/config/loki/loki-config.yaml (see that module's README for
# the exact compactor/retention_period block to add). This var exists only
# as the documented default the ticket asks for; nothing in this codebase
# reads it automatically.
GD_LOKI_RETENTION_PERIOD=720h

# ---- GD-4 / VIE01-249 (data subject access request) ----
# Accounts with more indexed items (every Module 25 chunk + entity, not
# the DSAR's document count) than this get an async job instead of a
# synchronous report.
GD_DSAR_ASYNC_THRESHOLD=10000
# Synchronous assembly budget -- kept under Module 13's own 10s
# GATEWAY request_timeout; an overrunning DSAR is handed off to a job.
GD_DSAR_SYNC_TIMEOUT_SECONDS=8
# A completed async DSAR job's stored report is cleared after this.
GD_DSAR_RESULT_TTL_HOURS=72

# ---- V05-10 / VIE01-364 (CF-4 audit events) ----
# How long Module 33's audit events (one per finished erasure job) are kept.
GD_AUDIT_RETENTION_DAYS=1095

# ---- CM-7 / VIE01-410 (compliance audit report) ----
# Event rows per section of GET /compliance/report (the counts always cover
# the whole period; a section with more rows says truncated: true).
GD_COMPLIANCE_REPORT_MAX_ROWS=50000

# ============================================================
# 29 — doc-processing-agent (DocAgent, DA-09a)
# config.py 使用 env_prefix="DA_"
# ============================================================
DA_MODULE12_SYNC_URL=http://raptor-document-analysis:8020
DA_MODULE07_URL=http://raptor-ai-lifecycle-api:8010
DA_AI_LIFECYCLE_URL=http://raptor-ai-lifecycle-api:8010
DA_QDRANT_URL=http://raptor-qdrant:6333
DA_QDRANT_DOC_COLLECTION=doc_agent_embeddings
DA_QDRANT_VECTOR_SIZE=1024
DA_EMBED_MODEL=bge-m3
DA_LLM_MODEL=${LLM_MODEL}
DA_LLM_TIMEOUT=60.0
DA_DOC12_TIMEOUT=120.0
DA_EMBED_TIMEOUT=30.0
DA_LOG_LEVEL=INFO
DA_MAX_CONCURRENT_REQUESTS=10

# ============================================================
# 34 — realtime-audio（WebSocket 音訊串流 + silero-VAD 語句切分）
# ============================================================
# 映像以 module 08 的同版本映像為底；只有舊 tag 的主機可覆寫這裡
RT_BASE_IMAGE=raptor/media-worker:${RAPTOR_VERSION}
# POST /audio/session/token 的 Bearer JWT 以 KEYCLOAK_URL 的 realm JWKS 驗證；
# 不接 Keycloak 時可改填 PEM 公鑰（換行寫成 \n）
RT_JWT_PUBLIC_KEY=
RT_JWT_AUDIENCE=
RT_TICKET_TTL_S=30                      # WS 一次性票證有效秒數
RT_SESSION_TTL_S=1800                   # 單一工作階段最長存活秒數（Redis rt:session:* TTL）
RT_MAX_SESSIONS=20                      # 全服務（共用 Redis 的所有 34 instance）並行上限；超過回 503
RT_MAX_SESSIONS_PER_USER=3              # 同一個使用者（JWT sub）並行上限；超過回 503 too_many_sessions_for_user
RT_CONFIG_TIMEOUT_S=10                  # Upgrade 後等待 CONFIG frame 的秒數
RT_HEARTBEAT_S=10                       # 名額心跳間隔秒數（rt:sessions:active 過期回收用）
# RTA-X4 有界佇列：音訊佇列滿時丟最舊的一塊（QUEUE_OVERFLOW），STT 佇列滿時丟新語句（STT_OVERLOADED）
RT_AUDIO_QUEUE_MAX=200                  # 每個工作階段的音訊佇列上限（200 塊 x 30ms ≈ 6s）
RT_STT_QUEUE_MAX=10                     # 每個工作階段等待最終辨識的語句數（舊名 RT_UTTERANCE_QUEUE_MAX）
# RTA-X5 插話：回答播放中語音機率 > 門檻且持續 RT_BARGE_IN_MIN_MS 即中斷回答；無回音消除的環境建議 0.85
RT_BARGE_IN_THRESHOLD=0.7
RT_BARGE_IN_MIN_MS=300
RT_MIN_UTTERANCE_CHARS=2                # 最終逐字稿至少幾個字才開始一輪對話
# RTA-X3 斷線續傳與心跳
RT_SESSION_RESUME_WINDOW_S=60           # 斷線後保留工作階段等待 RESUME 的秒數；0 = 斷線即結束
RT_RESUME_BUFFER_KB=1024                # 每個工作階段保留供重送的已送出 frame
RT_PING_INTERVAL_S=30                   # 伺服器送 PING 的間隔；0 = 不送
RT_PONG_TIMEOUT_S=10                    # 客戶端須在此秒數內回 PONG
# 回答音訊依播放速度送出，最多領先客戶端播放位置 RT_OUTPUT_LEAD_MS；未送出的音訊超過 RT_OUTPUT_QUEUE_MS 時暫停合成
RT_OUTPUT_PACE=true
RT_OUTPUT_LEAD_MS=500
RT_OUTPUT_QUEUE_MS=10000
RT_OUTPUT_STALL_S=10                    # 連線中的客戶端這麼久都沒讀走輸出 = 卡住（QUEUE_OVERFLOW）；暫停等續傳時不計
RT_VAD_CHUNK_MS=30                      # 音訊切塊（傳給 VAD 的單位）；模型推論窗固定 32 ms
RT_VAD_THRESHOLD=0.5
RT_VAD_MIN_SILENCE_MS=300
RT_VAD_MIN_SPEECH_MS=200
RT_MAX_UTTERANCE_S=10
RT_VAD_SPEECH_PAD_MS=96                 # 語句前後保留的音訊
RT_VAD_POOL_SIZE=4                      # 啟動時預載的 silero 實例數
RT_CODEC_RESAMPLE=true                  # RA-8：false = 只接受 16 kHz PCM（不重取樣、不收 Opus / G.711）
# RA-3 / RTA-X2 語音辨識（faster-whisper，CTranslate2）
RT_STT_ENABLED=true                     # false = 只做 VAD 斷句
RT_STT_MODEL=large-v3                   # 大小名稱，或 RT_STT_MODEL_DIR 下的目錄名（faster-whisper-large-v3）
# 主機上放 CTranslate2 Whisper 轉檔的目錄（唯讀掛到 /models/stt）；空 = 用 HF cache
RT_STT_MODEL_DIR=
# 說話中暫定辨識用的模型；空 = 與 RT_STT_MODEL 相同
RT_STT_PROVISIONAL_MODEL=
RT_STT_DEVICE=auto                      # auto：有 GPU 用 cuda float16，沒有則改用 RT_STT_CPU_MODEL（int8）
RT_STT_COMPUTE_TYPE=
RT_STT_CPU_MODEL=tiny
RT_STT_LANGUAGE=zh-TW                   # CONFIG 未帶 language 時的預設；auto = 自動偵測
RT_STT_BEAM_SIZE=5
RT_STT_MAX_CONCURRENT=1                 # 同時在 GPU 上解碼的數量（說話中的暫定辨識在滿載時略過）
RT_STT_ZH_CONVERT=s2tw                  # OpenCC；Whisper 中文輸出簡體，zh-TW 工作階段轉台灣繁體字（s2twp 會連用詞一起換，如 数据→資料）；空 = 不轉
RT_STT_STREAMING=true                   # 說話中送 TRANSCRIPT_PROVISIONAL / STABLE（RTA-X2）
RT_STT_STRIDE_S=0.5                     # 暫定辨識間隔（音訊時間）
RT_STT_FIRST_DECODE_MS=300              # 語音開始後多久做第一次暫定辨識
RT_HF_HUB_OFFLINE=0                     # 1 = 不從 Hugging Face 下載模型
# RA-4 語音合成（可插拔後端：kokoro-82m／breeze-tts-2）
RT_TTS_ENABLED=true
RT_TTS_MODEL=kokoro-82m                 # 未知名稱會在啟動時報錯並列出可用後端
# 後端的聲音 ID；空或無效 = 後端預設（Kokoro zf_001）
RT_TTS_VOICE=
RT_TTS_SPEED=1.0
RT_TTS_DEVICE=auto
RT_TTS_MAX_CONCURRENT=2
RT_TTS_QUEUE_MAX=5                      # 每個工作階段等待合成的回答句數（RTA-X4）
RT_TTS_SILENCE_PAD_MS=200               # 每段回覆結尾補的靜音
# Breeze TTS 2：權重與輸出僅限研究／非商業用途，需明確設 true 才會使用（並以 --profile breeze 啟動伺服器）
RT_TTS_BREEZE_ENABLED=false
RT_TTS_BREEZE_URL=http://raptor-breeze-tts:7860
# 聲音預設（JSON）；空 = 內建 zh-female／zh-male／en-female 三組 voice-design 描述
RT_TTS_BREEZE_VOICES=
# 主機上 BreezeBlue/Breeze-TTS-2 的快照目錄，唯讀掛到 Breeze 伺服器
RT_TTS_BREEZE_MODEL_DIR=
# RA-5 語音對話輪次（Module 15）
RT_LLM_ENABLED=true
# Module 15 的 API 前綴；橋接器呼叫 {此值}/chat
RT_CHAT_SERVICE_URL=http://raptor-chat-service:8021/api/v1
RT_CHAT_STREAM=true                     # 以 SSE 接收 Module 15 回答；false = 一般 JSON
RT_LLM_TIMEOUT_S=30
RT_LLM_FIRST_TOKEN_TIMEOUT_S=30         # 第一段回答文字的期限（RTA-X4；backlog 寫 10，Module 15 目前多在 8-29 秒才回第一句）
# Module 15 逾時／無法連線時播報的語句；空 = 「系統暫時無法回應，請稍後再試。」
RT_LLM_FALLBACK_TEXT=
# RTA-X6 護欄：TRANSCRIPT_FINAL 送 Module 15 前、每句回答合成前都經 Module 23 /guardrail/policy/decide
RT_GUARDRAIL_ENABLED=true
RT_GUARDRAIL_URL=http://raptor-guardrail-service:8026
RT_GUARDRAIL_OUTPUT=true                # 回答逐句檢查
RT_GUARDRAIL_FAIL_OPEN=true             # Module 23 無法連線時放行（記 log）；false = 視同 block
# 被擋時念的語句；空 = 「抱歉，這個問題我無法協助處理。」
RT_GUARDRAIL_BLOCK_TEXT=
# RTA-X9 外部大腦（brain=external，需 realm role rt-external-brain）的 Module 23 檢查：off / input / output / both
RT_EXTERNAL_GUARDRAIL=output
# RTA-X6 逐字稿寫入 Module 25 個人索引（Kafka personal-index-requests，使用上面的 KAFKA_BOOTSTRAP_SERVERS）
RT_INDEX_TRANSCRIPTS=true
# Module 26 對話記憶：Module 15 已自行寫入，只有外部大腦的輪次由 34 寫入
RT_MEMORY_ENABLED=true
RT_MEMORY_SERVICE_URL=http://raptor-memory-service:8026
# RTA-X7 / RA-9 錄音：需同時 RT_RECORDING_ENABLED=true 且使用者同意 voice_recording（Module 33）才錄
RT_RECORDING_ENABLED=false
RT_RECORDING_CHUNK_S=10                 # 每幾秒把音訊上傳到 SeaweedFS 一次（34 重啟不會遺失）
RT_RECORDING_RETENTION_DAYS=90          # expires_at = created_at + 此天數
# SeaweedFS collection；空 = 預設（不另建 volume）
RT_RECORDING_COLLECTION=
RT_MODULE33_URL=http://raptor-privacy-compliance-service:8033
RT_SEAWEEDFS_MASTER=http://raptor-seaweedfs-master1:9333
RT_POSTGRES_DB=realtime_audio           # rt_audio_recordings 所在資料庫（03-database/init/postgresql/009_realtime_audio.sql）
# Module 34 benchmark/capacity runner, not an implemented telephony endpoint.
RT_TARGET_CONCURRENT_CALLS=20

# ============================================================
# 35 — inference-service（LLM 任務 API：翻譯／摘要／補全／改寫，經 07 推論）
# ============================================================
# 模型清單與推論都經 07 API；Ollama 直連只用於 07 無法連線時的模型發現降級
INF_MODULE07_API_URL=${INFERENCE_URL}
INF_MODULE07_OLLAMA_HOST=${OLLAMA_HOST}
INF_MODULE07_TIMEOUT_S=120              # 單次推論等待 07 的上限（秒）；逾時回 504
INF_MODULE07_REGISTRY_TIMEOUT_S=5       # GET /models（MLflow/Ollama 清單）等待 07 的上限（秒）
INF_MODEL_CACHE_TTL_S=60                # GET /models 聚合結果的記憶體快取（秒）
# 各任務出廠預設模型（POST /models/default 寫入 Redis 後以 Redis 為準）；
# 名稱須出現在 GET /models（MLflow production/staging 註冊名或 Ollama tag）
INF_DEFAULT_TEXT_MODEL=${LLM_MODEL}
INF_DEFAULT_STT_MODEL=
INF_DEFAULT_TTS_MODEL=
INF_DEFAULT_CLONE_MODEL=
INF_DEFAULT_DIARIZE_MODEL=

# Module 13 authenticated gateway and Module 35 guardrail (VIE01-315)
GATEWAY_INFERENCE_SERVICE_URL=http://raptor-inference-service:8035
INF_TRANSLATE_SYSTEM_PROMPT=
INF_SUMMARIZE_SYSTEM_PROMPT=
INF_SUMMARIZE_CHUNK_CHARS=12000         # 摘要長文分段的每段字數上限
INF_SUMMARIZE_MAX_CHUNKS=8              # 摘要長文允許分出的最多段數；超過回 413
INF_TRANSFORM_SYSTEM_PROMPT=
INF_GUARDRAIL_ENABLED=false
INF_GUARDRAIL_CHECK_OUTPUT=false
INF_MODULE23_URL=http://raptor-guardrail-service:8026
# GD-11: /voice/clone asks Module 33 for the caller's voice_clone consent
INF_MODULE33_URL=http://raptor-privacy-compliance-service:8033
# INF-10/11: /inference/voice/stt and /tts forward to Module 34's already-loaded
# Whisper/TTS models instead of loading a second copy here (VIE01-316/317).
INF_MODULE34_API_URL=http://raptor-realtime-audio:8034
INF_MODULE34_TIMEOUT_S=60
INF_GUARDRAIL_TIMEOUT_S=20
INF_GUARDRAIL_INPUT_PATH=/guardrail/policy/decide
INF_GUARDRAIL_OUTPUT_PATH=/guardrail/policy/decide
# VIE01-419 / INF-20: XTTS-v2 weights are Coqui Public Model License
# (non-commercial) -- /voice/clone stays off even on the voice profile
# until this is explicitly set.
INF_CLONE_ENABLED=false
# Comma list, subset of: xtts-v2, chatterbox-multilingual-v3. Must be a
# subset of INF_CLONE_BACKENDS_BUILD below (what actually got baked in) -- if
# unset, defaults to that same value, so the common case (enable everything
# baked) needs only INF_CLONE_BACKENDS_BUILD set. Override here only to
# enable a subset of a build that baked in more.
INF_CLONE_BACKENDS_RUNTIME=xtts-v2
# Comma list: eagerly load these at startup instead of on first request.
# Default empty -- every configured backend loads lazily, on first use.
INF_CLONE_BACKENDS_WARM=
INF_SPEAKER_CACHE_TTL_S=86400
INF_SPEAKER_CACHE_MAX=100
# build.py reads this (not INF_-prefixed: it also picks which docker-compose.yml
# profile --build/--status/--delete operate on, same name as the container's
# own VOICE_ENABLED so one flag means one thing end to end).
VOICE_ENABLED=true
INF_VOICE_BASE_IMAGE=raptor/media-worker:${RAPTOR_VERSION:-0.5}
# Build-time only: which clone backends' weights/deps get baked into the voice
# image. Chatterbox Multilingual V3 is MIT-licensed (no non-commercial
# restriction, unlike XTTS-v2 below).
INF_CLONE_BACKENDS_BUILD=xtts-v2
# Empty (default): download with HUGGINGFACE_TOKEN at build time, nothing to
# mount at runtime (the image already has the baked-in models). Set it to a
# pre-exported, offline NAS bundle's directory (scripts/prefetch_voice.py
# --nas-root) to skip the build-time download and mount that bundle instead --
# one variable decides both.
INF_VOICE_BUNDLE_DIR=
HUGGINGFACE_TOKEN=${HF_TOKEN}

# ============================================================
# 36 — grpc-gateway
# config.py 使用 env_prefix="GRPC_GATEWAY_"，以下透過變數插值對應共用設定
# （compose 的 env_file 會讀取此檔，覆蓋 36-grpc-gateway/.env 的預設值）
# ============================================================
GRPC_GATEWAY_REDIS_HOST=${REDIS_HOST}
GRPC_GATEWAY_REDIS_PORT=${REDIS_PORT}
GRPC_GATEWAY_REDIS_PASSWORD=${REDIS_PASSWORD}
GRPC_GATEWAY_REDIS_DB=${REDIS_DB}
GRPC_GATEWAY_KAFKA_BOOTSTRAP_SERVERS=${KAFKA_BOOTSTRAP_SERVERS}
GRPC_GATEWAY_PERSONAL_DB_URL=${PERSONAL_DB_SERVICE_URL}
GRPC_GATEWAY_ASSET_MANAGEMENT_URL=${ASSET_MANAGEMENT_URL}
# VIE01-383: Bearer-token verification (IdentityInterceptor fetches JWKS from this realm)
GRPC_GATEWAY_KEYCLOAK_URL=${KEYCLOAK_URL}
GRPC_GATEWAY_JWT_EXPECTED_REALM=dhtsolution
# DEV ONLY, never true in production -- see 36-grpc-gateway/config.py
GRPC_GATEWAY_ALLOW_INSECURE_DEV_FALLBACK=false
GRPC_GATEWAY_AUTH_SERVICE_URL=${GATEWAY_AUTH_SERVICE_URL}
# GB-20: with GRPC_GATEWAY_GUARDRAIL_ENABLED=true, the user text of Search/SearchBm25/
# SearchVector/SearchByPerson/StreamSearchByPerson/Chat is checked by module 23
# before the RPC runs (block -> PERMISSION_DENIED, redact -> field replaced).
# Fail-open: no answer within GRPC_GATEWAY_GUARDRAIL_TIMEOUT_MS -> the call
# proceeds unscreened. GR_GRPC_GUARDRAIL_ENABLED / GR_GRPC_GUARDRAIL_URL /
# GR_GRPC_TIMEOUT_MS are accepted as aliases.
# GB-22: grpc_interceptor is registered as screened in module 23's coverage
# matrix only while screening is on. This section is defined after module 23's
# own, so ${GUARDRAIL_URL} is set.
GRPC_GATEWAY_GUARDRAIL_ENABLED=false
GRPC_GATEWAY_GUARDRAIL_URL=${GUARDRAIL_URL}
GRPC_GATEWAY_GUARDRAIL_TIMEOUT_MS=2000
