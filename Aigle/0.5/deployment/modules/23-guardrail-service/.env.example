OLLAMA_URL=http://<your_ollama_host_ip>:11434
GUARDRAIL_REQUEST_TIMEOUT=120.0
LOG_LEVEL=INFO
TIMEZONE=Asia/Taipei
PORT_GUARDRAIL_SERVICE=8023
DOCKER_NETWORK=raptor

# Proxy + confidence-based classifier
PROXY_MODEL=llama-guard3:8b
PROXY_MODE=enforce
PROXY_CONFIDENCE_THRESHOLD=0.7
DEFAULT_MODEL=llama-guard3:8b

# OpenAI-compatible guardrail proxy (/v1/chat/completions, /v1/models):
# checked requests are forwarded to this upstream. Module 07 by default, not
# Ollama -- callers (module 15) send engine/num_ctx/think, which only module 07
# honours.
PROXY_UPSTREAM_URL=http://raptor-ai-lifecycle-api:8010
PROXY_UPSTREAM_TIMEOUT=120.0

# Guard models: Llama-Guard3 / Granite / GPT-OSS
GUARD_MODEL=llama-guard3:8b
GUARD_MODEL_2=granite4.1-guardian:8b
GUARD_MODEL_3=gpt-oss-safeguard:20b

# How disagreeing multi-guard-model verdicts are resolved: strict (any model
# unsafe -> unsafe) | majority (a strict majority must say unsafe) | permissive
# (every model must say unsafe). Optional — defaults to "strict" (the
# pre-existing behavior) when unset.
GUARD_CONFLICT_STRATEGY=strict

# Policy storage + active-policy cache: shares module 03's PostgreSQL
# (database "guardrails", created by 03-database/init/postgresql/001_init.sql)
# and module 02's shared Redis (DB 0). Uses the platform-wide POSTGRES_*/
# REDIS_* vars from the unified .env file directly -- no module-specific
# override needed here; see docker-compose.yml.

# Guardrail global switch (cold-start default for guardrail:enabled in Redis)
GR_DEFAULT_ENABLED=true

# Audit (CF-4 audit_events, GRD-X4): how many days each guardrail audit event
# is kept (its retention_days). Optional -- defaults to 90.
GUARDRAIL_AUDIT_RETENTION_DAYS=90

# CM-5 (VIE01-408): automated flagging system. KAFKA_BOOTSTRAP resolves from
# root .env's KAFKA_BOOTSTRAP_SERVERS via docker-compose.yml; both optional.
# KAFKA_BOOTSTRAP=kafka-broker1:9092,kafka-broker2:9092,kafka-broker3:9092
# KAFKA_MODERATION_TOPIC=moderation.flagged

# Image guard models: Llama Guard 3 11B Vision + Google ShieldGemma 2
# Both are gated models — request access at huggingface.co then set HF_TOKEN.
# Weights are downloaded on first run and cached at HF_CACHE_PATH.
HF_TOKEN=<your_huggingface_token>
HF_CACHE_PATH=~/.cache/huggingface
LLAMA_GUARD_3_MODEL_PATH=meta-llama/Llama-Guard-3-11B-Vision
SHIELDGEMMA2_MODEL_PATH=google/shieldgemma-2-4b-it

# GPU to assign for image guard inference.
# IMPORTANT: If other services are already using GPU 0, set this to a free GPU
# (e.g. GUARDRAIL_GPU_ID=1). Check with: nvidia-smi --query-compute-apps=pid,gpu_uuid,used_memory --format=csv
GUARDRAIL_GPU_ID=0

# Quantization settings for image guard models
# Llama Guard 3 11B Vision: bfloat16 ≈ 22 GB — must use 4-bit on any ≤24 GB GPU
LLAMA_GUARD_LOAD_IN_4BIT=true
# ShieldGemma 2 4B: 8-bit (≈ 4.8 GB measured) by default; false = bfloat16 (≈ 8.2 GB).
SHIELDGEMMA2_LOAD_IN_8BIT=true

# Dynamic model resource manager (app/services/model_resource_manager.py).
# Free VRAM / RAM is probed live before each load; if the target model does not
# fit, idle image-guard models are unloaded first, else the request gets 503.
# All optional — defaults shown.
# GUARDRAIL_CUDA_DEVICE=0               # index among the GPUs visible in the container
# GUARDRAIL_ALLOW_MODEL_COEXIST=true    # keep both models resident when they fit
# GUARDRAIL_VRAM_SAFETY_MARGIN_MB=256   # extra headroom on top of each estimate
# GUARDRAIL_MODEL_ACQUIRE_TIMEOUT_S=300 # max wait for the GPU before 503
# Per-model estimates (MB) used before the first load measures the real footprint:
# LLAMA_GUARD_VRAM_ESTIMATE_MB=7000     # 21500 when LLAMA_GUARD_LOAD_IN_4BIT=false
# LLAMA_GUARD_INFERENCE_RESERVE_MB=1024
# LLAMA_GUARD_RAM_ESTIMATE_MB=4096
# SHIELDGEMMA2_VRAM_ESTIMATE_MB=4900    # 8300 when SHIELDGEMMA2_LOAD_IN_8BIT=false
# SHIELDGEMMA2_INFERENCE_RESERVE_MB=1536
# SHIELDGEMMA2_RAM_ESTIMATE_MB=4096
