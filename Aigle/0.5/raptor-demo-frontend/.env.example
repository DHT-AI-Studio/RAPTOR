# ── Docker 部署用 ──────────────────────────────────────────────────────────────
# Raptor Gateway 的 IP:Port（nginx 在容器內 proxy /api/* 到此位址）
API_TARGET=http://<host_ip>:8012

# Demo 前端對外 port（預設 3000）
DEMO_PORT=3000

# transcode sidecar 是否嘗試 GPU 編碼（預設 true；沒有 GPU/NVENC 時會自動偵測並退回 CPU）
TRANSCODE_GPU_ENABLE=true

# ── 本機開發用 (npm run dev) ────────────────────────────────────────────────────
# Vite dev server proxy 目標（與 API_TARGET 填同樣值）
VITE_API_TARGET=http://<host_ip>:8012

# API 版本預設從 gateway 的 /health 動態偵測，不需要手動填。只有在 /health 連不到時
# 才會用這個值當 fallback；留空的話連不到就直接噴錯，不會悄悄猜一個版本號。
# VITE_FALLBACK_API_VERSION=0.5
