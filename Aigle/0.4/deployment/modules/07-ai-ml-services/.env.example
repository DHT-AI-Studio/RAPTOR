# ========================================
# AI Model Lifecycle Management Platform
# Environment Configuration File
# Version: 2.0.0
# ========================================

# ========================================
# 資料庫配置 (Database Configuration)
# ========================================

# PostgreSQL - 連接 03-database 共用 raptor-postgres
POSTGRES_HOST=raptor-postgres
POSTGRES_PORT=5432
POSTGRES_USER=raptor
POSTGRES_PASSWORD=raptor
POSTGRES_DB=mlflow
# ========================================
# LakeFS / S3 儲存配置
# ========================================

# LakeFS S3-Compatible Gateway Configuration
# Leave empty if not using LakeFS
MLFLOW_S3_ENDPOINT_URL=http://lakefs:8000
AWS_ACCESS_KEY_ID=YOUR_LAKEFS_ACCESS_KEY      # lakeFS access key
AWS_SECRET_ACCESS_KEY=YOUR_LAKEFS_SECRET_KEY      # lakeFS secret key

#NFS server
NFS_SERVER=YOUR_NFS_SERVER_IP
PORT_NFS=2049
NFS_AIML_TMP_PATH=/aiml/tmp
NFS_AIML_DATA_PATH=/aiml/data
# ========================================
# MLflow 配置 (MLflow Configuration)
# ========================================

# MLflow 服務器配置
# Use service name for Docker Compose networking
MLFLOW_TRACKING_URI=http://mlflow:5555
MLFLOW_HOST=0.0.0.0
PORT_MLFLOW=5555

# MLflow version (e.g., v3.3.0)
MLFLOW_VERSION=v3.3.2

# MLflow 後端存儲配置
# MLflow Server
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# MLflow Artifact 存儲配置
#MLFLOW_DEFAULT_ARTIFACT_ROOT=s3://lakefs

# ========================================
# 外部服務配置 (External Services)
# ========================================

# Hugging Face Token - 用於下載模型
# Leave empty if not using Hugging Face
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN


# Ollama API 配置
# 開發環境：使用主機 IP
# Replace with your actual Ollama host IP or use host.docker.internal
OLLAMA_API_BASE=YOUR_OLLAMA_API_BASE

# 生產環境（Docker 內部訪問）：使用 host.docker.internal
# OLLAMA_API_BASE=http://host.docker.internal:11434

# ========================================
# FastAPI 應用配置 (FastAPI Configuration)
# ========================================

# 基本服務配置
AI_LIFECYCLE_API_HOST=0.0.0.0
PORT_AI_LIFECYCLE_API=8010

REDIS_PASSWORD=your-redis-password
