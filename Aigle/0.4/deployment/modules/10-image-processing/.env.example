# ============================================================
# 10-image-processing environment
# ============================================================

# ── Kafka ────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka-broker1:9092,kafka-broker2:9092,kafka-broker3:9092
# KAFKA_BOOTSTRAP_SERVERS=<your_host_ip>:19092,<your_host_ip>:19093,<your_host_ip>:19094

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>

# ── Hybrid Search Ingest API ──────────────────────────────────
HYBRID_SEARCH_INGEST_URL=http://raptor-hybridsearch-api:8000/api/v1/ingest/file
ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000

# ── HuggingFace (InternVL download on first run ~8GB) ────────
HF_TOKEN=<your_huggingface_token>

# ── VLM model ────────────────────────────────────────────────
VLM_MODEL_PATH=OpenGVLab/InternVL3_5-1B
MAX_MEMORY_PER_GPU=36GiB

# ── GPU allocation ────────────────────────────────────────────
IMAGE_PROCESSING_GPU=0
IMAGE_PROCESSING_GPU_COUNT=1
IMAGE_PROCESSING_MEMORY_LIMIT=20g
IMAGE_PROCESSING_CPU_LIMIT=4

# ── Sync API Port ────────────────────────────────────────────
PORT_IMAGE_SYNC_API=8018

# ── CPU-only services ─────────────────────────────────────────
IMAGE_ORCHESTRATOR_MEMORY_LIMIT=2g
IMAGE_ORCHESTRATOR_CPU_LIMIT=1
IMAGE_INDEXER_MEMORY_LIMIT=2g
IMAGE_INDEXER_CPU_LIMIT=1

# ── Timezone ─────────────────────────────────────────────────
TIMEZONE=Asia/Taipei
HF_CACHE_PATH=/path/to/huggingface/cache

# NFS shared media storage
NFS_SERVER=<your_nfs_server_ip>
PORT_NFS=2049
NFS_MEDIA_TMP_PATH=/media/processing
