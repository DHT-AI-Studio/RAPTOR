# ── 22 Benchmark Service ─────────────────────────────────────────
# Benchmark-specific settings use the BM_ prefix. Shared infra
# credentials (POSTGRES_*, REDIS_*) are inherited from ../.env.

BM_LOG_LEVEL=INFO

# PostgreSQL database dedicated to the benchmark service (created in
# 03-database/init/postgresql/001_init.sql). Host/user/password are
# inherited from the shared ../.env (POSTGRES_HOST, POSTGRES_USER, ...).
BM_POSTGRES_DB=benchmark

# Redis live-run state
BM_REDIS_RUN_TTL_SECONDS=604800   # 7 days

# LLM-as-judge / embeddings (Module 07 AI Lifecycle API)
BM_INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
BM_JUDGE_MODEL=qwen3.5:9b
BM_JUDGE_ENGINE=ollama
BM_JUDGE_THINK=false
BM_INFERENCE_TIMEOUT=30           # alias: BM_JUDGE_TIMEOUT_S

# Embeddings for the cosine_similarity scorer — via Module 07's `embedding` task.
# The model must be registered in Module 07 first, e.g.
#   POST /models/register_ollama {"model_name": "bge-m3", "task": "embedding"}
BM_EMBED_MODEL=bge-m3
BM_EMBED_TIMEOUT=30

# Downstream pipeline executor timeout (seconds)
BM_PIPELINE_TIMEOUT=30

# Internal pipeline URLs (no auth overhead — called service-to-service)
BM_CHAT_URL=http://raptor-chat-service:8021
BM_SEARCH_URL=http://raptor-personal-db-service:8000
BM_RAG_URL=http://raptor-agent-protocol:8030
BM_CLASSIFY_URL=http://raptor-query-orchestrator:8000

# NFS: mount the shared AI-ML tmp (same server as Modules 07/16) read-only so the
# planner can peek a few real dataset rows. Needed at compose parse time for the
# `tmp` volume's driver_opts interpolation.
NFS_SERVER=YOUR_NFS_SERVER_IP
PORT_NFS=2050
NFS_AIML_TMP_PATH=/aiml/tmp
