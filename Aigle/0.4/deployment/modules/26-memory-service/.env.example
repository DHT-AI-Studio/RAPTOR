# ==========================================
# Memory Service (Module 26)
# 以下變數同步自全域 modules/.env
# 透過 build.py 部署時由全域 .env 提供；
# 直接 docker compose up 時從本檔讀取。
# ==========================================

# ── 共用基礎設施（全域已定義，保持一致）──────────────────────
DOCKER_NETWORK=raptor0.4
NFS_SERVER=<your_nfs_server_ip>
PORT_NFS=2049
NFS_MEMVID_PATH=/memvid/storage
PORT_MEMORY_SERVICE=8026

# ── Ollama（透過 Module 07 代理呼叫，非直連）────────────────────
MEM_EMBEDDING_MODEL=BAAI/bge-m3
MEM_EXTRACTION_MODEL=qwen2.5:7b         # preference/entity/fact extraction + compact_session summarization
MEM_INFERENCE_THINK=false

# ── GPU / HuggingFace cache — bge-m3 embedder loads here in-process
#    (memvid_store.py's SentenceTransformer) ───────────────────
HF_CACHE_PATH=/path/to/huggingface/cache
MEMORY_SERVICE_GPU=0

# ── Module 26 專屬設定──────────────────────────────────────────
MEM_STORAGE_ROOT=/mnt/memvid-storage

# ── 記憶壓縮 MV-12（省略則用 core/config.py 的預設值）──────────
MEM_COMPACT_BUFFER_TOKENS=13000
MEM_COMPACT_RESERVED_OUTPUT_TOKENS=20000
MEM_COMPACT_MIN_TAIL_TOKENS=10000
MEM_COMPACT_MIN_TEXT_MESSAGES=5
MEM_COMPACT_MAX_TAIL_TOKENS=40000
MEM_COMPACT_SUMMARY_MAX_TOKENS=12000
MEM_COMPACT_MAX_SECTION_TOKENS=2000
MEM_COMPACT_LLM_TIMEOUT_SECONDS=120.0
MEM_COMPACT_KEEP_TURNS=10
MEM_COMPACT_TOOL_RESULT_RETENTION_HOURS=24.0

# ── Redis（與全域 REDIS_* 一致）───────────────────────────────
MEM_REDIS_HOST=raptor-redis-standalone
MEM_REDIS_PORT=6379
MEM_REDIS_PASSWORD=<your_redis_password>
