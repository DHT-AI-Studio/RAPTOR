OLLAMA_URL=http://<your_ollama_host_ip>:11434
GUARDRAIL_REQUEST_TIMEOUT=120.0
LOG_LEVEL=INFO
TIMEZONE=Asia/Taipei
PORT_GUARDRAIL_SERVICE=8023
DOCKER_NETWORK=raptor

# Proxy + confidence-based classifier
PROXY_MODEL=llama-guard3:8b
PROXY_MODE=enforce
PROXY_CONFIDENCE_THRESHOLD=0.7
DEFAULT_MODEL=llama-guard3:8b

# Guard models: Llama-Guard3 / Granite / GPT-OSS
GUARD_MODEL=llama-guard3:8b
GUARD_MODEL_2=granite4.1-guardian:8b
GUARD_MODEL_3=gpt-oss-safeguard:20b

# Policy storage + active-policy cache: shares module 03's PostgreSQL
# (database "guardrails", created by 03-database/init/postgresql/001_init.sql)
# and module 02's shared Redis (DB 0). Uses the platform-wide POSTGRES_*/
# REDIS_* vars from the unified .env file directly -- no module-specific
# override needed here; see docker-compose.yml.

# Guardrail global switch (cold-start default for guardrail:enabled in Redis)
GR_DEFAULT_ENABLED=true
