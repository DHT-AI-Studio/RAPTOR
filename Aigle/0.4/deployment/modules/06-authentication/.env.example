TIMEZONE=Asia/Taipei

# ==================== API 版本（與其他 module 共用，見 root .env.example 的 API_VERSION）====================
# 只有在「單獨部署 module 06、沒有 root 的統一 .env」時才會用到這個值；
# 若有 root .env，build.py 會優先用 root 的（見 build.py _env_file_args()）。
API_VERSION=0.4

# ==================== Keycloak DB (PostgreSQL) ====================
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<db_password>

# ==================== Keycloak ====================
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<admin_password>
PERMANENT_MASTER_ADMIN_USER=<permanent_admin_username>
PERMANENT_ADMIN_PASSWORD=<permanent_admin_password>
PORT_KEYCLOAK=8080

# ==================== Keycloak API (port 8800) ====================
KEYCLOAK_URL=http://keycloak:8080
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<admin_password>

# ==================== Keycloak Resource URIs (sync_resources.py) ====================
# Comma-separated URI patterns. Leave blank to use the built-in defaults.
KEYCLOAK_INFERENCE_URIS=/api/${API_VERSION}/search/*,/api/${API_VERSION}/asset/*,/api/${API_VERSION}/processing/*,/api/${API_VERSION}/chat/*,/api/${API_VERSION}/document/*,/api/${API_VERSION}/sync/*,/api/${API_VERSION}/a2a/*,/api/${API_VERSION}/memory/*,/api/${API_VERSION}/personal-db/*,/api/${API_VERSION}/mcp/*,/api/${API_VERSION}/benchmark/*,/API/inference/*
KEYCLOAK_FINETUNING_URIS=/API/finetune/*,/api/${API_VERSION}/aiml/*,/api/${API_VERSION}/training/*

# ==================== Keycloak Metrics (already enabled, not overridable via .env) ====================
# KC_METRICS_ENABLED=true and KC_HEALTH_ENABLED=true are hardcoded in docker-compose.yml.
# Prometheus scrapes raptor-keycloak:9000/metrics (Module 14). No action needed here.
