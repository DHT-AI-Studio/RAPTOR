# ============================================================
# Raptor 0.4 — Unified Environment Configuration
#
# 使用方式：
#   cp .env.local .env && python build.py
# ============================================================

# ============================================================
# HOST PORT SETTINGS（所有對外 expose 的 port，集中在此管理）
# 每一項都標「→ container XXXX」，標示這個 port 實際固定的容器內部值
#
# Naming convention: PORT_* (prefix) is a host-published port — safe to
# change here to avoid a conflict on the deployment machine; every
# docker-compose.yml maps it as `${PORT_X:-default}:<fixed-container-port>`,
# so it never affects what the service listens on inside its own container.
# *_PORT (suffix, defined further down near each module's other settings,
# e.g. POSTGRES_PORT/REDIS_PORT) names a fixed, container-internal port used
# only to build service-to-service connection strings on the Docker network
# — don't treat those as deployer-tunable.
#
# Exception: Module 02's Redis Cluster ports (PORT_REDIS_CLUSTER_*,
# PORT_REDIS_CLUSTER_BUS_*) use the PORT_* prefix but intentionally drive
# BOTH the host and container port together — Redis Cluster's own protocol
# requires each node's cluster-announce-port to match the port other nodes/
# clients can actually reach, so this pair can't be decoupled like the rest.
# ============================================================

# ── 01 NFS Server ────────────────────────────────────────────
PORT_NFS=2049                           # → container 2049

# ── 02 Redis ─────────────────────────────────────────────────
PORT_REDIS_STANDALONE=6379              # → container 6379
# host=container, moves together — cluster-announce-port protocol requirement, see exception note above
PORT_REDIS_CLUSTER_1=7000               # → container 7000 (coupled)
PORT_REDIS_CLUSTER_2=7001               # → container 7001 (coupled)
PORT_REDIS_CLUSTER_3=7002               # → container 7002 (coupled)
PORT_REDIS_CLUSTER_4=7003               # → container 7003 (coupled)
PORT_REDIS_CLUSTER_5=7004               # → container 7004 (coupled)
PORT_REDIS_CLUSTER_6=7005               # → container 7005 (coupled)
PORT_REDIS_CLUSTER_BUS_1=17000          # → container 17000 (coupled)
PORT_REDIS_CLUSTER_BUS_2=17001          # → container 17001 (coupled)
PORT_REDIS_CLUSTER_BUS_3=17002          # → container 17002 (coupled)
PORT_REDIS_CLUSTER_BUS_4=17003          # → container 17003 (coupled)
PORT_REDIS_CLUSTER_BUS_5=17004          # → container 17004 (coupled)
PORT_REDIS_CLUSTER_BUS_6=17005          # → container 17005 (coupled)
PORT_REDISINSIGHT=5540                  # → container 5540

# ── 03 Database ──────────────────────────────────────────────
PORT_POSTGRES=5433                      # → container 5432
PORT_QDRANT=6333                        # → container 6333
PORT_QDRANT_GRPC=6334                   # → container 6334

# ── 04 Object Storage ────────────────────────────────────────
PORT_ASSET_MANAGEMENT=8000              # → container 8000
PORT_SEAWEEDFS_S3=8333                  # → container 8333
PORT_SEAWEEDFS_ADMIN=23646              # → container 23646
PORT_LAKEFS=8001                        # → container 8000

# ── 05 Kafka ─────────────────────────────────────────────────
PORT_KAFKA_BROKER1=19092                # → container 19092
PORT_KAFKA_BROKER2=19093                # → container 19093
PORT_KAFKA_BROKER3=19094                # → container 19094
PORT_AKHQ=8180                          # → container 8080
PORT_KAFDROP=9010                       # → container 9000

# ── 06 Authentication ────────────────────────────────────────
PORT_KEYCLOAK=8080                      # → container 8080
PORT_KEYCLOAK_DB=5434                   # → container 5432
PORT_KEYCLOAK_API=8800                  # → container 8800

# ── 07 AI-ML Services ────────────────────────────────────────
PORT_AI_LIFECYCLE_API=8010              # → container 8010
PORT_MLFLOW=5555                        # → container 5555

# ── 09 Audio Processing ──────────────────────────────────────
PORT_AUDIO_SYNC_API=8019                # → container 8019
PORT_AUDIO_DIARIZATION_SYNC=8029        # → container 8029
PORT_AUDIO_CLASSIFIER_SYNC=8039         # → container 8039

# ── 10 Image Processing ──────────────────────────────────────
PORT_IMAGE_SYNC_API=8018                # → container 8018

# ── 11 Video Processing ──────────────────────────────────────
PORT_VIDEO_FRAME_SYNC_API=8031          # → container 8031
PORT_VIDEO_OCR_SYNC=8032                # → container 8032

# ── 12 Document Processing ───────────────────────────────────
PORT_DOCUMENT_SYNC_API=8020             # → container 8020

# ── 13 API Gateway ───────────────────────────────────────────
PORT_API_GATEWAY=8012                   # → container 8012

# ── 14 Monitoring ────────────────────────────────────────────
PORT_PROMETHEUS=9090                    # → container 9090
PORT_GRAFANA=3000                       # → container 3000
PORT_ALERTMANAGER=9093                  # → container 9093
PORT_NODE_EXPORTER=9100                 # → container 9100
PORT_CADVISOR=8085                      # → container 8080
PORT_LOKI=3100                          # → container 3100
PORT_KAFKA_EXPORTER=9308                # → container 9308
PORT_REDIS_EXPORTER=9121                # → container 9121
PORT_ES_EXPORTER=9114                   # → container 9114
PORT_DCGM_EXPORTER=9400                 # → container 9400 (GPU hosts only, --profile gpu)

# ── 15 Chat Service ──────────────────────────────────────────
PORT_CHAT_SERVICE=8021                  # → container 8021

# ── 16 Training Service ──────────────────────────────────────
PORT_FASTAPI=8009                       # → container 8009

# ── 17 Hybrid Search ─────────────────────────────────────────
PORT_OPENSEARCH=9200                    # → container 9200
PORT_OPENSEARCH_PERF=9600               # → container 9600; Performance Analyzer
PORT_OPENSEARCH_DASHBOARDS=5601         # → container 5601
PORT_HYBRID_SEARCH=8091                 # → container 8000

# ── 18 Query Orchestrator ────────────────────────────────────
PORT_QUERY_ORCHESTRATOR=8843            # → container 8000

# ── 19 Graph Database ────────────────────────────────────────
PORT_NEO4J_BROWSER=7474                 # → container 7474
PORT_NEO4J_BOLT=7687                    # → container 7687
PORT_NEO4J_METRICS=2004                 # → container 2004; Prometheus metrics

# ── 20 Graph Service ─────────────────────────────────────────
PORT_GRAPH_SERVICE=8844                 # → container 8843

# ── 21 Agent Protocol ────────────────────────────────────────
PORT_AGENT_PROTOCOL=8030                # → container 8030
PORT_VECTOR_AGENT=52001                 # → container 52001
PORT_KEYWORD_AGENT=52002                # → container 52002
PORT_GRAPHRAG_AGENT=52003               # → container 52003
PORT_TKG_AGENT=52004                    # → container 52004
PORT_RERANKER_AGENT=52005               # → container 52005

# ── 22 Benchmark Service ─────────────────────────────────────
PORT_BENCHMARK_SERVICE=8022             # → container 8000

# ── 23 Guardrail Service ─────────────────────────────────────
PORT_GUARDRAIL_SERVICE=8023             # → container 8026; container-to-container calls (13, 07) use 8026 directly
# (shares module 03's Postgres and module 02's Redis -- no dedicated DB ports here)

# ── 24 ArcadeDB Server ───────────────────────────────────────
PORT_ARCADEDB_HTTP=2480                 # → container 2480; HTTP API — Module 25 connects here; Studio UI
PORT_ARCADEDB_BINARY=2424               # → container 2424; binary protocol (optional)

# ── 25 Personal DB Service ───────────────────────────────────
PORT_PERSONAL_DB=8025                   # → container 8000

# ── 26 Memory Service ────────────────────────────────────────
PORT_MEMORY_SERVICE=8026                # → container 8026

# ── 27 MCP Server ────────────────────────────────────────────
PORT_MCP_SERVER=8027                    # → container 8027

# ============================================================
# GPU ALLOCATION SETTINGS（所有需要 GPU 的服務，集中在此管理）
# _GPU=N → docker-compose device_ids 精確指定實體 GPU 索引（0 起算）
#           容器內部永遠以 CUDA_VISIBLE_DEVICES=0 存取
# ============================================================

# ── 共用 ─────────────────────────────────────────────────────
MAX_MEMORY_PER_GPU=36GiB          # 10 11（InternVL VLM 最大顯存）

# ── 07 AI-ML Services (ai-lifecycle-api) ─────────────────────
AI_LIFECYCLE_GPU=0

# ── 09 Audio Processing ──────────────────────────────────────
AUDIO_RECOGNIZER_GPU=0
AUDIO_DIARIZATION_GPU=0
AUDIO_CLASSIFIER_GPU=0

# ── 10 Image Processing ──────────────────────────────────────
IMAGE_PROCESSING_GPU=0

# ── 11 Video Processing ──────────────────────────────────────
# VIDEO_CHUNKING_GPU=1, not 0: confirmed live (2026-08-24) that ffmpeg
# h264_nvenc fails 100% deterministically on GPU 0 on multi-GPU hosts running
# driver 595.84 ("OpenEncodeSessionEx failed: unsupported device (2)"),
# while GPU 1 works cleanly -- CUDA compute (torch) is unaffected on either
# GPU, this is NVENC-specific. video-chunking is the only module-11 service
# that actually calls ffmpeg's hwaccel/nvenc path (frame_selector.py +
# chunker.py) -- video-ocr-frame/video-frame-description only do CUDA
# compute (PaddleOCR/InternVL inference on already-extracted frame images),
# confirmed via a full grep of both services' code, so they don't need this
# and are left on GPU 0. Full investigation: Issue #94. If your host isn't
# hitting this (different driver version, single GPU, etc.), 0 is fine.
VIDEO_CHUNKING_GPU=1
VIDEO_OCR_GPU=0
VIDEO_FRAME_DESC_GPU=0

# ── 12 Document Processing ───────────────────────────────────
DOCUMENT_ANALYSIS_GPU=0

# ── 16 Training Service ──────────────────────────────────────
CUDA_VISIBLE_DEVICES=0,1          # multi-GPU training

# ── 17 Hybrid Search ─────────────────────────────────────────
HYBRID_SEARCH_GPU=1

# ── 18 Query Orchestrator ────────────────────────────────────
QUERY_ORCHESTRATOR_GPU=0

# ── 25 Personal DB Service (embedder + local reranker) ───────
PERSONAL_DB_GPU=0

# ── 26 Memory Service (local bge-m3 embedder) ─────────────────
MEMORY_SERVICE_GPU=0

# ============================================================
# 全域共用設定（真正無 module 歸屬的設定）
# ============================================================

# ── 基礎設施 ─────────────────────────────────────────────────
DOCKER_NETWORK=<your_docker_network_name>
HOST_IP=<host_ip>
TIMEZONE=Asia/Taipei

# ── API 版本（06 13 27 共用，單一真實來源；下方 module 06/13/27 區塊皆引用此值）──
API_VERSION=0.4

# ── HuggingFace（07 09 10 11 12 17 共用，無單一 module 歸屬）──
HF_TOKEN=<your_hf_token>
HF_CACHE_PATH=<your_hf_cache_path>

# ── 外部 LLM — Ollama（非 Raptor module，外部部署）──────────
OLLAMA_HOST=http://<host_ip>:11434
LLM_BASE_URL=${OLLAMA_HOST}/v1
LLM_MODEL=qwen2.5:7b
# 15（經 07 轉發，ChatOpenAI + extra_body）/21 的 pipeline.py（同樣經 07）共用
# -- 兩邊都是靠 07 的 /v1/chat/completions 或 /inference/infer 把這個值傳進
# Ollama 原生 API 才吃得到，Ollama 自己的 OpenAI-compat 層會靜默忽略，實測過。
# 預設值請對齊 LLM_MODEL 實際設定的模型自己的 context length（Ollama /api/show
# 的 model_info.*.context_length 查得到），不是隨便抓的數字 -- 換模型記得跟著改。
LLM_NUM_CTX=32768
# qwen3.x 系列模型預設會開啟「思考」模式，明確設 false 可跳過，省下 10-20 倍延遲
# （實測 4.8s vs 59s，同一個 prompt）。單一真實來源 -- 09/11/12/15/18/20/21/25/26
# 每個經由 07 呼叫 Ollama 的服務都各自有自己的 <module>_INFERENCE_THINK 變數
# （15 是 CHAT_LLM_THINK，20 是 GRAPH_INFERENCE_THINK，21 是 AGENT_INFERENCE_THINK，
# 見各自 module 區塊）代換這個值，方便追蹤是哪個服務在用；不要在各 module
# 區塊裡再各自定義獨立的預設值。
LLM_THINK=false

# ── VLM 模型基準（10 11 12 各可獨立覆蓋）────────────────────
VLM_MODEL_PATH=OpenGVLab/InternVL3_5-1B

# ── S3 / AWS 認證（04 07 共用）──────────────────────────────
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>

# ── 跨服務超時（09 11 使用）─────────────────────────────────
CROSS_SERVICE_TIMEOUT=600

# ============================================================
# 服務間通訊 URL
# .env 插值由上至下解析，module 13 引用了排序在後的 module（17 18 20 25）
# 故這四個 URL 須提前定義；括號內為實際歸屬 module
# ============================================================
HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000        # [17]
HYBRID_SEARCH_INGEST_URL=${HYBRID_SEARCH_URL}/api/v1/ingest/file  # [17]
QUERY_ORCHESTRATOR_URL=http://raptor-query-orchestrator:8000  # [18]
GRAPH_SERVICE_URL=http://raptor-graph-service:8843           # [20]
PERSONAL_DB_SERVICE_URL=http://raptor-personal-db-service:8000  # [25]

# ============================================================
# 01 — nfs-server
# ============================================================
NFS_SERVER=${HOST_IP}
NFS_EXPORT=/nfs-share
NFS_MEDIA_TMP_PATH=/media/processing
NFS_AIML_TMP_PATH=/aiml/tmp
NFS_AIML_DATA_PATH=/aiml/data
# ── 初始化專用 ──
NFS_BASE_PATH=<your_nfs_base_path>
BASE_DIR=seaweedfs
SUB_DIRS="admin s3 backup filer vol1 vol2 vol3 vol4 master1 master2 master3"
BASE_DIR_2=aiml
SUB_DIRS_2="tmp data"
BASE_DIR_3=media
SUB_DIRS_3="processing"
BASE_DIR_4=memvid
SUB_DIRS_4="storage"

# ============================================================
# 02 — redis-cluster
# ============================================================
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
REDIS_DB=0

# ============================================================
# 03 — database
# ============================================================
POSTGRES_HOST=raptor-postgres
POSTGRES_PORT=5432
POSTGRES_USER=raptor
POSTGRES_PASSWORD=<your_postgres_password>
POSTGRES_DB=raptor          # PostgreSQL 容器預設 DB；init/001_init.sql 另外建 asset_management mlflow gateway tkg personal_db
QDRANT_HOST=raptor-qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=raptor

# ============================================================
# 04 — asset-management
# ============================================================
ASSET_MANAGEMENT_URL=http://raptor-asset-management:8000
# POSTGRES_DB 不在此定義：LakeFS 連線字串已有 :-asset_management 預設值（見 docker-compose.yml line 256）
# OpenSearch 連線變數（OPENSEARCH_HOST/PORT/USER/PASSWORD/INDEX/VERIFY_CERTS）
# 定義於 module 17 section，透過 env_file: path: ../.env 全量注入，ordering 無影響
# config.py 讀 AWS_ACCESS_KEY / AWS_SECRET_KEY（非標準 SDK 名稱），以下透過插值對應
AWS_ACCESS_KEY=${AWS_ACCESS_KEY_ID}
AWS_SECRET_KEY=${AWS_SECRET_ACCESS_KEY}
AUTO_DAILY_ARCHIVE_TIME=00:00
AUTO_DAILY_DESTROY_TIME=01:00
SEAWEEDFS_BASE_DIR=/seaweedfs
S3_ENDPOINT=http://seaweedfs-s3:8333
S3_PUBLIC_URL=http://<host_ip>:8333
S3_BUCKET=lakefs
VOLUME_SIZE_LIMIT_MB=10240
MAX_NUMBER_OF_VOLUMES=50
LAKEFS_ENDPOINT=http://lakefs:8000
LAKEFS_ACCESS_KEY=<your_lakefs_access_key>
LAKEFS_SECRET_KEY=<your_lakefs_secret_key>
LAKEFS_AUTH_ENCRYPT_SECRET_KEY=<your_lakefs_auth_encrypt_secret_key>
LAKEFS_REPOSITORY=asset-management
LAKEFS_PRE_SIGNED_EXPIRY=24h
PRESIGN_URL_CACHE_ENABLED=false

# ============================================================
# 05 — kafka-cluster
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=kafka-broker1:9092,kafka-broker2:9092,kafka-broker3:9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# ============================================================
# 06 — authentication
# ============================================================
KEYCLOAK_URL=http://raptor-keycloak:8080
KEYCLOAK_DB_DATABASE=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=<your_keycloak_db_password>
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=<your_keycloak_admin_password>
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=<your_kc_bootstrap_admin_password>
PERMANENT_MASTER_ADMIN_USER=dhtsolution
PERMANENT_ADMIN_PASSWORD=<your_permanent_admin_password>
KEYCLOAK_INFERENCE_URIS=/api/${API_VERSION}/search/*,/api/${API_VERSION}/asset/*,/api/${API_VERSION}/processing/*,/api/${API_VERSION}/chat/*,/api/${API_VERSION}/document/*,/api/${API_VERSION}/sync/*,/api/${API_VERSION}/a2a/*,/api/${API_VERSION}/memory/*,/api/${API_VERSION}/personal-db/*,/api/${API_VERSION}/mcp/*,/api/${API_VERSION}/benchmark/*,/API/inference/*
KEYCLOAK_FINETUNING_URIS=/API/finetune/*,/api/${API_VERSION}/aiml/*,/api/${API_VERSION}/training/*
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_FROM_DISPLAY_NAME=
SMTP_AUTH=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=
SMTP_STARTTLS=
SMTP_TO_EMAIL=

# ============================================================
# 07 — ai-ml-services (AI Lifecycle API + MLflow)
# ============================================================
INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
INFERENCE_MODEL=qwen3.5:9b       # NOTE: Qwen family retained until v1.0; migrate to Gemma / Llama / Mistral at v1.0
OLLAMA_API_BASE=${OLLAMA_HOST}
AI_LIFECYCLE_API_HOST=0.0.0.0
MLFLOW_VERSION=v3.3.2
MLFLOW_HOST=0.0.0.0
MLFLOW_TRACKING_URI=http://mlflow:5555
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/mlflow
MLFLOW_S3_ENDPOINT_URL=http://lakefs:8000
INFERENCE_MAX_INPUT_LENGTH=8192

# ============================================================
