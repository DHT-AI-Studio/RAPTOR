GATEWAY_KAFKA_TOPICS='{"document": "document-processing-requests", "image": "image-processing-requests", "video": "video-processing-requests", "audio": "audio-processing-requests"}'
GATEWAY_CHAT_SERVICE_URL=http://raptor-chat-service:8021
GATEWAY_DOCUMENT_SYNC_URL=http://raptor-document-analysis:8020
GATEWAY_IMAGE_SYNC_URL=http://raptor-image-processing:8018
GATEWAY_VIDEO_FRAME_SYNC_URL=http://raptor-video-frame-description:8031
GATEWAY_TRAINING_SERVICE_URL=http://raptor-training-service:8009/api/v1/training
GATEWAY_VISION_SERVICE_URL=http://raptor-temporal-model-service:8000/analyze/video
GATEWAY_AGENT_PROTOCOL_URL=http://raptor-agent-protocol:8030
GATEWAY_MEMORY_SERVICE_URL=http://raptor-memory:8026
GATEWAY_OPENSEARCH_BRIDGE_URL=http://raptor-opensearch-bridge:8840
GATEWAY_MAX_CONNECTIONS=100
GATEWAY_MAX_KEEPALIVE_CONNECTIONS=20
GATEWAY_REQUEST_TIMEOUT=10.0
GATEWAY_UPLOAD_TIMEOUT=300.0
GATEWAY_BATCH_UPLOAD_CONCURRENCY=4
GATEWAY_RATE_LIMIT_PER_USER_PER_MINUTE=1000
GATEWAY_INTENT_MODEL=${LLM_MODEL}
GATEWAY_ANSWER_MODEL=${LLM_MODEL}
GATEWAY_SMOLAGENTS_MODEL=ollama/${LLM_MODEL}
GATEWAY_VIBEVOICE_ASR_MODEL=microsoft/VibeVoice-ASR
GATEWAY_AGENT_ID=raptor-gateway
GATEWAY_AGENT_NAME="Raptor Gateway Agent"

# ============================================================
# 14 — monitoring (Grafana)
# ============================================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<your_grafana_admin_password>
# Kafka broker hostnames for kafka-exporter -- override only if 05-kafka-cluster's
# compose service names differ from the defaults below.
KAFKA_BROKER_1=kafka-broker1
KAFKA_BROKER_2=kafka-broker2
KAFKA_BROKER_3=kafka-broker3
# Real webhook URL for Alertmanager notifications -- build.py auto-writes it
# into config/alertmanager/webhook_url (gitignored) every run. Blank = alerts
# fire but nobody gets notified.
ALERT_WEBHOOK_URL=
# true only on hosts with the NVIDIA DCGM stack installed -- adds
# --profile gpu so build.py actually starts dcgm-exporter.
ENABLE_GPU_MONITORING=false

# ============================================================
# 15 — chat-service
# ============================================================
CHAT_LLM_MODEL=${LLM_MODEL}
TEMPERATURE=0.7
# LLM_NUM_CTX 因插值順序限制定義於上方（15/21 共用）
CHAT_LLM_THINK=${LLM_THINK}
MEMORY_CONTEXT_WINDOW=5
MEMORY_TTL=3600
REQUEST_TIMEOUT=60.0
CHAT_MEMORY_SERVICE_URL=http://raptor-memory-service:8026

# ============================================================
# 16 — training-service
# ============================================================
VRAM_OVERHEAD_GB=1.0
TORCH_FORCE_NO_WEIGHTS_ONLY_LOAD=1

# ============================================================
# 17 — hybrid-search
# HYBRID_SEARCH_URL / HYBRID_SEARCH_INGEST_URL 因插值順序限制定義於上方
# ============================================================
OPENSEARCH_HOST=opensearch-node1
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<your_opensearch_password>
OPENSEARCH_INDEX=hybrid_index
OPENSEARCH_VERIFY_CERTS=False
EMBEDDING_MODEL=BAAI/bge-m3 # intfloat/multilingual-e5-large   # 1024-dim; changing the embedding model requires rebuilding existing vector indexes
VECTOR_DIM=1024
RERANKER_MODEL=BAAI/bge-reranker-v2-m3 # cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TEMPERATURE=0.25
OPENSEARCH_DASHBOARDS_HOST=opensearch-dashboards
RRF_K_FACTOR=60

# ============================================================
# 18 — query-orchestrator
# QUERY_ORCHESTRATOR_URL 因插值順序限制定義於上方
# config.py 使用 env_prefix="QO_"
# ============================================================
QO_INFERENCE_URL=${INFERENCE_URL}
QO_INFERENCE_MODEL=qwen3.5:0.8b
QO_INFERENCE_TIMEOUT=15
QO_INFERENCE_THINK=${LLM_THINK}
QO_LOG_LEVEL=INFO

# ============================================================
# 19 — graph-database
# ============================================================
NEO4J_URI=bolt://raptor-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your_neo4j_password>

# ============================================================
# 20 — graph-service
# GRAPH_SERVICE_URL 因插值順序限制定義於上方
# ============================================================
CHAT_MODEL_NAME=${LLM_MODEL}
GRAPH_INFERENCE_THINK=${LLM_THINK}

# ============================================================
# 21 — agent-protocol (A2A orchestrator + RAG pipeline)
# ============================================================
OLLAMA_MODEL=${LLM_MODEL}
AGENT_INFERENCE_THINK=${LLM_THINK}      # pipeline.py + graphrag-agent + tkg-agent 共用同一個值
AGENT_ID=raptor-agent
AGENT_NAME="Raptor Intelligence Agent"
AGENT_ENDPOINT=http://raptor-agent-protocol:8030
# A2A 搜尋 agents（docker 內部網路）
VECTOR_AGENT_URL=http://raptor-vector-agent:52001
KEYWORD_AGENT_URL=http://raptor-keyword-agent:52002
GRAPHRAG_AGENT_URL=http://raptor-graphrag-agent:52003
TKG_AGENT_URL=http://raptor-tkg-agent:52004
RERANKER_AGENT_URL=http://raptor-reranker-agent:52005
AGENT_TTL=300                           # A2A peer discovery Redis key TTL (seconds)
LLM_ANSWER_TEMPERATURE=0.3              # RAG answer synthesis (_llm_answer) -- separate from module 15's TEMPERATURE (0.7) on purpose

# Routed through Module 13's JWT-protected gateway, not Module 26 directly —
# 21 forwards the caller's own Authorization header (see memory_client.py).
MEMORY_SERVICE_URL=http://raptor-api-gateway:8012/api/${API_VERSION}
MEM_COMPACT_THRESHOLD=128000

# ============================================================
# 22 — benchmark-service
# ============================================================
BM_LOG_LEVEL=INFO
BM_POSTGRES_DB=benchmark
BM_REDIS_RUN_TTL_SECONDS=604800
BM_INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
BM_JUDGE_MODEL=qwen3.5:9b
BM_JUDGE_ENGINE=ollama
BM_JUDGE_THINK=${LLM_THINK}
BM_INFERENCE_TIMEOUT=30
BM_EMBED_MODEL=bge-m3
BM_EMBED_TIMEOUT=30
BM_PIPELINE_TIMEOUT=30
BM_CHAT_URL=http://raptor-chat-service:8021
BM_SEARCH_URL=http://raptor-personal-db-service:8000
BM_RAG_URL=http://raptor-agent-protocol:8030
BM_CLASSIFY_URL=http://raptor-query-orchestrator:8000

# ============================================================
# 23 — guardrail-service
# GUARDRAIL_URL / GUARDRAIL_TIMEOUT are shared-by-name config (which service
# to call, how long to wait) read by BOTH module 13's GuardrailMiddleware and
# module 07's guardrail_hook.py — defined once here so both stay in sync.
# GR_ENABLED (module 13) and AIML_GUARDRAIL_ENABLED (module 07) are each
# module's own separate on/off switch, both false by default -- deliberately
# two independent switches, not one shared one: module 13 needs GUARDRAIL_URL
# populated regardless of whether module 07's hook should run, so "URL is
# set" can never be allowed to double as an enable signal for either side.
# Flip these two independently depending on which one (or both) you actually
# want checking content. The AIML_ prefix on module 07's switch is there
# specifically so the two lines below don't look like the same thing at a
# glance -- bare GUARDRAIL_ENABLED is also still accepted by the code if you
# prefer it, but AIML_GUARDRAIL_ENABLED is what's actually set here.
# Container-to-container calls always use 8026 (the container's fixed internal
# port), never PORT_GUARDRAIL_SERVICE (8023, host-only mapping — see above).
# Module 23 shares module 03's Postgres (database "guardrails") and module
# 02's Redis (DB 0) directly via the platform-wide POSTGRES_*/REDIS_* vars —
# no dedicated DB vars of its own.
# ============================================================
GUARDRAIL_URL=http://raptor-guardrail-service:8026
GUARDRAIL_TIMEOUT=20.0
GR_ENABLED=false
AIML_GUARDRAIL_ENABLED=false
# Leave GUARD_MODEL_2/3 blank for single-model (llama-guard3:8b only).
GUARD_MODEL=llama-guard3:8b
GUARD_MODEL_2=granite4.1-guardian:8b
GUARD_MODEL_3=gpt-oss-safeguard:20b

# ============================================================
# 24 — arcadedb-server (multi-model engine: graph + vector + BM25)
# (PORT_ARCADEDB_HTTP / PORT_ARCADEDB_BINARY are in HOST PORT SETTINGS above)
# ============================================================
# Required — compose refuses to start without it. Replace before deploying.
ARCADEDB_ROOT_PASSWORD=<your_arcadedb_root_password>

# ============================================================
# 25 — personal-db-service (per-user isolated DB: lifecycle + search)
# (PORT_PERSONAL_DB is in HOST PORT SETTINGS above)
# PERSONAL_DB_SERVICE_URL 因插值順序限制定義於上方（consumed by module 13; 15/21 也直接讀取此變數，見各自的 docker-compose.yml）
# ============================================================
PD_ARCADEDB_URL=http://raptor-arcadedb:2480
PD_VECTOR_DIM=1024                      # BAAI/bge-m3 embedding dimension
PD_AUDIT_REQUIRED=1                     # 0 refuses nothing; 1 refuses DELETE when the audit DB is down
PD_KAFKA_BOOTSTRAP=${KAFKA_BOOTSTRAP_SERVERS}   # consumes personal-index-requests (Module 05)
PD_REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379   # version_id dedup (Module 02)
PD_EMBEDDING_MODEL=BAAI/bge-m3
PD_EMBEDDING_DEVICE=auto                # cpu | cuda | auto
PD_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
PD_RERANKER_DEVICE=auto                 # cpu | cuda | auto
PD_RERANKER_TEMPERATURE=0.25            # sigmoid temperature scaling; <1 sharpens score distribution
PD_RERANK_DEPTH=15                      # fusion pool widened to this before rerank, then truncated to top_k
PD_LLM_BASE_URL=${LLM_BASE_URL}         # personal-graph entity extraction (video only) — shares Module 20's Ollama endpoint
PD_CHAT_MODEL_NAME=${CHAT_MODEL_NAME}   # shares Module 20's chat model
PD_INFERENCE_URL=${INFERENCE_URL}       # extraction actually calls this (module 07), not PD_LLM_BASE_URL directly
PD_INFERENCE_THINK=${LLM_THINK}
PD_GRAPH_EXTRACTION_ENABLED=1           # 0 disables video graph extraction entirely
PD_GRAPH_EXTRACTION_MAX_MOMENTS=10      # cap on per-moment temporal-fact LLM calls per video
PD_GRAPH_EXTRACTION_MAX_CONCURRENCY=1    # max videos extracting concurrently (background tasks). Was 2; lowered live (2026-08-24) after a shared Ollama instance's model runner crashed while 2 videos were extracting at once ("model runner has unexpectedly stopped, this may be due to resource limitations or an internal error" -- Ollama's own generic error, not a confirmed diagnosis). Root cause unconfirmed -- could be our own concurrent load, could be another team's much larger model on the same shared instance (it hosts models up to 290GB); no log evidence either way. 1 keeps this service's own contribution to that risk minimal either way.
PD_GRAPH_EXTRACTION_BATCH_CONCURRENCY=2  # max concurrent LLM calls WITHIN one video's extraction (moment batches + per-moment temporal-fact candidates). Separate axis from the max-videos setting above -- this bounds how fast a single video's own extraction finishes, which matters because MAX_CONCURRENCY=1 means the next queued video's extraction can only start once the current one's LLM calls are all done; a faster single video shrinks that queueing window.
# ARCADEDB_ROOT_PASSWORD is shared with Module 24 — see the 24 section above.
# The deletion audit uses POSTGRES_* (above) against the `personal_db` database,
# created by Module 03's init/postgresql/001_init.sql.

# ============================================================
# 26 — memory-service (MemVID session / long-term memory)
# PORT_MEMORY_SERVICE 因插值順序限制定義於上方
# config.py 使用 env_prefix="MEM_"
# ============================================================
NFS_MEMVID_PATH=/memvid/storage
MEM_STORAGE_ROOT=/mnt/memvid-storage
MEM_EMBEDDING_MODEL=BAAI/bge-m3
# preference/entity/fact extraction + compact_session summarization -- was never
# wired to anything, silently defaulted to a hardcoded "qwen2.5:7b" in config.py
# regardless of LLM_MODEL; note the real env var here is MEM_EXTRACTION_MODEL
# (config.py uses env_prefix="MEM_"), not bare EXTRACTION_MODEL
MEM_EXTRACTION_MODEL=${LLM_MODEL}
MEM_MODULE07_URL=${INFERENCE_URL}
MEM_INFERENCE_THINK=${LLM_THINK}
MEM_REDIS_HOST=${REDIS_HOST}
MEM_REDIS_PORT=${REDIS_PORT}
MEM_REDIS_PASSWORD=${REDIS_PASSWORD}
MEM_COMPACT_KEEP_TURNS=10
MEM_COMPACT_TOOL_RESULT_RETENTION_HOURS=24.0

# ============================================================
# 27 — mcp-server
# config.py 使用 env_prefix="MCP_"
# ============================================================
MCP_SERVER_NAME=raptor-mcp
MCP_SERVER_VERSION=1.0.0
MCP_API_GATEWAY_BASE_URL=http://raptor-api-gateway:8012
MCP_API_VERSION=${API_VERSION}
MCP_KEYCLOAK_URL=${KEYCLOAK_URL}
MCP_REALM_NAME=dhtsolution
MCP_CLIENT_ID=raptor
MCP_KEYCLOAK_USERNAME=<service_account_username>
MCP_KEYCLOAK_PASSWORD=<service_account_password>
MCP_REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379/3
MCP_LOG_LEVEL=INFO
MCP_TRANSPORT=http                      # "http" (default) or "stdio" (python -m app)
MCP_PORT=8027                           # internal uvicorn port (transport=http); must match Dockerfile EXPOSE/HEALTHCHECK
MCP_TIMEOUT_DEFAULT=30.0                # default timeout (s) for calls to Module 13
MCP_TIMEOUT_UPLOAD=120.0                # timeout (s) for file-upload calls to Module 13
MCP_MAX_ATTEMPTS=3                      # 1 initial + (n-1) retries on 5xx/network errors
MCP_RETRY_BACKOFF_SECONDS=1.0
MCP_TOKEN_TTL_SECONDS=1800              # server service-account token cache (30 min)
MCP_AGENT_TOKEN_TTL_SECONDS=86400       # agent_token lifetime / idle-refresh window (24h) — also returned as expires_in by POST /mcp/auth/register
MCP_REFRESH_MARGIN_SECONDS=60           # refresh a cached token when < this many seconds remain
MCP_TIMEOUT_A2A=120.0                   # timeout (s) for A2A tool calls (raptor_a2a_*, raptor_query_orchestrate)
MCP_TIMEOUT_RESOURCE_LIST=15.0          # timeout (s) for short resource reads
MCP_COOCCUR_LIMIT=20                    # max co-occurring entities returned by graph tools
MCP_MAX_UPLOAD_BYTES=52428800           # 50 MB asset upload limit
MCP_STDIO_LOG_PATH=/tmp/raptor-mcp-stdio.log   # transport=stdio only (stdout is reserved for the MCP protocol)
# Required for POST /mcp/auth/register (encrypts the agent's client_secret before it's written to Redis).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRET_ENCRYPTION_KEY=<generate-a-fernet-key>
