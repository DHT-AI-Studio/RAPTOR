# ============================================================
# 25-personal-db-service environment
# ============================================================

# ── ArcadeDB (Module 24) ──────────────────────────────────
# Required — must match Module 24's value.
ARCADEDB_ROOT_PASSWORD=<your_arcadedb_root_password>
PD_ARCADEDB_URL=http://raptor-arcadedb:2480
ARCADE_USER=root

# ── PostgreSQL (Module 03) — deletion audit ───────────────
POSTGRES_HOST=raptor-postgres
POSTGRES_USER=raptor
POSTGRES_PASSWORD=<your_postgres_password>
PD_AUDIT_REQUIRED=1

# ── Kafka (Module 05) — consumes personal-index-requests ──
PD_KAFKA_BOOTSTRAP=kafka-broker1:9092,kafka-broker2:9092,kafka-broker3:9092

# ── Redis (Module 02) — version_id dedup ──────────────────
# raptor-redis-standalone runs with --requirepass — must match Module 02's value.
PD_REDIS_URL=redis://:<your_redis_password>@raptor-redis-standalone:6379

# ── Service ───────────────────────────────────────────────
PORT_PERSONAL_DB=8025
PD_VECTOR_DIM=1024

# ── GPU / HuggingFace cache — embedder (BAAI/bge-m3) + reranker
#    (BAAI/bge-reranker-v2-m3) both load here ─────────────
HF_CACHE_PATH=/path/to/huggingface/cache
PERSONAL_DB_GPU=0
PD_EMBEDDING_MODEL=BAAI/bge-m3
PD_EMBEDDING_DEVICE=auto                # cpu | cuda | auto
PD_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
PD_RERANKER_DEVICE=auto                 # cpu | cuda | auto
PD_RERANKER_TEMPERATURE=0.25            # sigmoid temperature scaling; <1 sharpens score distribution
PD_RERANK_DEPTH=15                      # fusion pool widened to this before rerank, then truncated to top_k

# ── Personal-graph entity/relationship/temporal-fact extraction ──
#    (video only for now) — same Ollama chat-completions endpoint
#    Module 20 (graph-service) talks to; set the same values as its
#    LLM_BASE_URL/CHAT_MODEL_NAME if sharing one Ollama instance ──
PD_LLM_BASE_URL=http://host.docker.internal:11434/v1
PD_CHAT_MODEL_NAME=qwen2.5:7b
PD_INFERENCE_URL=http://raptor-ai-lifecycle-api:8010   # extraction actually calls this (module 07), not PD_LLM_BASE_URL directly
PD_INFERENCE_THINK=false
PD_GRAPH_EXTRACTION_ENABLED=1           # 0 disables video graph extraction entirely
PD_GRAPH_EXTRACTION_MAX_MOMENTS=10      # cap on per-moment temporal-fact LLM calls per video
PD_GRAPH_EXTRACTION_MAX_CONCURRENCY=1    # max videos extracting concurrently (background tasks). Was 2; lowered after a shared Ollama instance's model runner crashed while 2 videos were extracting at once. Root cause unconfirmed (our own load vs. another team's much larger model on the same shared instance) -- see root .env.example for the full note.
PD_GRAPH_EXTRACTION_BATCH_CONCURRENCY=2  # max concurrent LLM calls WITHIN one video's extraction -- separate axis, see root .env.example.

# ── Timezone ──────────────────────────────────────────────
TIMEZONE=Asia/Taipei
