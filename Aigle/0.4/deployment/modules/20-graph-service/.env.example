# ==========================================
# General
# ==========================================
TIMEZONE=Asia/Taipei

# ==========================================
# Neo4j (module 19)
# ==========================================
NEO4J_URI=bolt://raptor-neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your_neo4j_password>

# ==========================================
# LLM
# ==========================================
# Extraction calls go through module 07 (INFERENCE_URL) now, not
# LLM_BASE_URL directly -- module 07's Ollama adapter defaults think=false,
# which the OpenAI-compat endpoint LLM_BASE_URL points at has no way to
# control (qwen3.x-family models "think" by default, adding 10-20x latency
# for no change in the final answer). LLM_BASE_URL/CHAT_MODEL_NAME kept for
# the commented-out fallback code paths in graph_builder.py/tkg.py.
LLM_BASE_URL=http://<your_ollama_host_ip>:11434/v1
CHAT_MODEL_NAME=qwen2.5:7b
INFERENCE_URL=http://raptor-ai-lifecycle-api:8010
INFERENCE_THINK=false

# ==========================================
# HTTP
# ==========================================
PORT_GRAPH_SERVICE=8844
