# ==========================================
# Monitoring (Prometheus / Grafana)
# ==========================================
TIMEZONE=Asia/Taipei
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<your_grafana_password>
PORT_PROMETHEUS=9090
PORT_GRAFANA=3000
PORT_ALERTMANAGER=9093
PORT_NODE_EXPORTER=9100
PORT_CADVISOR=8085
PORT_LOKI=3100
PORT_KAFKA_EXPORTER=9308
PORT_REDIS_EXPORTER=9121
PORT_ES_EXPORTER=9114
PORT_DCGM_EXPORTER=9400
# Kafka broker hostnames for kafka-exporter -- override only if 05-kafka-cluster's
# compose service names differ from the defaults below.
KAFKA_BROKER_1=kafka-broker1
KAFKA_BROKER_2=kafka-broker2
KAFKA_BROKER_3=kafka-broker3

# Real webhook URL for Alertmanager notifications (e.g. a Slack incoming
# webhook). Leave blank to leave alert notifications undelivered (rules still
# fire and show up in Prometheus/Alertmanager, nobody gets paged). `build.py
# run 14` auto-writes this into config/alertmanager/webhook_url (gitignored,
# never hand-edit that file) every run via ensure_alertmanager_webhook().
ALERT_WEBHOOK_URL=

# Set true only on a host with the NVIDIA DCGM stack installed. Adds
# `--profile gpu` when `build.py` starts module 14, which is what actually
# starts the dcgm-exporter container (docker-compose.yml has it under
# `profiles: [gpu]` so a plain `up -d` skips it). Leave false/unset on
# CPU-only hosts -- the ServiceDown alert on dcgm-exporter firing is expected
# and harmless when this is off, not a real incident.
ENABLE_GPU_MONITORING=false

# REDIS_HOST/REDIS_PORT/REDIS_PASSWORD are NOT listed here -- they're owned by
# 02-redis-cluster's own .env.example (module 14 only consumes them, for
# redis-exporter). Same reasoning for OPENSEARCH_PASSWORD below (owned by
# 17-hybrid-search).
#
# The opensearch scrape job's password is NOT read from .env directly --
# Prometheus's own config format doesn't support ${VAR} expansion. Instead,
# `build.py run 14` auto-generates ./secrets/opensearch_password (gitignored)
# from OPENSEARCH_PASSWORD (see the shared deployment/modules/.env.example)
# every run. No action needed here.
