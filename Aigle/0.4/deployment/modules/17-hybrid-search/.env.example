# ==========================================
# OpenSearch Settings
# ==========================================
OPENSEARCH_HOST=opensearch-node1
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<your_opensearch_password>
OPENSEARCH_DASHBOARDS_HOST=opensearch-dashboards
PORT_OPENSEARCH_DASHBOARDS=5601
OPENSEARCH_INDEX=hybrid_index
OPENSEARCH_VERIFY_CERTS=False

# ==========================================
# RRF Settings
# ==========================================
RRF_K_FACTOR=60

# ==========================================
# Qdrant Settings
# ==========================================
QDRANT_HOST=raptor-qdrant
PORT_QDRANT=6333
QDRANT_COLLECTION=raptor

# ==========================================
# Huggingface Settings
# ==========================================
EMBEDDING_MODEL=intfloat/multilingual-e5-large   # 1024-dim; changing the embedding model requires rebuilding existing vector indexes
VECTOR_DIM=1024

RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANKER_TEMPERATURE=0.25

HF_CACHE_PATH=/path/to/huggingface/cache

# ==========================================
# GPU allocation
# ==========================================
HYBRID_SEARCH_GPU=0
HYBRID_SEARCH_GPU_COUNT=1

# ==========================================
# App Settings
# ==========================================
