# MCP Server 環境變數配置範本
# 複製此檔案為 .env 並填入實際值
# config.py 使用 env_prefix="MCP_"

# ==================== 服務身分 ====================
MCP_SERVER_NAME=raptor-mcp
MCP_SERVER_VERSION=1.0.0

# ==================== Module 13 API Gateway ====================
MCP_API_GATEWAY_BASE_URL=http://raptor-api-gateway:8012
MCP_API_VERSION=0.4                     # 與 13-api-services 的 GATEWAY_API_VERSION 共用同一號碼，見 root .env.example 的 API_VERSION

# ==================== Module 06 Keycloak ====================
MCP_KEYCLOAK_URL=http://raptor-keycloak:8080
MCP_REALM_NAME=dhtsolution
MCP_CLIENT_ID=raptor
MCP_KEYCLOAK_USERNAME=<service_account_username>
MCP_KEYCLOAK_PASSWORD=<service_account_password>

# ==================== Module 02 Redis（agent token 快取）====================
MCP_REDIS_URL=redis://:<your_redis_password>@raptor-redis-standalone:6379/3

# ==================== 傳輸與網路 ====================
MCP_LOG_LEVEL=INFO
MCP_TRANSPORT=http                      # "http"（預設，uvicorn）或 "stdio"（MCP_TRANSPORT=stdio python -m app）
MCP_PORT=8027                           # transport=http 時的內部 uvicorn port；需與 Dockerfile 的 EXPOSE/HEALTHCHECK 一致

# ==================== RaptorClient 請求逾時（秒）====================
MCP_TIMEOUT_DEFAULT=30.0                # 呼叫 Module 13 的預設逾時
MCP_TIMEOUT_UPLOAD=120.0                # 檔案上傳呼叫的逾時

# ==================== RaptorClient 重試行為 ====================
MCP_MAX_ATTEMPTS=3                      # 1 次初始 + (n-1) 次重試，適用 5xx / 連線錯誤
MCP_RETRY_BACKOFF_SECONDS=1.0

# ==================== TokenManager ====================
MCP_TOKEN_TTL_SECONDS=1800              # server service-account token 快取秒數（30 分鐘）
MCP_AGENT_TOKEN_TTL_SECONDS=86400       # agent_token 存活/閒置更新時間（24 小時）— 同時是 POST /mcp/auth/register 回傳的 expires_in，唯一真實來源
MCP_REFRESH_MARGIN_SECONDS=60           # token 剩餘秒數低於此值時提前更新

# ==================== Tool 專屬逾時與限制 ====================
MCP_TIMEOUT_A2A=120.0                   # A2A tool 呼叫逾時（raptor_a2a_*、raptor_query_orchestrate）
MCP_TIMEOUT_RESOURCE_LIST=15.0          # 短資源讀取逾時
MCP_COOCCUR_LIMIT=20                    # graph tools 回傳的共現實體上限
MCP_MAX_UPLOAD_BYTES=52428800           # 資產上傳大小上限（50 MB）

# ==================== stdio 傳輸（僅 MCP_TRANSPORT=stdio 時使用）====================
MCP_STDIO_LOG_PATH=/tmp/raptor-mcp-stdio.log   # stdout 保留給 MCP protocol，log 改寫檔案

# ==================== Agent credential 加密（POST /mcp/auth/register 必填）====================
# client_secret 寫進 Redis 前會先用這把金鑰加密，避免明文存放。
# 產生方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_SECRET_ENCRYPTION_KEY=<generate-a-fernet-key>
