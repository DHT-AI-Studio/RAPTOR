# ==========================================
# General
# ==========================================
TIMEZONE=Asia/Taipei

# ==========================================
# LLM -- via module 07 (ai-lifecycle-api)'s /v1/chat/completions, not the
# Ollama daemon directly (was ChatOllama straight to Ollama's native API;
# switched once module 07 gained num_ctx/think support -- Ollama's own /v1
# OpenAI-compat layer silently ignores LLM_NUM_CTX, confirmed live, but 07's
# doesn't have that gap)
# ==========================================
LLM_BASE_URL=http://raptor-ai-lifecycle-api:8010/v1
LLM_MODEL=qwen3.5:9b
TEMPERATURE=0.7
LLM_NUM_CTX=32768
LLM_THINK=false

# ==========================================
# Personal DB Service (module 25) — per-user isolated search
# (was module 17 Hybrid Search; HYBRID_SEARCH_URL kept below for rollback)
# ==========================================
PERSONAL_DB_SERVICE_URL=http://raptor-personal-db-service:8000
# HYBRID_SEARCH_URL=http://raptor-hybridsearch-api:8000

# ==========================================
# Memory Service (module 26)
# ==========================================
CHAT_MEMORY_SERVICE_URL=http://raptor-memory-service:8026

# ==========================================
# Redis (module 02)
# ==========================================
REDIS_HOST=raptor-redis-standalone
REDIS_PORT=6379
REDIS_PASSWORD=<your_redis_password>
REDIS_DB=0

# ==========================================
# Chat Memory
# ==========================================
MEMORY_CONTEXT_WINDOW=5
MEMORY_TTL=3600

# ==========================================
# HTTP
# ==========================================
REQUEST_TIMEOUT=60.0
PORT_CHAT_SERVICE=8021
