# ============================================================
# 02-redis-cluster environment
# ============================================================

# ── Host IP (REQUIRED for Redis Cluster announce) ─────────
# Must be the real IP of this machine — NOT localhost or 127.0.0.1
HOST_IP=<your_host_ip>

# ── Redis Password ─────────────────────────────────────────
REDIS_PASSWORD=<your_redis_password>

# ── Redis Cluster Ports ────────────────────────────────────
PORT_REDIS_CLUSTER_1=7000
PORT_REDIS_CLUSTER_2=7001
PORT_REDIS_CLUSTER_3=7002
PORT_REDIS_CLUSTER_4=7003
PORT_REDIS_CLUSTER_5=7004
PORT_REDIS_CLUSTER_6=7005

PORT_REDIS_CLUSTER_BUS_1=17000
PORT_REDIS_CLUSTER_BUS_2=17001
PORT_REDIS_CLUSTER_BUS_3=17002
PORT_REDIS_CLUSTER_BUS_4=17003
PORT_REDIS_CLUSTER_BUS_5=17004
PORT_REDIS_CLUSTER_BUS_6=17005

# ── Redis Standalone Port ──────────────────────────────────
PORT_REDIS_STANDALONE=6379

# ── RedisInsight UI Port ───────────────────────────────────
PORT_REDISINSIGHT=5540

# ── Timezone ───────────────────────────────────────────────
TIMEZONE=Asia/Taipei
